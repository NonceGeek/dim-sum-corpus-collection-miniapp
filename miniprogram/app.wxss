  --td-picker-indicator-bg-color: var(--bg-input) !important;
  --td-picker-transparent-color: transparent !important;
  --td-action-sheet-color: var(--text-primary) !important;
  --td-action-sheet-cancel-color: var(--text-primary) !important;
  --td-action-sheet-description-color: var(--text-muted) !important;
  --td-action-sheet-gap-color: var(--bg-page) !important;

  background-color: var(--bg-page) !important;
  color: var(--text-primary) !important;
}

/* 深色主题下的组件样式覆盖 */
.theme-dark .t-cell {
  background-color: var(--bg-card) !important;
}

.theme-dark .t-cell .t-cell__title,
.theme-dark .t-cell__title-text {
  color: var(--text-primary) !important;
}

/* 见浅色块同名注释：不要给 .t-icon / .t-cell__left-icon 加全局颜色覆盖 */

.theme-dark .t-navbar {
  background-color: var(--bg-card) !important;
  border-bottom: 1px solid var(--border-color) !important;
}

.theme-dark .t-navbar .t-navbar__title,
.theme-dark .t-navbar__title,
.theme-dark .t-navbar__center-title {
  color: var(--text-primary) !important;
}

.theme-dark .t-navbar__btn,
.theme-dark .t-navbar__left-arrow {
  color: var(--text-primary) !important;
}

/* TDesign Tab Bar 深色适配 - 依赖 CSS 变量，移除强制覆盖 */
.theme-dark .t-tab-bar {
  background-color: var(--bg-card) !important;
  border-top: 1px solid var(--border-color);
}

/* 按钮样式修正 */
/* 显式定义渐变按钮类 */
.theme-dark .btn-gradient,
.theme-dark .login-btn {
  background: var(--gradient-primary) !important;
  border: none !important;
  color: var(--text-white) !important;
}

/* 确保 outline 按钮背景透明 */
.theme-dark .t-button--variant-outline {
  background: transparent !important;
  border-color: var(--primary) !important;
  color: var(--primary) !important;
}

.theme-dark .t-button--default {
  background-color: var(--bg-input) !important;
  border-color: var(--border-color) !important;
  color: var(--text-primary) !important;
}

/* 特殊处理 tag 主题的 TabBar */
.theme-dark .t-tab-bar--tag .t-tab-bar-item--active {
  background-color: rgba(93, 140, 245, 0.2) !important;
}

.theme-dark .t-tab-bar--tag .t-tab-bar-item--active .t-tab-bar-item__content {
  background-color: transparent !important;
}

.theme-dark .glass-effect {
  background: rgba(22, 27, 34, 0.85) !important;
}

/* 浅色主题组件样式确保 */
.theme-light .t-cell {
  background-color: var(--bg-card) !important;
}

.theme-light .t-cell .t-cell__title,
.theme-light .t-cell__title-text {
  color: var(--text-primary) !important;
}

.theme-light .t-navbar {
  background-color: var(--bg-card) !important;
  border-bottom: 1px solid var(--border-light) !important;
}

.theme-light .t-tab-bar {
  background-color: var(--bg-card) !important;
  border-top: 1px solid var(--border-light) !important;
}

.t-button--disabled {
  opacity: 0.5 !important;
  box-shadow: none !important;
}
