/**app.wxss - 科技蓝紫配色方案**/

/* ============================================
   Design System - Tech Blue Purple Theme
   ============================================ */

/* 基础容器样式 */
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

/* 全局字体 */
page,
view,
text {
  font-family:
    -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto,
    "Helvetica Neue", Arial, sans-serif;
}

:root {
}

/* ============================================
   Light Mode - CSS Variables
   ============================================ */
page {
  --pd-sm: 16rpx;
  --pd-base: 24rpx;
  --pd-lg: 32rpx;
  --pd-xl: 40rpx;
  --pd-2xl: 48rpx;

  --fs-24: 24rpx;
  --fs-28: 28rpx;
  --fs-32: 32rpx;
  --fs-40: 40rpx;
  --fs-56: 56rpx;
  --fs-72: 72rpx;

  /* ==========================================
     皮肤层 —— 换风格只改下面这些色值
     ========================================== */

  /* 常量 */
  --text-white: #fff;

  /* 主色调 */
  --primary: #4a7cf3;
  --primary-light: #6b93f5;
  --secondary: #7c5cff;
  --secondary-bold: #7c3aed;
  --secondary-bolder: #4f46e5;

  /* 点缀色（金棕系 + 装饰色块） */
  --accent: #7a6331;
  --accent-muted: #8a7a4a;
  --accent-bg: #b1844b;
  --deco-pink: #fb285d;
  --deco-blue: #2442ff;
  --chip-active-bg: #2b2b31;

  /* 渐变 */
  --gradient-primary: linear-gradient(
    135deg,
    var(--primary) 0%,
    var(--secondary) 100%
  );
  --gradient-shimmer: linear-gradient(
    90deg,
    var(--primary),
    var(--secondary),
    var(--text-white),
    var(--primary)
  );
  --gradient-accent: linear-gradient(
    90deg,
    var(--secondary-bold) 0%,
    var(--secondary-bolder) 100%
  );

  /* 背景色 */
  --bg-page: #f5f7fa;
  --bg-card: #ffffff;
  --bg-input: #f8fafc;
  --bg-placeholder: #eeeeee;
  --bg-muted: #d9d9d9;

  /* 文字色 */
  --text-primary: #1a1f36;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;
  /* 永远浅色的表面上的文字（如系统弹层），不随主题变 */
  --text-on-light: #1a1f36;

  /* 边框 */
  --border-color: #e2e8f0;
  --border-light: #f1f5f9;

  /* 状态色 */
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  --danger-strong: #f62459;

  /* 阴影 */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
  --shadow-primary: 0 4px 14px rgba(74, 124, 243, 0.25);

  /* ==========================================
     结构层 —— 尺寸/圆角固定，换肤永不改
     ========================================== */

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-2xl: 40rpx;
  --radius-full: 9999rpx;

  /* 按钮 */
  --btn-height: 92rpx;
  --btn-height-lg: var(--btn-height);
  --td-button-medium-height: var(--btn-height);
  --td-button-large-height: var(--btn-height);

  /* TDesign 覆盖 */
  --td-bg-color-container: var(--bg-card);
  --td-bg-color-page: var(--bg-page);
  --td-bg-color-secondarycontainer: var(--bg-input);
  --td-text-color-primary: var(--text-primary);
  --td-text-color-secondary: var(--text-secondary);
  --td-text-color-placeholder: var(--text-muted);
  --td-border-color: var(--border-color);
  --td-component-stroke: var(--border-color);
  --td-component-border: var(--border-color);
  --td-brand-color: var(--primary);
  --td-popup-bg-color: var(--bg-page);
  --td-popup-border-radius: var(--radius-2xl);
  --td-dialog-border-radius: var(--radius-2xl);
  --td-picker-border-radius: var(--radius-2xl);
  --td-action-sheet-border-radius: var(--radius-2xl);
  --td-cell-bg-color: var(--bg-card);
  --td-navbar-bg-color: var(--bg-card);
  --td-navbar-background: var(--bg-card);
  --td-navbar-color: var(--text-primary);
  --td-tab-bar-bg-color: var(--bg-card);
  --td-tab-bar-color: var(--text-muted);
  --td-tab-bar-active-color: var(--primary);
  --td-tab-bar-item-color: var(--text-muted);
  --td-tab-bar-item-active-color: var(--primary);
  --td-input-bg-color: var(--bg-card);
  --td-input-default-text-color: var(--text-primary);
  --td-input-placeholder-text-color: var(--text-muted);
  --td-input-border-color: var(--border-color);
  --td-textarea-background-color: var(--bg-card);
  --td-textarea-text-color: var(--text-primary);
  --td-textarea-placeholder-color: var(--text-muted);
  --td-textarea-border-color: var(--border-color);
  --td-picker-bg-color: var(--bg-card);
  --td-picker-title-color: var(--text-primary);
  --td-picker-cancel-color: var(--text-secondary);
  --td-picker-confirm-color: var(--primary);
  --td-picker-item-color: var(--text-secondary);
  --td-picker-item-active-color: var(--text-primary);
  --td-picker-indicator-bg-color: var(--bg-input);
  --td-picker-transparent-color: transparent;
  --td-action-sheet-color: var(--text-primary);
  --td-action-sheet-cancel-color: var(--text-primary);
  --td-action-sheet-description-color: var(--text-muted);
  --td-action-sheet-gap-color: var(--bg-page);
  --td-font-family:
    -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto,
    sans-serif;

  background-color: var(--bg-page);
  color: var(--text-primary);
  box-sizing: border-box;
  transition:
    background-color 0.3s ease,
    color 0.3s ease;
}

/* ============================================
   Dark Mode - CSS Variables Override
   ============================================ */
@media (prefers-color-scheme: dark) {
  page {
    /* 主色调 - 稍微提亮 */
    --primary: #5d8cf5;
    --primary-light: #7ba3f7;
    --secondary: #9178ff;
    --secondary-bold: #a78bff;
    --secondary-bolder: #c4b5fd;

    /* 渐变 */
    --gradient-primary: linear-gradient(
      135deg,
      var(--primary) 0%,
      var(--secondary) 100%
    );

    --gradient-shimmer: linear-gradient(
      90deg,
      var(--primary),
      var(--secondary),
      var(--text-white),
      var(--primary)
    );
    --gradient-accent: linear-gradient(
      90deg,
      var(--secondary-bold) 0%,
      var(--secondary-bolder) 100%
    );

    /* 背景色 */
    --bg-page: #0d1117;
    --bg-card: #161b22;
    --bg-input: #21262d;
    --bg-placeholder: #21262d;
    --bg-muted: #21262d;

    /* 文字色 */
    --text-primary: #f0f6fc;
    --text-secondary: #8b949e;
    --text-muted: #6e7681;

    /* 边框 */
    --border-color: #30363d;
    --border-light: #21262d;

    /* 阴影 - 深色模式使用发光效果 */
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);

    /* TDesign 覆盖 */
    --td-bg-color-container: var(--bg-card);
    --td-bg-color-page: var(--bg-page);
    --td-bg-color-secondarycontainer: var(--bg-input);
    --td-text-color-primary: var(--text-primary);
    --td-text-color-secondary: var(--text-secondary);
    --td-text-color-placeholder: var(--text-muted);
    --td-border-color: var(--border-color);
    --td-component-stroke: var(--border-color);
    --td-component-border: var(--border-color);
    --td-brand-color: var(--primary);
    --td-popup-bg-color: var(--bg-page);
    --td-cell-bg-color: var(--bg-card);
    --td-navbar-bg-color: var(--bg-card);
    --td-navbar-background: var(--bg-card);
    --td-navbar-color: var(--text-primary);
    --td-tab-bar-bg-color: var(--bg-card);
    --td-tab-bar-color: var(--text-muted);
    --td-tab-bar-active-color: var(--primary);
    --td-tab-bar-item-color: var(--text-muted);
    --td-tab-bar-item-active-color: var(--primary);
    --td-input-bg-color: var(--bg-card);
    --td-input-default-text-color: var(--text-primary);
    --td-input-placeholder-text-color: var(--text-muted);
    --td-input-border-color: var(--border-color);
    --td-textarea-background-color: var(--bg-card);
    --td-textarea-text-color: var(--text-primary);
    --td-textarea-placeholder-color: var(--text-muted);
    --td-textarea-border-color: var(--border-color);
    --td-picker-bg-color: var(--bg-card);
    --td-picker-title-color: var(--text-primary);
    --td-picker-cancel-color: var(--text-secondary);
    --td-picker-confirm-color: var(--primary);
    --td-picker-item-color: var(--text-secondary);
    --td-picker-item-active-color: var(--text-primary);
    --td-picker-indicator-bg-color: var(--bg-input);
    --td-picker-transparent-color: transparent;
    --td-action-sheet-color: var(--text-primary);
    --td-action-sheet-cancel-color: var(--text-primary);
    --td-action-sheet-description-color: var(--text-muted);
    --td-action-sheet-gap-color: var(--bg-page);

    background-color: var(--bg-page);
  }

  /* TDesign Cell 组件深色适配 */
  .t-cell {
    background-color: var(--bg-card) !important;
  }

  .t-cell .t-cell__title,
  .t-cell__title-text,
  t-cell .t-cell__title {
    color: var(--text-primary) !important;
  }

  /* 不要给 .t-icon / .t-cell__left-icon 加全局颜色覆盖：
     会盖掉 message 语义色和 profile 自定义图标色，图标色一律由各页面/组件自管 */

  /* TDesign Navbar 深色适配 */
  .t-navbar {
    background-color: var(--bg-card) !important;
    border-bottom: 1px solid var(--border-color);
  }

  .t-navbar .t-navbar__title,
  .t-navbar__title {
    color: var(--text-primary) !important;
  }

  .t-navbar .t-icon {
    color: var(--text-primary) !important;
  }

  /* TDesign Tab Bar 深色适配 */
  .t-tab-bar {
    background-color: var(--bg-card) !important;
    border-top: 1px solid var(--border-color);
  }

  .t-tab-bar-item {
    --td-tab-bar-item-icon-color: var(--text-muted) !important;
  }

  .t-tab-bar-item.is-active .t-icon,
  .t-tab-bar-item [aria-selected="true"] .t-icon {
    color: var(--primary) !important;
  }

  .t-tab-bar-item.is-active .t-tab-bar-item__text,
  .t-tab-bar-item[aria-selected="true"] .t-tab-bar-item__text {
    color: var(--primary) !important;
  }

  .t-tab-bar-item .t-icon {
    color: var(--text-muted) !important;
  }

  .t-tab-bar-item .t-tab-bar-item__text {
    color: var(--text-muted) !important;
  }

  /* TDesign Button 深色适配 */
  .t-button--primary {
    background: var(--gradient-primary) !important;
    border: none !important;
  }

  .t-button--default {
    background-color: var(--bg-input) !important;
    border-color: var(--border-color) !important;
    color: var(--text-primary) !important;
  }
}

/* ============================================
   通用组件样式
   ============================================ */

/* 全局字号工具类 */
.fs-24 {
  font-size: var(--fs-24) !important;
}

.fs-32 {
  font-size: var(--fs-32) !important;
}

/* 毛玻璃效果 */
.glass-effect {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

@media (prefers-color-scheme: dark) {
  .glass-effect {
    background: rgba(22, 27, 34, 0.85);
  }
}

/* 状态标签 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--fs-24);
  font-weight: 500;
}

/* TDesign 组件主题兜底：颜色 token 统一在这里维护 */
.t-popup,
.t-popup__content {
  background-color: var(--td-popup-bg-color) !important;
}

.t-navbar,
.t-navbar__content {
  background-color: var(--td-navbar-bg-color) !important;
  color: var(--td-navbar-color) !important;
}

.t-navbar .t-navbar__title,
.t-navbar__title,
.t-navbar__center-title {
  color: var(--td-navbar-color) !important;
}

.t-navbar .t-icon,
.t-navbar__btn,
.t-navbar__left-arrow {
  color: var(--td-navbar-color) !important;
}

.t-input {
  background-color: var(--td-input-bg-color) !important;
}

.t-input__control {
  color: var(--td-input-default-text-color) !important;
}

.t-textarea {
  background-color: var(--td-textarea-background-color) !important;
}

.t-textarea__wrapper-inner {
  color: var(--td-textarea-text-color) !important;
}

.t-picker {
  background-color: var(--td-picker-bg-color) !important;
}

.t-picker__title,
.t-picker-item__item--active {
  color: var(--td-picker-item-active-color) !important;
}

.t-picker-item__item {
  color: var(--td-picker-item-color);
}

.t-tab-bar-item__content--checked .t-tab-bar-item__icon,
.t-tab-bar-item__content--checked .t-tab-bar-item__text,
.t-tab-bar-item__content--checked .t-icon {
  color: var(--td-tab-bar-active-color) !important;
}

.t-action-sheet__content,
.t-action-sheet__footer,
.t-action-sheet__cancel {
  background-color: var(--td-bg-color-container) !important;
  color: var(--td-action-sheet-color) !important;
}

.t-action-sheet__gap-list {
  background-color: var(--td-action-sheet-gap-color) !important;
}

/* ============================================
