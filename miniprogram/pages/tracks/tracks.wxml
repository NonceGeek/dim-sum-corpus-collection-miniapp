<view class="container theme-{{currentTheme}}">

  <!-- 活动标题区：三层结构 -->
  <view class="tracks-header" bind:tap="onRule">

    <!-- 背景 -->
    <image wx:if="{{!trackLoading}}" class="header-bg" src="{{track.bannerUrl || '/public/image/yue.jpg'}}"
      mode="aspectFill" />
    <view class="header-overlay"></view>
    <view class="track-header-skeleton" wx:if="{{trackLoading}}">
      <view class="tracks-skeleton-block track-header-skeleton-tag"></view>
      <view class="tracks-skeleton-block track-header-skeleton-title"></view>
      <view class="tracks-skeleton-block track-header-skeleton-time"></view>
    </view>
    <!-- 内容 -->
    <view class="ice-text-layer ice-animate" wx:if="{{trackTextReady}}">

      <view class="activity-tag" wx:if="{{track.activityTag}}">
        <text>{{track.activityTag}}</text>
      </view>

      <view class="activity-name ice-title" style="font-size: {{trackTitleFontSize}}rpx;">
        <text class="ice-copy">{{track.title}}</text>
      </view>

      <view class="activity-time ice-subtitle">
        <text class="ice-copy">{{track.startsAt}} - {{track.endsAt}}</text>
      </view>

    </view>

  </view>

  <!-- 倒影渐变带：承接 header，右侧放操作胶囊 -->
  <view class="header-reflection">
    <view class="tracks-skeleton-block track-action-skeleton" wx:if="{{trackLoading}}"></view>
    <view class="header-actions" wx:elif="{{track.canShare || track.timeStatus === 'ongoing'}}">
      <button class="ha-btn" open-type="share" hover-class="none" wx:if="{{track.canShare}}">
        <t-icon class="ha-icon" name="share" size="30rpx" color="#ffffff" />
        <text class="ha-text">分享</text>
      </button>
      <block wx:if="{{track.timeStatus === 'ongoing'}}">
        <view class="ha-divider"></view>
        <view class="ha-btn" bind:tap="onRule">
          <t-icon class="ha-icon" name="info-circle" size="30rpx" color="#ffffff" />
          <text class="ha-text">详情</text>
        </view>
      </block>
    </view>
  </view>

  <scroll-view class="btn-group-scroll" scroll-x show-scrollbar="false" enhanced>
    <view class="btn-group">
      <view wx:for="{{type}}" wx:key="value" class="btn-type {{currentTrackType === item.value ? 'active' : ''}}"
        bind:tap="onTrackTap" data-type="{{item.value}}">
        <text class="btn-type-text">{{item.label}}</text>
        <view class="track-tab-scribble" wx:if="{{currentTrackType === item.value}}">
          <view class="track-tab-scribble-line line-1"></view>
          <view class="track-tab-scribble-line line-2"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 瀑布流卡片列表 -->
  <view class="card-list">
    <waterfall
      items="{{cardList}}"
      loading="{{loading && cardList.length === 0}}"
      append-loading="{{loading && cardList.length > 0}}"
      bind:itemtap="onWaterfallTap"
      showFeatured
    />
  </view>

  <!-- 加载状态 -->
  <view class="loading-tip" wx:if="{{noMore}}">
    <text>没有更多了</text>
  </view>

  <view class="post-actions">
    <t-button theme="default" shape="round" size="large" block t-class="bottom-btn" hover-class="none" bind:tap="onMyWorks">
      我的参赛作品
    </t-button>

    <t-button theme="default" shape="round" size="large" block t-class="bottom-btn" hover-class="none" bind:tap="onPost" wx:if="{{track.canSubmit}}">
      我要参赛
    </t-button>
  </view>

  <join-consent-popup
    visible="{{joinConsentPopupVisible}}"
    activity-id="{{trackId}}"
    current-theme="{{currentTheme}}"
    bind:close="onJoinConsentClose"
    bind:complete="onJoinConsentComplete"
  />
</view>
<common-dialog id="common-dialog" />
