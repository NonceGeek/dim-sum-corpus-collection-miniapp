<view class="container theme-{{currentTheme}}">

  <!-- 右上角悬浮按钮 -->
  <view class="top-fab-container" wx:if="{{track.canShare}}">
    <button class="top-btn" open-type="share">
      <text class="top-btn-text">分享</text>
    </button>
    <view class="top-btn" bind:tap="onRule" wx:if="{{track.timeStatus === 'ongoing'}}">
      <text class="top-btn-text">规则</text>
    </view>
  </view>

  <!-- 活动标题区：三层结构 -->
  <view class="tracks-header">

    <!-- 背景 -->
    <image class="header-bg" src="{{track.bannerUrl}}" mode="aspectFill" />
    <view class="header-overlay"></view>
    <!-- 内容 -->
    <view class="ice-text-layer ice-animate">

      <view class="activity-name ice-title">
        {{track.title}}
      </view>

      <view class="activity-time ice-subtitle">
        {{track.startsAt}} - {{track.endsAt}}，期待您的参与
      </view>

    </view>

  </view>

  <scroll-view class="btn-group-scroll" scroll-x show-scrollbar="false" enhanced>
    <view class="btn-group">
      <view wx:for="{{type}}" wx:key="value" class="btn-type {{currentTrackType === item.value ? 'active' : ''}}"
        bind:tap="onTrackTap" data-type="{{item.value}}">
        <text class="btn-type-text">{{item.label}}</text>
        <view class="btn-scribble" wx:if="{{currentTrackType === item.value}}">
          <view class="btn-scribble-line line-1"></view>
          <view class="btn-scribble-line line-2"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 瀑布流卡片列表 -->
  <view class="card-list">
    <waterfall items="{{cardList}}" bind:itemtap="onWaterfallTap" showFeatured/>
  </view>

  <!-- 加载状态 -->
  <view class="loading-tip" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="loading-tip" wx:elif="{{noMore}}">
    <text>没有更多了</text>
  </view>

  <view class="post-actions">
    <t-button theme="default" shape="round" size="medium" class="bottom-btn" hover-class="none" bind:tap="onMyWorks">
      我的参赛作品
    </t-button>

    <t-button theme="default" shape="round" size="medium" class="bottom-btn" hover-class="none" bind:tap="onPost" wx:if="{{track.canSubmit}}">
      我也想参赛
    </t-button>
  </view>
</view>