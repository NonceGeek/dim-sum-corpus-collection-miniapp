.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ======================================
   Header
====================================== */

.tracks-header {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
  background: var(--bg-placeholder);
}

.track-header-skeleton {
  position: absolute;
  right: 16rpx;
  bottom: 20rpx;
  left: 16rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: var(--pd-base) var(--pd-lg);
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: var(--radius-lg);
  background: rgba(12, 12, 14, 0.52);
}

.tracks-skeleton-block {
  background: linear-gradient(
    90deg,
    var(--bg-placeholder) 25%,
    var(--bg-muted) 37%,
    var(--bg-placeholder) 63%
  );
  background-size: 400% 100%;
  animation: tracks-page-skeleton-shimmer 1.4s ease-in-out infinite;
}

.track-header-skeleton-tag {
  width: 150rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
}

.track-header-skeleton-title {
  width: 360rpx;
  max-width: 70%;
  height: 46rpx;
  margin-top: 20rpx;
  border-radius: var(--radius-sm);
}

.track-header-skeleton-time {
  width: 480rpx;
  max-width: 88%;
  height: 24rpx;
  margin-top: 10rpx;
  border-radius: var(--radius-sm);
}

.track-action-skeleton {
  width: 230rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
}

@keyframes tracks-page-skeleton-shimmer {
  0% {
    background-position: 100% 0;
  }

  100% {
    background-position: 0 0;
  }
}

/* ======================================
   背景图
====================================== */

.header-bg {
  position: absolute;
  width: 100%;
  height: 100%;
}

/* ======================================
   内容
====================================== */

.header-content {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 1;

  display: flex;
  justify-content: center;
  align-items: center;

  flex-direction: column;

  text-align: center;
}

.activity-name {
  font-weight: bold;
  color: var(--gradient-primary);

  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.activity-time {
  margin-top: 16rpx;

  font-size: var(--fs-24);
  color: var(--gradient-primary);
}

.ice-text-layer {
  position: absolute;
  bottom: 20rpx;
  left: 16rpx;
  width: fit-content;
  max-width: calc(100% - 32rpx);
  padding: var(--pd-base) var(--pd-lg);
  box-sizing: border-box;

  display: flex;
  flex-direction: column;

  align-items: flex-start;

  text-align: left;

  z-index: 2;

  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 18rpx;
  background: rgba(30, 30, 30, 0.22);
  -webkit-backdrop-filter: blur(24rpx) saturate(110%);
  backdrop-filter: blur(24rpx) saturate(110%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.14),
    0 10rpx 28rpx rgba(0, 0, 0, 0.18);
}

.activity-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  max-width: 100%;
  padding: 0 var(--pd-base);
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--radius-full);
  background: var(--gradient-accent);
  box-shadow: 0 0 22rpx rgba(124, 92, 255, 0.42);
  color: #ffffff;
  font-size: var(--fs-24);
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.activity-tag + .ice-title {
  margin-top: 20rpx;
}

.ice-title,
.ice-subtitle {
  position: relative;
  z-index: 0;
  padding: 0;
}

.ice-copy {
  position: relative;
  z-index: 1;
}

.ice-title {
  width: fit-content;
  max-width: 100%;
  box-sizing: border-box;

  font-weight: 700;
  line-height: 1.18;

  color: #ffffff;

  letter-spacing: 1rpx;

  opacity: 0;

  transform: translateY(12rpx);

  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);

  animation: iceTitleReveal 0.6s ease-out forwards;
}

.ice-title .ice-copy {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ice-subtitle {
  max-width: 100%;
  margin-top: 12rpx;

  font-size: var(--fs-24);

  color: rgba(255, 255, 255, 0.86);

  opacity: 0;

  transform: translateY(8rpx);

  text-shadow: none;

  animation: iceSubtitleReveal 0.6s ease-out 0.08s forwards;
}

.ice-subtitle .ice-copy {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  background: linear-gradient(
    to bottom,
    rgba(15, 23, 42, 0.04),
    rgba(15, 23, 42, 0.42)
  );
}

@keyframes iceTitleReveal {
  0% {
    opacity: 0;

    transform: translateY(16rpx);

    filter: brightness(1.3);
  }

  60% {
    opacity: 1;
  }

  100% {
    opacity: 1;

    transform: translateY(0);

    filter: brightness(1);
  }
}

@keyframes iceSubtitleReveal {
  0% {
    opacity: 0;

    transform: translateY(12rpx);

    filter: brightness(1.2);
  }

  100% {
    opacity: 1;

    transform: translateY(0);

    filter: brightness(1);
  }
}

/* 赛道按钮列表 */
.btn-group-scroll {
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  padding: 0 var(--pd-base);
  box-sizing: border-box;
  background: var(--bg-page);
  border-bottom: 1rpx solid var(--border-light);
}

.btn-group {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: var(--pd-sm) var(--pd-base) var(--pd-sm) 0;
}

.btn-type {
  position: relative;
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 var(--pd-base);
  border-radius: var(--radius-full);
  background: transparent;
  color: var(--text-secondary);
  font-size: var(--fs-28);
  font-weight: 500;
  line-height: 1;
  transition:
    transform 0.2s ease,
    color 0.2s ease,
    background-color 0.2s ease;
}

.btn-type:active {
  transform: scale(0.97);
}

.btn-type-text {
  position: relative;
  z-index: 2;
  white-space: nowrap;
}

.btn-type.active {
  color: var(--text-primary);
  font-weight: 700;
  background: rgba(79, 70, 229, 0.06);
}

.track-tab-scribble {
  position: absolute;
  left: 20rpx;
  right: 16rpx;
  bottom: 8rpx;
  height: 18rpx;
  pointer-events: none;
}

.track-tab-scribble-line {
  position: absolute;
  left: 0;
  width: 100%;
  border-radius: var(--radius-full);
  background: var(--gradient-accent);
  transform-origin: left center;
}

.track-tab-scribble .line-1 {
  bottom: 2rpx;
  height: 6rpx;
  transform: rotate(-2deg);
}

.track-tab-scribble .line-2 {
  bottom: 7rpx;
  left: 12rpx;
  width: calc(100% - 18rpx);
  height: 4rpx;
  opacity: 0.75;
  transform: rotate(1.5deg);
}

/* 瀑布流卡片列表 */
.card-list {
  flex: 1;
  width: 100%;
  padding: var(--pd-base) var(--pd-base) 0;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-tip {
  text-align: center;
  padding: 64rpx 32rpx;
  color: var(--text-muted);
  font-size: var(--fs-24);
}

/* 倒影渐变带 */
.header-reflection {
  position: relative;
  width: 100%;
  height: 96rpx;
  background: var(--bg-page);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 var(--pd-base);
  box-sizing: border-box;
}

.header-reflection::before {
  position: absolute;
  top: -18rpx;
  right: 24rpx;
  left: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(18, 24, 38, 0.28);
  box-shadow: 0 22rpx 48rpx rgba(18, 24, 38, 0.3);
  filter: blur(22rpx);
  pointer-events: none;
  content: "";
}

.header-reflection > .track-action-skeleton,
.header-reflection > .header-actions {
  position: relative;
  z-index: 1;
}

/* 操作胶囊 */
.header-actions {
  display: flex;
  align-items: center;
  padding: 6rpx;
  border-radius: var(--radius-full);
  background: var(--text-muted);
  backdrop-filter: blur(6rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.36);
}

.ha-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
}

.ha-btn::after {
  border: none;
}

.ha-btn:active {
  opacity: 0.7;
}

.ha-icon {
  display: flex;
}

.ha-text {
  font-size: var(--fs-24);
  color: var(--text-white);
  font-weight: 500;
}

.ha-divider {
  width: 1rpx;
  height: 28rpx;
  background: var(--bg-muted);
}

/* 底部操作按钮 */

.post-actions {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: var(--pd-base);
  width: 100%;
  box-sizing: border-box;
  padding: var(--pd-base) var(--pd-base)
    calc(var(--pd-base) + env(safe-area-inset-bottom));
  background: var(--bg-page);
}

.bottom-btn {
  flex: 1;
  min-width: 0;
  background: var(--gradient-primary) !important;
  border: none !important;
  color: var(--text-white) !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
}

.bottom-btn .t-button__text {
  font-size: var(--fs-32) !important;
}

.t-button--default::after {
  border: none !important;
}
