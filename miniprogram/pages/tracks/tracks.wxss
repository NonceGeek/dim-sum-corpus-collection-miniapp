.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 200rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
}

.rule-dialog-content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  text-align: left;
}

.rule-dialog-section {
  display: flex;
  align-items: flex-start;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.7;
}

.rule-dialog-label {
  flex-shrink: 0;
  font-weight: 600;
}

.rule-dialog-text {
  flex: 1;
  min-width: 0;
  white-space: pre-wrap;
  word-break: break-word;
}

.rule-dialog-confirm {
  max-width: 200rpx;
  margin: 0 auto;
  background: var(--gradient-primary) !important;
  border: none !important;
  color: #fff !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
  font-size: 32rpx !important;
}

.rule-dialog-confirm .t-button__text {
  font-size: 32rpx !important;
}

/* ======================================
   Header
====================================== */

.tracks-header {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
}

/* ======================================
   背景图
====================================== */

.header-bg {
  position: absolute;
  width: 100%;
  height: 100%;

  animation: bgFloat 8s ease-in-out infinite alternate;
}

@keyframes bgFloat {
  0% {
    transform: scale(1);
  }

  100% {
    transform: scale(1.08);
  }
}

/* ======================================
   内容
====================================== */

.header-content {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 1;

  display: flex;
  justify-content: center;
  align-items: center;

  flex-direction: column;

  text-align: center;
}

.activity-name {
  font-size: 60rpx;
  font-weight: bold;
  color: var(--gradient-primary);

  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.activity-time {
  margin-top: 16rpx;

  font-size: 26rpx;
  color: var(--gradient-primary);
}

.ice-text-layer {
  position: absolute;
  inset: 0;

  display: flex;
  flex-direction: column;

  justify-content: center;
  align-items: center;

  text-align: center;

  z-index: 2;
}

.ice-title {
  font-size: 60rpx;
  font-weight: 700;

  color: #1a1f36;

  letter-spacing: 4rpx;

  opacity: 0;

  transform: translateY(24rpx) scale(1.08);

  text-shadow:
    0 0 6rpx rgba(255, 255, 255, 0.35),
    0 0 18rpx rgba(90, 140, 255, 0.22);

  animation:
    iceTitleReveal 1.8s ease-out forwards,
    iceGlow 4s ease-in-out infinite 1.8s;
}

@keyframes iceGlow {
  0%,
  100% {
    text-shadow:
      0 0 6rpx rgba(255, 255, 255, 0.25),
      0 0 16rpx rgba(90, 140, 255, 0.16);
  }

  50% {
    text-shadow:
      0 0 10rpx rgba(255, 255, 255, 0.38),
      0 0 24rpx rgba(124, 92, 255, 0.24);
  }
}

.ice-subtitle {
  margin-top: 18rpx;

  font-size: 28rpx;

  color: #1a1f36;

  opacity: 0;

  transform: translateY(16rpx);

  text-shadow: 0 0 8rpx rgba(255, 255, 255, 0.16);

  animation: iceSubtitleReveal 1.6s ease-out 0.3s forwards;
}

.header-overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.02),
    rgba(30, 35, 50, 0.12)
  );
}

@keyframes iceTitleReveal {
  0% {
    opacity: 0;

    transform: translateY(40rpx) scale(1.12);

    filter: brightness(1.3);
  }

  60% {
    opacity: 1;
  }

  100% {
    opacity: 1;

    transform: translateY(0) scale(1);

    filter: brightness(1);
  }
}

@keyframes iceSubtitleReveal {
  0% {
    opacity: 0;

    transform: translateY(24rpx);

    filter: brightness(1.2);
  }

  100% {
    opacity: 1;

    transform: translateY(0);

    filter: brightness(1);
  }
}

/* 赛道按钮列表 */
.btn-group-scroll {
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--bg-page);
  border-bottom: 1rpx solid var(--border-light);
}

.btn-group {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx 16rpx 0;
}

.btn-type {
  position: relative;
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: transparent;
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  transition:
    transform 0.2s ease,
    color 0.2s ease,
    background-color 0.2s ease;
}

.btn-type:active {
  transform: scale(0.97);
}

.btn-type-text {
  position: relative;
  z-index: 2;
  white-space: nowrap;
}

.btn-type.active {
  color: var(--text-primary);
  font-weight: 700;
  background: rgba(79, 70, 229, 0.06);
}

.track-tab-scribble {
  position: absolute;
  left: 20rpx;
  right: 16rpx;
  bottom: 8rpx;
  height: 18rpx;
  pointer-events: none;
}

.track-tab-scribble-line {
  position: absolute;
  left: 0;
  width: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7c3aed 0%, #4f46e5 100%);
  transform-origin: left center;
}

.track-tab-scribble .line-1 {
  bottom: 2rpx;
  height: 6rpx;
  transform: rotate(-2deg);
}

.track-tab-scribble .line-2 {
  bottom: 7rpx;
  left: 12rpx;
  width: calc(100% - 18rpx);
  height: 4rpx;
  opacity: 0.75;
  transform: rotate(1.5deg);
}

/* 瀑布流卡片列表 */
.card-list {
  flex: 1;
  width: 100%;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-tip {
  text-align: center;
  padding: 64rpx 32rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

/* 右上角悬浮按钮 */
.top-fab-container {
  position: absolute;
  top: 50rpx;
  margin-left: auto;
  width: fit-content;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-right: 24rpx;
  right: 0;
}

.top-btn {
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

.top-btn::after {
  border: none;
}

.top-btn-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
}

/* 底部悬浮按钮 */

.post-actions {
  position: fixed;
  bottom: 150rpx;
  left: 0;
  right: 0;
  z-index: 100;
  text-align: center;
}

.bottom-btn {
  background: var(--gradient-primary) !important;
  border: none !important;
  color: #fff !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
  margin-right: 24rpx;
}

.bottom-btn .t-button__text {
  font-size: 16rpx !important;
}

.t-button--default::after {
  border: none !important;
}
