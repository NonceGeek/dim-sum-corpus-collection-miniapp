.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 200rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 活动标题区 */
.tracks-header {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.activity-name {
  font-size: 60rpx;
  font-weight: 700;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  padding: 24rpx 32rpx;
  min-height: auto;
  display: block;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background-color: rgba(255, 255, 255, 0.8);
  line-height: 1.2;
  text-align: center;
}

.activity-time {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: var(--text-muted);
  line-height: 1.2;
  text-align: center;
}

/* 赛道按钮列表 */
.btn-group-scroll {
  width: 100%;
  padding: 0 24rpx;
}

.btn-group {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 24rpx;
}

.btn-type {
  position: relative;
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: transparent;
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  transition:
    transform 0.2s ease,
    color 0.2s ease,
    background-color 0.2s ease;
}

.btn-type:active {
  transform: scale(0.97);
}

.btn-type-text {
  position: relative;
  z-index: 2;
  white-space: nowrap;
}

.btn-type.active {
  color: var(--text-primary);
  font-weight: 700;
  background: rgba(79, 70, 229, 0.06);
}

.btn-scribble {
  position: absolute;
  left: 20rpx;
  right: 16rpx;
  bottom: 8rpx;
  height: 18rpx;
  pointer-events: none;
}

.btn-scribble-line {
  position: absolute;
  left: 0;
  width: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7c3aed 0%, #4f46e5 100%);
  transform-origin: left center;
}

.btn-scribble .line-1 {
  bottom: 2rpx;
  height: 6rpx;
  transform: rotate(-2deg);
}

.btn-scribble .line-2 {
  bottom: 7rpx;
  left: 12rpx;
  width: calc(100% - 18rpx);
  height: 4rpx;
  opacity: 0.75;
  transform: rotate(1.5deg);
}

/* 瀑布流卡片列表 */
.card-list {
  flex: 1;
  width: 100%;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.card-column {
  flex: 1;
  min-width: 0;
}

.card-item {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 24rpx;

  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-light);
}

.card-item:active {
  opacity: 0.9;
}

.card-image {
  width: 100%;
  display: block;
}

.card-footer {
  padding: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-footer .t-avatar,
.card-footer .t-avatar__inner,
.card-footer .t-image {
  width: 56rpx !important;
  height: 56rpx !important;
  min-width: 56rpx !important;
  min-height: 56rpx !important;
  font-size: 32rpx !important;
  line-height: 56rpx !important;
}

.card-username {
  font-size: 24rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载状态 */
.loading-tip {
  text-align: center;
  padding: 32rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

/* 右上角悬浮按钮 */
.top-fab-container {
  position: fixed;
  top: 50rpx;
  right: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 100;
}

.top-btn {
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

.top-btn::after {
  border: none;
}

.top-btn-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
}

/* 底部悬浮按钮 */

.post-actions {
  position: fixed;
  bottom: 150rpx;
  left: 0;
  right: 0;
  z-index: 100;
  text-align: center;
}

.bottom-btn {
  background: var(--gradient-primary) !important;
  border: none !important;
  color: #fff !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
  margin-right: 24rpx;
}

.bottom-btn .t-button__text {
  font-size: 16rpx !important;
}

.t-button--default::after {
  border: none !important;
}
