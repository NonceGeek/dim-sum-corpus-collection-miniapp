.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 200rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
}

.rule-dialog-content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  text-align: left;
}

.rule-dialog-section {
  display: flex;
  align-items: flex-start;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.7;
}

.rule-dialog-label {
  flex-shrink: 0;
  font-weight: 600;
}

.rule-dialog-text {
  flex: 1;
  min-width: 0;
  white-space: pre-wrap;
  word-break: break-word;
}

.rule-dialog-confirm {
  max-width: 200rpx;
  margin: 0 auto;
  background: var(--gradient-primary) !important;
  border: none !important;
  color: var(--text-white) !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
  font-size: 32rpx !important;
}

.rule-dialog-confirm .t-button__text {
  font-size: 32rpx !important;
}

/* ======================================
   Header
====================================== */

.tracks-header {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
  background: var(--bg-placeholder);
}

.track-header-skeleton {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tracks-skeleton-block {
  background: linear-gradient(
    90deg,
    var(--bg-placeholder) 25%,
    var(--bg-muted) 37%,
    var(--bg-placeholder) 63%
  );
  background-size: 400% 100%;
  animation: tracks-page-skeleton-shimmer 1.4s ease-in-out infinite;
}

.track-header-skeleton-title {
  width: 52%;
  height: 58rpx;
  border-radius: 14rpx;
}

.track-header-skeleton-time {
  width: 68%;
  height: 28rpx;
  margin-top: 28rpx;
  border-radius: 10rpx;
}

.track-action-skeleton {
  width: 230rpx;
  height: 64rpx;
  border-radius: 999rpx;
}

@keyframes tracks-page-skeleton-shimmer {
  0% {
    background-position: 100% 0;
  }

  100% {
    background-position: 0 0;
  }
}

/* ======================================
   背景图
====================================== */

.header-bg {
  position: absolute;
  width: 100%;
  height: 100%;

  animation: bgFloat 8s ease-in-out infinite alternate;
}

@keyframes bgFloat {
  0% {
    transform: scale(1);
  }

  100% {
    transform: scale(1.08);
  }
}

/* ======================================
   内容
====================================== */

.header-content {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 1;

  display: flex;
  justify-content: center;
  align-items: center;

  flex-direction: column;

  text-align: center;
}

.activity-name {
  font-size: 60rpx;
  font-weight: bold;
  color: var(--gradient-primary);

  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.activity-time {
  margin-top: 16rpx;

  font-size: 26rpx;
  color: var(--gradient-primary);
}

.ice-text-layer {
  position: absolute;
  inset: 0;

  display: flex;
  flex-direction: column;

  justify-content: center;
  align-items: center;

  text-align: center;

  z-index: 2;
}

.ice-title,
.ice-subtitle {
  position: relative;
  z-index: 0;
  padding-right: 12rpx;
  padding-left: 12rpx;
}

.ice-highlighter {
  position: absolute;
  top: 8rpx;
  right: 2rpx;
  bottom: 4rpx;
  left: 2rpx;
  z-index: 0;
  border-radius: 5rpx 12rpx 6rpx 10rpx;
  background: var(--secondary);
  opacity: 0.38;
  transform: rotate(-1.2deg) skewX(-7deg);
  pointer-events: none;
}

.ice-copy {
  position: relative;
  z-index: 1;
}

.ice-title {
  width: fit-content;
  max-width: calc(100% - 48rpx);
  box-sizing: border-box;

  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.18;

  color: var(--text-on-light);

  letter-spacing: 4rpx;

  opacity: 0;

  transform: translateY(24rpx) scale(1.08);

  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);

  animation: iceTitleReveal 1.8s ease-out forwards;
}

.ice-title .ice-copy {
  display: block;
  white-space: normal;
  overflow-wrap: break-word;
  word-break: break-word;
}

.ice-subtitle {
  margin-top: 18rpx;

  font-size: 28rpx;

  color: var(--text-on-light);

  opacity: 0;

  transform: translateY(16rpx);

  text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.24);

  animation: iceSubtitleReveal 1.6s ease-out 0.3s forwards;
}

.ice-subtitle .ice-highlighter {
  top: 2rpx;
  bottom: 1rpx;
  opacity: 0.28;
  transform: rotate(0.8deg) skewX(-5deg);
}

.header-overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.04),
    rgba(30, 35, 50, 0.1)
  );
}

@keyframes iceTitleReveal {
  0% {
    opacity: 0;

    transform: translateY(40rpx) scale(1.12);

    filter: brightness(1.3);
  }

  60% {
    opacity: 1;
  }

  100% {
    opacity: 1;

    transform: translateY(0) scale(1);

    filter: brightness(1);
  }
}

@keyframes iceSubtitleReveal {
  0% {
    opacity: 0;

    transform: translateY(24rpx);

    filter: brightness(1.2);
  }

  100% {
    opacity: 1;

    transform: translateY(0);

    filter: brightness(1);
  }
}

/* 赛道按钮列表 */
.btn-group-scroll {
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--bg-page);
  border-bottom: 1rpx solid var(--border-light);
}

.btn-group {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx 16rpx 0;
}

.btn-type {
  position: relative;
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: transparent;
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  transition:
    transform 0.2s ease,
    color 0.2s ease,
    background-color 0.2s ease;
}

.btn-type:active {
  transform: scale(0.97);
}

.btn-type-text {
  position: relative;
  z-index: 2;
  white-space: nowrap;
}

.btn-type.active {
  color: var(--text-primary);
  font-weight: 700;
  background: rgba(79, 70, 229, 0.06);
}

.track-tab-scribble {
  position: absolute;
  left: 20rpx;
  right: 16rpx;
  bottom: 8rpx;
  height: 18rpx;
  pointer-events: none;
}

.track-tab-scribble-line {
  position: absolute;
  left: 0;
  width: 100%;
  border-radius: 999rpx;
  background: var(--gradient-accent);
  transform-origin: left center;
}

.track-tab-scribble .line-1 {
  bottom: 2rpx;
  height: 6rpx;
  transform: rotate(-2deg);
}

.track-tab-scribble .line-2 {
  bottom: 7rpx;
  left: 12rpx;
  width: calc(100% - 18rpx);
  height: 4rpx;
  opacity: 0.75;
  transform: rotate(1.5deg);
}

/* 瀑布流卡片列表 */
.card-list {
  flex: 1;
  width: 100%;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-tip {
  text-align: center;
  padding: 64rpx 32rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

/* 倒影渐变带 */
.header-reflection {
  position: relative;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(to bottom, var(--bg-muted), var(--bg-page));
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 操作胶囊 */
.header-actions {
  display: flex;
  align-items: center;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--text-muted);
  backdrop-filter: blur(6rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.36);
}

.ha-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
}

.ha-btn::after {
  border: none;
}

.ha-btn:active {
  opacity: 0.7;
}

.ha-icon {
  display: flex;
}

.ha-text {
  font-size: 24rpx;
  color: var(--text-white);
  font-weight: 500;
}

.ha-divider {
  width: 1rpx;
  height: 28rpx;
  background: var(--bg-muted);
}

/* 底部悬浮按钮 */

.post-actions {
  position: fixed;
  bottom: 150rpx;
  left: 0;
  right: 0;
  z-index: 100;
  text-align: center;
}

.bottom-btn {
  background: var(--gradient-primary) !important;
  border: none !important;
  color: var(--text-white) !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
  margin-right: 24rpx;
}

.bottom-btn .t-button__text {
  font-size: 16rpx !important;
}

.t-button--default::after {
  border: none !important;
}
