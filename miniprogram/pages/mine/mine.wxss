.page {
  min-height: 100vh;
  background: var(--bg-page);
  color: var(--text-primary);
  box-sizing: border-box;
}

.hero {
  position: relative;
  padding: 128rpx 32rpx 104rpx;
  text-align: center;
  overflow: hidden;
}

.hero::before,
.hero::after {
  content: "";
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--deco-pink);
  transform: rotate(35deg);
  opacity: 0.9;
}

.hero::before {
  left: 210rpx;
  top: 104rpx;
}

.hero::after {
  right: 94rpx;
  bottom: 72rpx;
  background: var(--deco-blue);
}

.top-actions {
  position: absolute;
  top: 64rpx;
  left: 28rpx;
  right: 28rpx;
  z-index: 2;
  display: flex;
  justify-content: space-between;
}

.hero-title {
  position: relative;
  z-index: 2;
  display: block;
  font-size: var(--fs-72);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0;
  background: var(--gradient-shimmer);
  background-size: 300% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: shimmer 5s linear infinite;
}

@keyframes shimmer {
  0% {
    background-position: 200% center;
  }
  100% {
    background-position: -200% center;
  }
}

.bubble {
  position: absolute;
  z-index: 1;
  max-width: 280rpx;
  padding: 12rpx 18rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.92);
  color: var(--accent);
  font-size: var(--fs-24);
  font-weight: 600;
  line-height: 1.2;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.12);
  white-space: nowrap;
  opacity: 0;
  animation: bubble-in 1s cubic-bezier(0.2, 1.4, 0.4, 1) forwards;
}

@keyframes bubble-in {
  0% {
    opacity: 0;

    transform: translateY(24rpx) scale(0.85) rotate(0deg);
  }

  100% {
    opacity: 1;

    transform: translateY(0) scale(1) rotate(var(--rotate));
  }
}

.bubble::after {
  content: "";
  position: absolute;
  bottom: -8rpx;
  left: 36rpx;
  width: 18rpx;
  height: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  transform: rotate(45deg);
}

.bubble-1 {
  left: 32rpx;
  top: 42rpx;
  animation-delay: 0.3s;
}

.bubble-2 {
  right: 28rpx;
  top: 70rpx;
  animation-delay: 0.7s;
}

.bubble-3 {
  left: 156rpx;
  bottom: 34rpx;
  animation-delay: 1.2s;
}
.bubble-1 {
  --rotate: -6deg;
}

.bubble-2 {
  --rotate: 5deg;
}

.bubble-3 {
  --rotate: -2deg;
}

.filter-panel {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 5;
  padding: 0 24rpx 20rpx;
  background: var(--bg-page);
  box-sizing: border-box;
}

.filter-panel.expanded {
  padding-top: 24rpx;
  padding-bottom: 40rpx;
  box-shadow: 0 24rpx 40rpx rgba(0, 0, 0, 0.18);
}

.filter-title-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.filter-title {
  flex-shrink: 0;
  font-size: var(--fs-32);
  font-weight: 800;
}

.filter-desc {
  flex: 1;
  min-width: 0;
  color: rgba(0, 0, 0, 0.58);
  font-size: var(--fs-24);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-toggle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.collapsed-filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.track-tabs {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.track-tab-list {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 24rpx 8rpx 0;
}

.track-tab {
  position: relative;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-full);
  background: transparent;
  color: var(--text-secondary);
  font-size: var(--fs-28);
  font-weight: 500;
  line-height: 1;
  transition:
    transform 0.2s ease,
    color 0.2s ease,
    background-color 0.2s ease;
}

.track-tab:active {
  transform: scale(0.97);
}

.track-tab-text {
  position: relative;
  z-index: 2;
  white-space: nowrap;
}

.track-tab.active {
  color: var(--text-primary);
  font-weight: 700;
  background: rgba(79, 70, 229, 0.06);
}

.track-tab-scribble {
  position: absolute;
  left: 20rpx;
  right: 16rpx;
  bottom: 8rpx;
  height: 18rpx;
  pointer-events: none;
}

.track-tab-scribble-line {
  position: absolute;
  left: 0;
  width: 100%;
  border-radius: var(--radius-full);
  background: var(--gradient-accent);
  transform-origin: left center;
}

.track-tab-scribble .line-1 {
  bottom: 2rpx;
  height: 6rpx;
  transform: rotate(-2deg);
}

.track-tab-scribble .line-2 {
  bottom: 7rpx;
  left: 12rpx;
  width: calc(100% - 18rpx);
  height: 4rpx;
  opacity: 0.75;
  transform: rotate(1.5deg);
}

.track-expand {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-primary);
}

.track-expand-icon {
  color: var(--text-primary) !important;
}

.track-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.track-grid-item {
  min-width: 148rpx;
  height: 74rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.72);
  color: rgba(0, 0, 0, 0.48);
  font-size: var(--fs-28);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.track-grid-item.active {
  background: var(--chip-active-bg);
  color: var(--text-white);
}

.sort-section {
  margin-top: 42rpx;
}

.sort-title {
  font-size: var(--fs-32);
  font-weight: 800;
}

.sort-row {
  margin-top: 22rpx;
  display: flex;
  justify-content: center;
}

.sort-btn {
  height: 72rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.72);
  color: rgba(0, 0, 0, 0.5);
  font-size: var(--fs-28);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sort-btn.active {
  background: var(--chip-active-bg);
  color: var(--text-white);
}

.works-section {
  padding: 0 var(--pd-base) var(--pd-xl);
  transition: opacity 0.2s ease;
}

.works-section.dimmed {
  opacity: 0.45;
}

.loading-tip {
  text-align: center;
  padding: 64rpx 32rpx;
  color: var(--text-muted);
  font-size: var(--fs-28);
}

.bottom-btn {
  min-width: 240rpx;
  height: var(--btn-height) !important;
  padding: 0 40rpx !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  background: var(--gradient-primary) !important;
  border: none !important;
  outline: none !important;
  --td-button-default-border-color: transparent !important;
  --td-button-default-color: transparent !important;
  color: var(--text-white) !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
}

.bottom-btn::after {
  border: none !important;
  border-color: transparent !important;
}

.bottom-btn .t-button__text {
  width: 100%;
  text-align: center !important;
  font-size: var(--fs-32) !important;
  font-weight: 700 !important;
}

.t-cell {
  margin-top: 20rpx;
}

.empty-status {
  height: 90vh;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

.bottom-btn {
  margin-top: 50rpx;
}
