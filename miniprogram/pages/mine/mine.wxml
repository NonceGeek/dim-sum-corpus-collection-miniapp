<view class="page theme-{{currentTheme}}">
  <block wx:if="{{flag || loading || visibleWorks.length > 0}}">
    <view class="hero">
      <view class="bubble bubble-1">你都几敢讲喔</view>
      <view class="bubble bubble-2">全场最有声气嘅人</view>
      <view class="bubble bubble-3">边个仲未听过你把声</view>
      <view class="hero-title">开过咪，就留低痕迹</view>
    </view>

    <view class="filter-panel {{filterExpanded ? 'expanded' : ''}}">
      <view class="filter-title-row" wx:if="{{filterExpanded}}">
        <view class="filter-title">选择活动</view>
        <view class="filter-toggle" bind:tap="onToggleFilters">
          <t-icon name="chevron-up" size="40rpx" t-class="track-expand-icon" />
        </view>
      </view>

      <view wx:if="{{!filterExpanded}}" class="collapsed-filter-row">
        <scroll-view class="track-tabs" scroll-x show-scrollbar="false">
          <view class="track-tab-list">
            <view wx:for="{{tracks}}" wx:key="id" class="track-tab {{activeTrack === item.id ? 'active' : ''}}"
              bind:tap="onTrackTapOutside" data-value="{{item.id}}">
              <text class="track-tab-text">{{item.title}}</text>
              <view class="track-tab-scribble" wx:if="{{activeTrack === item.id}}">
                <view class="track-tab-scribble-line line-1"></view>
                <view class="track-tab-scribble-line line-2"></view>
              </view>
            </view>
          </view>
        </scroll-view>
        <view class="track-expand" bind:tap="onToggleFilters">
          <t-icon name="chevron-down" size="40rpx" t-class="track-expand-icon" />
        </view>
      </view>

      <view wx:else class="track-grid">
        <view wx:for="{{tracks}}" wx:key="id" class="track-grid-item {{activeTrack === item.id ? 'active' : ''}}"
          bind:tap="onTrackTap" data-value="{{item.id}}">
          {{item.title}}
        </view>
      </view>

      <view class="sort-section" wx:if="{{filterExpanded}}">
        <view class="filter-title-row">
          <view class="filter-title">选择状态</view>
        </view>
        <view class="track-grid">
          <view wx:for="{{status}}" wx:key="value"
            class="track-grid-item {{activeStatus === item.value ? 'active' : ''}}" bind:tap="onStatusTap"
            data-value="{{item.value}}">
            {{item.label}}
          </view>
        </view>

        <view class="sort-row">
          <t-button theme="default" shape="round" size="medium" class="bottom-btn" hover-class="none"
            bind:tap="onSubmit">
            确定
          </t-button>
        </view>
      </view>
    </view>

    <view class="works-section {{filterExpanded ? 'dimmed' : ''}}">
      <waterfall items="{{visibleWorks}}" showStatus showPlayBadge bind:itemtap="onWaterfallTap" />
    </view>
  </block>
  <block wx:else>
    <t-cell-group theme="card" bordered="{{false}}">
      <t-cell title="目前仲未有作品，等你开第一围～" hover />
    </t-cell-group>
    <view class="empty-status">
      <t-empty icon="rice">
        <view slot="description" class="empty-desc">
          <view>目前得个白饭</view>
          <view>等你来加餸</view>
        </view>
      </t-empty>
      <t-button theme="default" shape="round" size="medium" class="bottom-btn" hover-class="none"
        bind:tap="onNavigateToActivity">
        我要加餸
      </t-button>
    </view>
  </block>
</view>
