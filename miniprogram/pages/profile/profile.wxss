/* mine.wxss */

.container {
  min-height: 100vh;
  background: var(--bg-page);
  display: block;
  align-items: unset;
  justify-content: unset;
  width: 100%;
  padding: 0 0 180rpx;
  box-sizing: border-box;
}
/* 用户卡片 */

.user-card {
  position: relative;
  overflow: hidden;

  padding: var(--pd-lg);

  background: var(--gradient-primary);

  box-shadow: var(--shadow-primary);

  width: 100%;
  box-sizing: border-box;
}

.user-card::after {
  content: "";

  position: absolute;
  top: -80rpx;
  right: -60rpx;

  width: 240rpx;
  height: 240rpx;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.08);
}

.user-info {
  position: relative;
  z-index: 2;

  display: flex;
  align-items: center;
}

.guest-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.guest-meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.guest-description {
  margin-top: 10rpx;
  font-size: var(--fs-24);
  color: rgba(255, 255, 255, 0.82);
}

.guest-login-btn {
  flex: none;
  min-width: 144rpx;
  height: var(--btn-height);
  margin: 0;
  padding: 0 var(--pd-base);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.18);
  color: var(--text-white);
  font-size: var(--fs-28);
  font-weight: 700;
  line-height: calc(var(--btn-height) - 4rpx);
}

.guest-login-btn::after {
  border: none;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.2);
}

.avatar-placeholder {
  background: var(--primary, #4f46e5);
  color: var(--text-white);
  font-size: var(--fs-56);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-meta {
  margin-left: 24rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
}

.nickname {
  font-size: var(--fs-40);
  font-weight: 700;
  color: var(--text-white);
}

.user-id {
  margin-top: 14rpx;

  font-size: var(--fs-24);
  color: rgba(255, 255, 255, 0.82);
}

.post-num {
  font-weight: bold;
  font-size: var(--fs-32);
  margin-right: 10rpx;
}

/* 菜单 */
.menu-group {
  margin: var(--pd-base) !important;
  border-radius: var(--radius-lg) !important;
  overflow: hidden;
}

.theme-action-sheet {
  --td-action-sheet-border-color: transparent;
  --td-action-sheet-border-radius: var(--radius-2xl);
  --td-popup-border-radius: var(--radius-2xl);
  background-color: var(--bg-card) !important;
}

.theme-action-sheet .t-popup,
.theme-action-sheet .t-popup__content {
  background-color: var(--bg-card) !important;
}

.theme-action-sheet .t-action-sheet__description::after,
.theme-action-sheet .t-action-sheet__list-item::after,
.theme-action-sheet .t-action-sheet__gap-grid {
  display: none;
}

/* 退出 */

.logout-btn {
  margin: 24rpx;

  height: var(--btn-height);

  border-radius: var(--radius-full);

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: var(--fs-32);
  font-weight: 700;

  background: var(--danger);
  color: var(--text-white);

  box-shadow: var(--shadow-primary);
}

.setting-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.theme-icon {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  color: #b45309;
}

.theme-dark .theme-icon {
  background: linear-gradient(135deg, #1e3a5f 0%, #2d4a6f 100%);
  color: #60a5fa;
}

.music-icon {
  background: linear-gradient(135deg, #d8fa99 0%, #9ae600 100%);
  color: #009689;
}

.theme-dark .music-icon {
  background: linear-gradient(135deg, #e9d4ff 0%, #c27aff 100%);
  color: #e12afb;
}

.chat-icon {
  background: linear-gradient(135deg, #b8e6fe 0%, #00bcff 100%);
  color: #155dfc;
}

.theme-dark .chat-icon {
  background: linear-gradient(135deg, #c6d2ff 0%, #7c86ff 100%);
  color: #4f39f6;
}

.t-cell__title-text {
  padding-top: 6px;
}

.chat-section .t-cell__note {
  margin-top: -13px;
}

.hint {
  display: flex;
  justify-content: center;
  margin: 36rpx 0;
}
