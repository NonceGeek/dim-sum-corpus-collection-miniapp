/* mine.wxss */

.container {
  min-height: 100vh;
  background: var(--bg-page);
  display: block;
  align-items: unset;
  justify-content: unset;
  width: 100%;
  padding: 0;
  box-sizing: border-box;
}
/* 用户卡片 */

.user-card {
  position: relative;
  overflow: hidden;

  padding: 36rpx;

  background: var(--gradient-primary);

  box-shadow: var(--shadow-primary);

  width: 100%;
  box-sizing: border-box;
}

.user-card::after {
  content: "";

  position: absolute;
  top: -80rpx;
  right: -60rpx;

  width: 240rpx;
  height: 240rpx;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.08);
}

.user-info {
  position: relative;
  z-index: 2;

  display: flex;
  align-items: center;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.2);
}

.avatar-placeholder {
  background: var(--primary, #4f46e5);
  color: var(--text-white);
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-meta {
  margin-left: 24rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
}

.nickname {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-white);
}

.vip-tag {
  margin-left: 14rpx;
  padding: 8rpx 18rpx;

  border-radius: 999rpx;

  font-size: 22rpx;
  color: var(--text-white);

  background: rgba(255, 255, 255, 0.16);

  backdrop-filter: blur(12rpx);
}

.user-id {
  margin-top: 14rpx;

  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
}

.edit-btn {
  position: absolute;
  right: 28rpx;
  top: 28rpx;

  z-index: 2;

  padding: 12rpx 24rpx;

  border-radius: 999rpx;

  font-size: 24rpx;
  color: var(--text-white);

  background: rgba(255, 255, 255, 0.12);

  backdrop-filter: blur(10rpx);
}

.post-num {
  font-weight: bold;
  font-size: 35rpx;
  margin-right: 10rpx;
}

/* 菜单 */
.t-cell-group--card {
  margin: 24rpx !important;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-white);
  background: var(--danger);
}

/* 外观模式 */

.theme-card {
  margin-top: 28rpx;

  padding: 32rpx 28rpx;

  background: var(--bg-card);
  border-radius: 32rpx;

  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.theme-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.theme-options {
  margin-top: 28rpx;

  display: flex;
  gap: 20rpx;
}

.theme-option {
  flex: 1;

  padding: 20rpx;

  border-radius: 24rpx;

  text-align: center;

  border: 2rpx solid transparent;

  transition: all 0.25s ease;
}

.theme-option.active {
  border-color: var(--primary);
  background: var(--primary-soft);
}

.theme-preview {
  width: 100%;
  height: 120rpx;

  border-radius: 18rpx;

  margin-bottom: 16rpx;
}

.light-preview {
  background: linear-gradient(180deg, #ffffff, #ececec);
}

.dark-preview {
  background: linear-gradient(180deg, #222, #000);
}

.system-preview {
  background: linear-gradient(90deg, #ffffff 50%, #111 50%);
}

/* 退出 */

.logout-btn {
  margin: 24rpx;

  height: var(--btn-height-lg);

  border-radius: 999rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 32rpx;
  font-weight: 700;

  background: var(--danger);
  color: var(--text-white);

  box-shadow: var(--shadow-primary);
}

.setting-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.theme-icon {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  color: #b45309;
}

.theme-dark .theme-icon {
  background: linear-gradient(135deg, #1e3a5f 0%, #2d4a6f 100%);
  color: #60a5fa;
}

.music-icon {
  background: linear-gradient(135deg, #d8fa99 0%, #9ae600 100%);
  color: #009689;
}

.theme-dark .music-icon {
  background: linear-gradient(135deg, #e9d4ff 0%, #c27aff 100%);
  color: #e12afb;
}

.chat-icon {
  background: linear-gradient(135deg, #b8e6fe 0%, #00bcff 100%);
  color: #155dfc;
}

.theme-dark .chat-icon {
  background: linear-gradient(135deg, #c6d2ff 0%, #7c86ff 100%);
  color: #4f39f6;
}

.t-cell__title-text {
  padding-top: 6px;
}

.chat-section .t-cell__note {
  margin-top: -13px;
}

.hint {
  display: flex;
  justify-content: center;
  margin: 36rpx 0;
}
