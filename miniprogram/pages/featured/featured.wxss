.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 120rpx;
}

/* Banner */
.top-banner {
  padding: 32rpx;
  color: #1a1a1a;
}

.banner-title {
  position: relative;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.2;
  background: linear-gradient(90deg, #4a7cf3, #7c5cff, #ffffff, #4a7cf3);
  background-size: 300% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: shimmer 5s linear infinite;
}

@keyframes shimmer {
  0% {
    background-position: 200% center;
  }
  100% {
    background-position: -200% center;
  }
}

.banner-subtitle {
  position: relative;
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 700;
  background: linear-gradient(90deg, #4a7cf3, #7c5cff, #ffffff, #4a7cf3);
  background-size: 300% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: shimmer 5s linear infinite;
  animation-delay: -1s;
}

.banner-desc {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #7a6331;
  height: 40rpx;
  overflow: hidden;
  position: relative;
}

.banner-desc-text {
  position: absolute;
  width: 100%;
  font-size: 30rpx;
  color: #7a6331;
  transition:
    opacity 0.5s ease,
    transform 0.5s ease;
}

.banner-desc-text.show {
  opacity: 1;
  transform: translateY(0);
}

.banner-desc-text.hide {
  opacity: 0;
  transform: translateY(-20rpx);
}

.card-swiper {
  margin: 0 24rpx;
  height: 830rpx;
  width: 100%;
  padding-bottom: 40rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
}

/* 主卡片 */
.main-card {
  height: calc(100% - 40rpx);
  box-sizing: border-box;
  position: relative;
  margin: 0;
  background: var(--bg-card);
  border-radius: 40rpx;
  padding: 40rpx 32rpx 48rpx;
  border: 2px solid var(--border-color);
  box-shadow: var(--shadow-primary);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.card-title {
  font-size: 60rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.card-en {
  color: #7a6331;
  font-size: 32rpx;
  margin-left: 20rpx;
}

.card-desc {
  margin-top: 20rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  font-size: 30rpx;
}

/* 视频区域 */
.video-scroll {
  margin-top: 36rpx;
}

.video-list {
  display: flex;
  gap: 20rpx;
}

.video-item {
  width: 210rpx;
  flex-shrink: 0;
}

.video-cover-wrapper {
  position: relative;
}

.video-cover {
  width: 210rpx;
  height: 320rpx;
  border-radius: 24rpx;
  background: #eee;
}

.play-icon {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
}

.author-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.author-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.empty-work-stage {
  position: relative;
  height: 376rpx;
  margin-top: 36rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background:
    radial-gradient(
      circle at 50% 48%,
      rgba(255, 255, 255, 0.86),
      rgba(255, 255, 255, 0) 48%
    ),
    linear-gradient(135deg, rgba(74, 124, 243, 0.1), rgba(255, 186, 73, 0.12));
}

.empty-work-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
}

.empty-work-stage.is-active .empty-work-image {
  animation: emptyImageReveal 0.55s ease-out forwards;
  animation-delay: 1.2s;
}

.firework-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  pointer-events: none;
}

.firework {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  opacity: 0;
  background: #fff;
  transform: scale(0.2);
}

.empty-work-stage.is-active .firework {
  animation: fireworkBurst 1.22s ease-out forwards;
}

.firework-1 {
  left: 18%;
  top: 28%;
  background: #ffcc4d;
  box-shadow:
    0 -46rpx #ffcc4d,
    38rpx -28rpx #ff6b6b,
    48rpx 8rpx #5cc8ff,
    22rpx 42rpx #7c5cff,
    -24rpx 42rpx #2fd6a2,
    -48rpx 8rpx #ffffff,
    -36rpx -28rpx #ff8f3f;
}

.firework-2 {
  left: 74%;
  top: 24%;
  background: #5cc8ff;
  box-shadow:
    0 -40rpx #5cc8ff,
    34rpx -20rpx #ffffff,
    36rpx 22rpx #ffcc4d,
    0 44rpx #ff6b6b,
    -36rpx 22rpx #7c5cff,
    -34rpx -20rpx #2fd6a2;
}

.firework-3 {
  left: 48%;
  top: 34%;
  background: #ff6b6b;
  box-shadow:
    0 -54rpx #ff6b6b,
    46rpx -28rpx #ffcc4d,
    52rpx 16rpx #ffffff,
    18rpx 54rpx #2fd6a2,
    -30rpx 48rpx #5cc8ff,
    -54rpx 2rpx #7c5cff,
    -34rpx -42rpx #ff8f3f;
}

.firework-4 {
  left: 28%;
  top: 66%;
  background: #2fd6a2;
  box-shadow:
    0 -38rpx #2fd6a2,
    32rpx -24rpx #5cc8ff,
    42rpx 8rpx #ffcc4d,
    18rpx 38rpx #ffffff,
    -22rpx 34rpx #ff6b6b,
    -42rpx -4rpx #7c5cff;
}

.firework-5 {
  left: 80%;
  top: 62%;
  background: #7c5cff;
  box-shadow:
    0 -48rpx #7c5cff,
    42rpx -26rpx #ff8f3f,
    46rpx 18rpx #ffffff,
    0 50rpx #5cc8ff,
    -42rpx 18rpx #2fd6a2,
    -42rpx -26rpx #ffcc4d;
}

.firework-6 {
  left: 58%;
  top: 78%;
  background: #ff8f3f;
  box-shadow:
    0 -36rpx #ff8f3f,
    30rpx -18rpx #ffcc4d,
    34rpx 18rpx #7c5cff,
    0 38rpx #ffffff,
    -34rpx 18rpx #5cc8ff,
    -30rpx -18rpx #2fd6a2;
}

.firework-7 {
  left: 10%;
  top: 54%;
  background: #ffffff;
  box-shadow:
    0 -34rpx #ffffff,
    28rpx -18rpx #5cc8ff,
    36rpx 14rpx #ff6b6b,
    6rpx 40rpx #ffcc4d,
    -30rpx 20rpx #2fd6a2,
    -32rpx -16rpx #7c5cff;
}

.firework-8 {
  left: 66%;
  top: 42%;
  background: #ffcc4d;
  box-shadow:
    0 -30rpx #ffcc4d,
    26rpx -16rpx #ffffff,
    30rpx 14rpx #2fd6a2,
    0 34rpx #ff6b6b,
    -30rpx 14rpx #5cc8ff,
    -26rpx -16rpx #7c5cff;
}

.empty-work-stage.is-active .firework-2 {
  animation-delay: 0.1s;
}

.empty-work-stage.is-active .firework-3 {
  animation-delay: 0.18s;
}

.empty-work-stage.is-active .firework-4 {
  animation-delay: 0.28s;
}

.empty-work-stage.is-active .firework-5 {
  animation-delay: 0.36s;
}

.empty-work-stage.is-active .firework-6 {
  animation-delay: 0.46s;
}

.empty-work-stage.is-active .firework-7 {
  animation-delay: 0.54s;
}

.empty-work-stage.is-active .firework-8 {
  animation-delay: 0.62s;
}

@keyframes fireworkBurst {
  0% {
    opacity: 0;
    transform: scale(0.18);
  }
  18% {
    opacity: 1;
  }
  62% {
    opacity: 0.92;
    transform: scale(1.08);
  }
  100% {
    opacity: 0;
    transform: scale(1.5);
  }
}

@keyframes emptyImageReveal {
  0% {
    opacity: 0;
    transform: scale(0.96);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 按钮 */
.btn-row {
  margin-top: 36rpx;
  display: flex;
  gap: 24rpx;
}

.btn-row .t-button {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
}
.post-btn {
  color: #fff;
}
.post-btn.unactive {
  background: var(--text-muted) !important;
}

/* 底部箭头 */
.arrow-bottom {
  position: absolute;
  left: 50%;
  bottom: -20rpx;
  transform: translateX(-50%) rotate(45deg);
  width: 40rpx;
  height: 40rpx;
  background: var(--bg-card);
  box-shadow: var(--shadow-primary);
}

/* tabs */

.tab-container {
  margin-top: 24rpx;
  height: 180rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.tab-list {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 24rpx;
}

.tab-item {
  flex-shrink: 0;
  min-width: 220rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-input);
  border-radius: 28rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: var(--shadow-primary);
  transition: all 0.25s ease;
  transform: scale(0.88);
}

.tab-item.active {
  transform: scale(1);
  opacity: 1;
  background: #7a6331;
}

.tab-item.active .tab-title,
.tab-item.active .tab-sub {
  color: #fff !important;
}

.tab-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.tab-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #fff;
}

.slide-tips {
  margin-top: 24rpx;
  text-align: center;
  color: #8a7a4a;
  font-size: 24rpx;
}

/* 底部 */
.bottom-actions {
  margin-top: 48rpx;
  padding: 0 24rpx;
  display: flex;
  gap: 24rpx;
}

.bottom-btn {
  background: var(--gradient-primary) !important;
  border: none !important;
  color: #fff !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
}

.bottom-btn .t-button__text {
  font-size: 32rpx !important;
}

.t-button--default::after {
  border: none !important;
}

.tracks-popup-host,
.tracks-popup {
  border-top-left-radius: 40rpx !important;
  border-top-right-radius: 40rpx !important;
  overflow: hidden;
}

.tracks-popup {
  display: flex;
  flex-direction: column;
  height: 78vh;
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #b1844b;
}

.tracks-popup-handle {
  width: 72rpx;
  height: 10rpx;
  margin: 0 auto 56rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
}

.tracks-popup-list {
  flex: 1;
  height: calc(78vh - 122rpx - env(safe-area-inset-bottom));
  min-height: 0;
}

.tracks-popup-list-content {
  min-height: 100%;
}

.tracks-popup-card {
  width: 100%;
  margin-bottom: 40rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #d9d9d9;
  border: 2rpx solid rgba(91, 58, 22, 0.35);
  border-radius: 24rpx;
}

.tracks-popup-card:active {
  opacity: 0.9;
}

.tracks-popup-card-main {
  padding: 32rpx 28rpx 24rpx;
  background: var(--bg-card);
  border-radius: 22rpx;
}

.tracks-popup-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.tracks-popup-card-title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tracks-popup-more {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  color: var(--text-muted);
  font-size: 26rpx;
}

.tracks-popup-card-desc {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.tracks-popup-video-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22rpx;
  margin-top: 34rpx;
}

.tracks-popup-video-item {
  min-width: 0;
}

.tracks-popup-cover-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: var(--text-muted);
}

.tracks-popup-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.tracks-popup-play {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
}

.tracks-popup-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  min-width: 0;
}

.tracks-popup-avatar {
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

.tracks-popup-author-name {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tracks-popup-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx;
}

.tracks-popup-rule {
  flex: 1;
  min-width: 0;
  color: #1a1f36;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tracks-popup-status {
  flex-shrink: 0;
  padding: 16rpx 34rpx;
  border-radius: 999rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  background: var(--text-muted);
}

.tracks-popup-status.active {
  background: var(--gradient-primary);
  border: 0;
  color: #fff;
}

.info {
  display: flex;
  height: 90vh;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}
