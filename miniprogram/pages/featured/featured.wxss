.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 var(--pd-base);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

/* Banner */
.top-banner {
  box-sizing: border-box;
  width: calc(100% - 48rpx);
  padding: var(--pd-lg) 0;
  color: var(--text-primary);
}

.banner-danmaku-track {
  position: relative;
  height: 46rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.banner-danmaku-list {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-title-text,
.banner-subtitle-text {
  display: inline-block;
  position: absolute;
  top: 0;
  left: 0;
  line-height: 1.4;
  white-space: nowrap;
  will-change: transform;
}

.banner-title-text {
  font-size: var(--fs-40);
  font-weight: 600;
  animation: banner-danmaku 12s linear -1s infinite;
}

.banner-danmaku-text {
  background: var(--gradient-shimmer);
  background-size: 300% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: banner-text-shimmer 5s linear infinite;
}

.banner-subtitle-text {
  font-size: var(--fs-40);
  font-weight: 500;
  animation: banner-danmaku 12s linear -7s infinite;
}

@keyframes banner-danmaku {
  from {
    transform: translateX(calc(100vw - 96rpx));
  }

  to {
    transform: translateX(calc(-100vw + 96rpx));
  }
}

@keyframes banner-text-shimmer {
  from {
    background-position: 200% center;
  }

  to {
    background-position: -200% center;
  }
}

.banner-desc {
  margin-top: 8rpx;
  font-size: var(--fs-32);
  color: var(--accent);
  height: 40rpx;
  overflow: hidden;
  position: relative;
  text-align: center;
}

.banner-desc-text {
  position: absolute;
  width: 100%;
  font-size: var(--fs-32);
  color: var(--accent);
  text-align: center;
  transition:
    opacity 0.5s ease,
    transform 0.5s ease;
}

.banner-desc-text.show {
  opacity: 1;
  transform: translateY(0);
}

.banner-desc-text.hide {
  opacity: 0;
  transform: translateY(-20rpx);
}

.card-swiper {
  height: 1010rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 主卡片 */
.main-card {
  height: calc(100% - 30rpx);
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: var(--pd-xl) var(--pd-lg) var(--pd-2xl);
  border: 2px solid var(--border-color);
  box-shadow: var(--shadow-primary);
}

.card-header {
  display: flex;
  flex: 0 0 auto;
  margin-bottom: 36rpx;
  justify-content: space-between;
  align-items: flex-start;
}

.card-header > view {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
}

.card-title {
  font-size: var(--fs-40);
  font-weight: 700;
  line-height: 52rpx;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-en {
  height: 40rpx;
  margin-top: 10rpx;
  color: var(--accent);
  font-size: var(--fs-24);
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc {
  margin-top: 10rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  font-size: var(--fs-32);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.media-req-slot {
  margin-top: 20rpx;
}

.media-req-row {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.container .media-requirement-icon.media-requirement-icon {
  color: var(--text-secondary) !important;
}

.media-requirement-item {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-full);
  background: var(--bg-input);
  color: var(--text-secondary);
  font-size: var(--fs-24);
  line-height: 1.2;
  white-space: nowrap;
  box-sizing: border-box;
}

/* 视频区域 */
.video-scroll {
  flex: 0 0 376rpx;
  height: 376rpx;
  margin-top: auto;
  box-sizing: border-box;
}

.video-list {
  display: flex;
  gap: 20rpx;
}

.video-item {
  width: 210rpx;
  flex-shrink: 0;
}

.video-cover-wrapper {
  position: relative;
}

.video-cover {
  width: 210rpx;
  height: 320rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-placeholder);
}

.play-icon {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
}

.author-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.author-name {
  font-size: var(--fs-24);
  color: var(--text-secondary);
}

.empty-work-stage {
  position: relative;
  flex: 0 0 376rpx;
  height: 376rpx;
  margin-top: auto;
  overflow: hidden;
  border-radius: 28rpx;
  background: linear-gradient(
    135deg,
    rgba(74, 124, 243, 0.1),
    rgba(255, 186, 73, 0.12)
  );
}

.empty-work-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
}

.empty-work-stage.is-active .empty-work-image {
  animation: emptyImageReveal 0.55s ease-out forwards;
  animation-delay: 1.2s;
}

.firework-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  pointer-events: none;
}

.firework {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  opacity: 0;
  background: var(--text-white);
  transform: scale(0.2);
}

.empty-work-stage.is-active .firework {
  animation: fireworkBurst 1.22s ease-out forwards;
}

.firework-1 {
  left: 18%;
  top: 28%;
  background: #ffcc4d;
  box-shadow:
    0 -46rpx #ffcc4d,
    38rpx -28rpx #ff6b6b,
    48rpx 8rpx #5cc8ff,
    22rpx 42rpx #7c5cff,
    -24rpx 42rpx #2fd6a2,
    -48rpx 8rpx #ffffff,
    -36rpx -28rpx #ff8f3f;
}

.firework-2 {
  left: 74%;
  top: 24%;
  background: #5cc8ff;
  box-shadow:
    0 -40rpx #5cc8ff,
    34rpx -20rpx #ffffff,
    36rpx 22rpx #ffcc4d,
    0 44rpx #ff6b6b,
    -36rpx 22rpx #7c5cff,
    -34rpx -20rpx #2fd6a2;
}

.firework-3 {
  left: 48%;
  top: 34%;
  background: #ff6b6b;
  box-shadow:
    0 -54rpx #ff6b6b,
    46rpx -28rpx #ffcc4d,
    52rpx 16rpx #ffffff,
    18rpx 54rpx #2fd6a2,
    -30rpx 48rpx #5cc8ff,
    -54rpx 2rpx #7c5cff,
    -34rpx -42rpx #ff8f3f;
}

.firework-4 {
  left: 28%;
  top: 66%;
  background: #2fd6a2;
  box-shadow:
    0 -38rpx #2fd6a2,
    32rpx -24rpx #5cc8ff,
    42rpx 8rpx #ffcc4d,
    18rpx 38rpx #ffffff,
    -22rpx 34rpx #ff6b6b,
    -42rpx -4rpx #7c5cff;
}

.firework-5 {
  left: 80%;
  top: 62%;
  background: #7c5cff;
  box-shadow:
    0 -48rpx #7c5cff,
    42rpx -26rpx #ff8f3f,
    46rpx 18rpx #ffffff,
    0 50rpx #5cc8ff,
    -42rpx 18rpx #2fd6a2,
    -42rpx -26rpx #ffcc4d;
}

.firework-6 {
  left: 58%;
  top: 78%;
  background: #ff8f3f;
  box-shadow:
    0 -36rpx #ff8f3f,
    30rpx -18rpx #ffcc4d,
    34rpx 18rpx #7c5cff,
    0 38rpx #ffffff,
    -34rpx 18rpx #5cc8ff,
    -30rpx -18rpx #2fd6a2;
}

.firework-7 {
  left: 10%;
  top: 54%;
  background: #ffffff;
  box-shadow:
    0 -34rpx #ffffff,
    28rpx -18rpx #5cc8ff,
    36rpx 14rpx #ff6b6b,
    6rpx 40rpx #ffcc4d,
    -30rpx 20rpx #2fd6a2,
    -32rpx -16rpx #7c5cff;
}

.firework-8 {
  left: 66%;
  top: 42%;
  background: #ffcc4d;
  box-shadow:
    0 -30rpx #ffcc4d,
    26rpx -16rpx #ffffff,
    30rpx 14rpx #2fd6a2,
    0 34rpx #ff6b6b,
    -30rpx 14rpx #5cc8ff,
    -26rpx -16rpx #7c5cff;
}

.empty-work-stage.is-active .firework-2 {
  animation-delay: 0.1s;
}

.empty-work-stage.is-active .firework-3 {
  animation-delay: 0.18s;
}

.empty-work-stage.is-active .firework-4 {
  animation-delay: 0.28s;
}

.empty-work-stage.is-active .firework-5 {
  animation-delay: 0.36s;
}

.empty-work-stage.is-active .firework-6 {
  animation-delay: 0.46s;
}

.empty-work-stage.is-active .firework-7 {
  animation-delay: 0.54s;
}

.empty-work-stage.is-active .firework-8 {
  animation-delay: 0.62s;
}

@keyframes fireworkBurst {
  0% {
    opacity: 0;
    transform: scale(0.18);
  }
  18% {
    opacity: 1;
  }
  62% {
    opacity: 0.92;
    transform: scale(1.08);
  }
  100% {
    opacity: 0;
    transform: scale(1.5);
  }
}

@keyframes emptyImageReveal {
  0% {
    opacity: 0;
    transform: scale(0.96);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 按钮 */
.btn-row {
  margin-top: 36rpx;
  display: flex;
  gap: 24rpx;
}

.btn-row .t-button {
  flex: 1;
  height: var(--btn-height);
  font-size: var(--fs-32);
}
.post-btn {
  color: var(--text-white);
}
.post-btn.unactive {
  background: var(--text-muted) !important;
}

/* 底部箭头 */
.arrow-bottom {
  position: absolute;
  left: 50%;
  bottom: -32rpx;
  width: 64rpx;
  height: 32rpx;
  overflow: hidden;
  transform: translateX(-50%);
}

.arrow-bottom::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: -20rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--bg-card);
  border-right: 2px solid var(--border-color);
  border-bottom: 2px solid var(--border-color);
  transform: rotate(45deg);
}

/* tabs */

.tab-container {
  margin-top: 12rpx;
  height: 180rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.tab-list {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 24rpx;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  min-width: 0;
  padding: var(--pd-sm) var(--pd-base);
  background: var(--bg-input);
  border-radius: var(--radius-xl);
  text-align: center;
  box-sizing: border-box;
  box-shadow: var(--shadow-primary);
  transition: all 0.25s ease;
  transform: scale(0.88);
}

.tab-item.active {
  transform: scale(1);
  opacity: 1;
  background: var(--accent);
}

.tab-item.active .tab-title,
.tab-item.active .tab-sub {
  color: var(--text-white) !important;
}

.tab-title {
  font-size: var(--fs-32);
  font-weight: 700;
  color: var(--text-primary);
  word-break: break-all;
  white-space: normal;
  text-align: center;
}

.tab-sub {
  margin-top: 10rpx;
  font-size: var(--fs-24);
  color: var(--text-white);
}

.slide-tips {
  margin-top: 24rpx;
  text-align: center;
  color: var(--accent-muted);
  font-size: var(--fs-24);
}

/* 底部 */
.bottom-actions {
  display: flex;
  width: 100%;
  gap: var(--pd-base);
  box-sizing: border-box;
  margin-top: var(--pd-base);
}

.bottom-btn {
  flex: 1;
  min-width: 0;
  background: var(--gradient-primary) !important;
  border: none !important;
  color: var(--text-white) !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
}

.bottom-btn .t-button__text {
  font-size: var(--fs-32) !important;
}

.t-button--default::after {
  border: none !important;
}

.tracks-popup-host,
.tracks-popup-host .t-popup,
.tracks-popup-host .t-popup__content,
.tracks-popup {
  border-top-left-radius: var(--radius-2xl) !important;
  border-top-right-radius: var(--radius-2xl) !important;
  overflow: hidden;
}

.tracks-popup-host {
  --td-popup-border-radius: var(--radius-2xl);
  background: var(--bg-page) !important;
}

.tracks-popup {
  display: flex;
  flex-direction: column;
  height: 78vh;
  padding: var(--pd-lg) var(--pd-base);
  box-sizing: border-box;
  background: var(--bg-page);
}

.tracks-popup-list {
  flex: 1;
  height: calc(78vh - 122rpx - env(safe-area-inset-bottom));
  min-height: 0;
}

.tracks-popup-list-content {
  min-height: 100%;
}

.tracks-popup-card {
  width: 100%;
  margin-bottom: 40rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--bg-muted);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-xl);
}

.tracks-popup-card:active {
  opacity: 0.9;
}

.tracks-popup-skeleton {
  pointer-events: none;
}

.tracks-popup-skeleton-main {
  padding: var(--pd-lg) var(--pd-base);
  background: var(--bg-card);
  border-bottom: 2rpx solid var(--border-color);
  border-radius: 28rpx;
}

.tracks-popup-skeleton-header,
.tracks-popup-skeleton-footer,
.tracks-popup-skeleton-author {
  display: flex;
  align-items: center;
}

.tracks-popup-skeleton-header,
.tracks-popup-skeleton-footer {
  justify-content: space-between;
}

.tracks-skeleton-block {
  background: linear-gradient(
    90deg,
    var(--bg-placeholder) 25%,
    var(--bg-muted) 37%,
    var(--bg-placeholder) 63%
  );
  background-size: 400% 100%;
  animation: tracks-skeleton-shimmer 1.4s ease-in-out infinite;
}

.tracks-skeleton-title {
  width: 42%;
  height: 36rpx;
  border-radius: 10rpx;
}

.tracks-skeleton-more {
  width: 22%;
  height: 28rpx;
  border-radius: 10rpx;
}

.tracks-skeleton-desc {
  width: 76%;
  height: 26rpx;
  margin-top: 24rpx;
  border-radius: 8rpx;
}

.tracks-skeleton-desc--short {
  width: 54%;
  margin-top: 18rpx;
}

.tracks-popup-skeleton-videos {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22rpx;
  margin-top: 34rpx;
}

.tracks-popup-skeleton-video {
  min-width: 0;
}

.tracks-skeleton-cover {
  width: 100%;
  height: 260rpx;
  border-radius: 14rpx;
}

.tracks-popup-skeleton-author {
  gap: 8rpx;
  margin-top: 16rpx;
}

.tracks-skeleton-avatar {
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

.tracks-skeleton-author-name {
  width: 70%;
  height: 22rpx;
  border-radius: 8rpx;
}

.tracks-popup-skeleton-footer {
  gap: 20rpx;
  padding: 28rpx;
  background: var(--bg-muted);
}

.tracks-skeleton-rule {
  width: 34%;
  height: 28rpx;
  border-radius: var(--radius-full);
}

.tracks-skeleton-status {
  width: 180rpx;
  height: 62rpx;
  border-radius: var(--radius-full);
}

@keyframes tracks-skeleton-shimmer {
  0% {
    background-position: 100% 0;
  }

  100% {
    background-position: 0 0;
  }
}

.tracks-popup-card-main {
  padding: var(--pd-lg) var(--pd-base);
  background: var(--bg-card);
  border-bottom: 2rpx solid var(--border-color);
  border-radius: var(--radius-xl);
}

.tracks-popup-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.tracks-popup-card-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-32);
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tracks-popup-more {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  color: var(--text-muted);
  font-size: var(--fs-24);
}

.tracks-popup-card-desc {
  margin-top: 24rpx;
  font-size: var(--fs-24);
  line-height: 1.55;
  color: var(--text-secondary);
}

.tracks-popup-video-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22rpx;
  margin-top: 34rpx;
}

.tracks-popup-video-item {
  min-width: 0;
}

.tracks-popup-cover-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  overflow: hidden;
  border-radius: var(--radius-md);
  background: var(--text-muted);
}

.tracks-popup-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.tracks-popup-play {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
}

.tracks-popup-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  min-width: 0;
}

.tracks-popup-avatar {
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

.tracks-popup-author-name {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--fs-24);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tracks-popup-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: var(--pd-base);
  background: var(--bg-muted);
}

.tracks-popup-rule {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tracks-popup-status {
  flex-shrink: 0;
  padding: var(--pd-sm) var(--pd-lg);
  border-radius: var(--radius-full);
  color: var(--text-primary);
  font-size: var(--fs-24);
  background: var(--text-muted);
}

.tracks-popup-status.active {
  background: var(--gradient-primary);
  border: 0;
  color: var(--text-white);
}

.info {
  display: flex;
  height: 90vh;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}
