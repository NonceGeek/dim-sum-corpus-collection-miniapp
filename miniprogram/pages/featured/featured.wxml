<view class="container theme-{{currentTheme}}">

  <block wx:if="{{topTracks.length > 0}}">
    <!-- 顶部Banner -->
    <view class="top-banner">
      <view class="banner-danmaku-track">
        <view class="banner-danmaku-list">
          <text class="banner-title-text">
            <text class="banner-danmaku-text">{{bannerTitle}}</text>
          </text>
          <text class="banner-subtitle-text">
            <text class="banner-danmaku-text">{{bannerSubtitle}}</text>
          </text>
        </view>
      </view>

      <view class="banner-desc">
        <view class="banner-desc-text {{descAnimClass}}">
          {{descTexts[descIndex]}}
        </view>
      </view>
    </view>

    <!-- 赛道卡片轮播 -->
    <swiper class="card-swiper" current="{{currentIndex}}" bindchange="onContentSwiperChange" indicator-dots="{{false}}"
      autoplay="{{false}}" circular="{{true}}">
      <block wx:for="{{topTracks}}" wx:key="index" wx:for-item="track">
        <swiper-item>
          <view class="main-card">
            <view class="card-header">
              <view>
                <view class="card-title">{{track.displayTitleFull}}</view>
                <view class="card-en">活动时间：{{track.startsAt}} - {{track.endsAt}}</view>
                <view class="card-desc">{{track.displayDescription}}</view>
                <view class="media-req-slot" wx:if="{{track.hasMediaReq}}">
                  <view class="media-req-row">
                    <view class="media-requirement-item" wx:if="{{track.requiresImage}}">
                      <t-icon name="image" size="30rpx" color="#8b949e" t-class="media-requirement-icon" />
                      <text>图片</text>
                    </view>
                    <view class="media-requirement-item" wx:if="{{track.requiresVideo}}">
                      <t-icon name="video" size="30rpx" color="#8b949e" t-class="media-requirement-icon" />
                      <text>视频</text>
                    </view>
                    <view class="media-requirement-item" wx:if="{{track.requiresAudio}}">
                      <t-icon name="microphone" size="30rpx" color="#8b949e" t-class="media-requirement-icon" />
                      <text>音频</text>
                    </view>
                  </view>
                </view>
              </view>

            </view>

            <!-- 视频列表 -->
            <block wx:if="{{track.works.length > 0}}">
              <scroll-view class="video-scroll" scroll-x="true" show-scrollbar="false">
                <view class="video-list">
                  <view class="video-item" wx:for="{{track.works}}" wx:key="idx" wx:for-item="item">
                    <view class="video-cover-wrapper">
                      <image class="video-cover" src="{{item.coverUrl}}" mode="aspectFill" />
                    </view>
                    <view class="author-row">
                      <image class="avatar" src="{{item.author.avatar}}" mode="aspectFill" />
                      <text class="author-name">{{item.author.name}}</text>
                    </view>
                  </view>
                </view>
              </scroll-view>
            </block>
            <block wx:else>
              <view class="empty-work-stage {{index === currentIndex ? 'is-active' : ''}}">
                <image class="empty-work-image" src="{{track.bannerUrl ? track.bannerUrl :'/public/image/yue.jpg'}}"
                  mode="aspectFill" />
                <view class="firework-layer">
                  <view class="firework firework-1"></view>
                  <view class="firework firework-2"></view>
                  <view class="firework firework-3"></view>
                  <view class="firework firework-4"></view>
                  <view class="firework firework-5"></view>
                  <view class="firework firework-6"></view>
                  <view class="firework firework-7"></view>
                  <view class="firework firework-8"></view>
                </view>
              </view>
            </block>

            <!-- 按钮 -->
            <view class="btn-row">
              <t-button theme="default" shape="round" size="large" data-id="{{track.id}}"
                wx:if="{{track.timeStatus === 'not_started'}}" hover-class="none">
                敬请期待
              </t-button>
              <t-button theme="default" shape="round" size="large" bind:tap="onMorePosts" data-id="{{track.id}}"
                wx:if="{{track.works.length > 0}}" hover-class="none">
                更多参赛作品
              </t-button>
              <t-button theme="primary" shape="round" size="large" class="post-btn {{!track.canSubmit?'unactive':''}}"
                bind:tap="onPost" data-id="{{track.id}}" wx:if="{{track.canSubmit}}" disabled="{{!track.canSubmit}}"
                hover-class="none">
                投稿此活动
              </t-button>
            </view>

            <!-- 底部小箭头 -->
            <view class="arrow-bottom"></view>
          </view>
        </swiper-item>
      </block>
    </swiper>

    <!-- 底部tab -->
    <view class="tab-container">
      <view class="tab-list">
        <view wx:for="{{visibleTabs}}" wx:key="_position" wx:for-item="item"
          class="tab-item {{item._position === 'current' ? 'active' : ''}}" bindtap="onTabTap"
          data-position="{{item._position}}">
          <view class="tab-title">
            {{item.displayTitle}}
          </view>
          <view class="tab-sub" wx:if="{{item._position === 'current' && item.submissionCount > 0}}">
            {{item.submissionCount}}个作品已参赛
          </view>
        </view>
      </view>
    </view>

    <!-- 底部功能按钮 -->
    <view class="bottom-actions">
      <t-button theme="default" shape="round" size="large" block t-class="bottom-btn" hover-class="none" bind:tap="onMyWorks">
        我的参赛作品
      </t-button>

      <t-button theme="default" shape="round" size="large" block t-class="bottom-btn" hover-class="none" bind:tap="onAllTracks">
        查看全部活动
      </t-button>
    </view>
  </block>
  <block wx:else>
    <view class="info">
      <text>目前暂无活动</text>
    </view>
  </block>
  <t-popup visible="{{allTracksPopupVisible}}" placement="bottom" t-class="tracks-popup-host theme-{{currentTheme}}"
    bind:visible-change="onAllTracksPopupChange">
    <view class="tracks-popup theme-{{currentTheme}}">
      <view class="tracks-popup-handle"></view>

      <scroll-view class="tracks-popup-list" scroll-y="{{true}}" bindscrolltolower="onTracksScrollToLower"
        lower-threshold="80">
        <view class="tracks-popup-list-content">
          <view wx:for="{{allTracks}}" wx:key="id" wx:for-item="track" class="tracks-popup-card">
            <view class="tracks-popup-card-main">
              <view class="tracks-popup-card-header">
                <view class="tracks-popup-card-title">{{track.displayTitleFull}}</view>
                <view class="tracks-popup-more" bind:tap="onMorePosts" data-id="{{track.id}}">
                  <text>更多作品</text>
                  <t-icon name="chevron-right" size="32rpx" color="var(--text-muted)" />
                </view>
              </view>
              <view class="tracks-popup-card-desc">活动时间：{{track.startsAt}} - {{track.endsAt}}</view>
              <view class="tracks-popup-card-desc">{{track.displayDescriptionFull}}</view>

              <view class="tracks-popup-video-list">
                <view class="tracks-popup-video-item" wx:for="{{track.works}}" wx:key="index" wx:for-item="video">
                  <view class="tracks-popup-cover-wrap">
                    <image class="tracks-popup-cover" src="{{video.coverUrl}}" mode="aspectFill" />
                  </view>
                  <view class="tracks-popup-author">
                    <image class="avatar" src="{{video.author.avatar}}" mode="aspectFill" />
                    <text class="author-name">{{video.author.name}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view class="tracks-popup-card-footer">
              <view class="tracks-popup-rule" wx:if="{{track.hasMediaReq}}">
                <view class="media-requirement-item" wx:if="{{track.requiresImage}}">
                  <t-icon name="image" size="30rpx" color="#8b949e" t-class="media-requirement-icon" />
                  <text>图片</text>
                </view>
                <view class="media-requirement-item" wx:if="{{track.requiresVideo}}">
                  <t-icon name="video" size="30rpx" color="#8b949e" t-class="media-requirement-icon" />
                  <text>视频</text>
                </view>
                <view class="media-requirement-item" wx:if="{{track.requiresAudio}}">
                  <t-icon name="microphone" size="30rpx" color="#8b949e" t-class="media-requirement-icon" />
                  <text>音频</text>
                </view>
              </view>
              <view class="tracks-popup-status {{track.timeStatus === 'ongoing' ? 'active' : ''}}"
                data-id="{{track.id}}" data-timeStatus="{{track.timeStatus}}" bind:tap="onClickTrack">
                {{track.timeStatus === 'not_started' ? "投稿还未开始": track.timeStatus === 'ongoing' ? "正在进行中": track.timeStatus === 'ended' ? "投稿已截止": ''}}
              </view>
            </view>
          </view>

          <block wx:if="{{allTracksLoading}}">
            <view
              wx:for="{{allTracksSkeletons}}"
              wx:key="*this"
              class="tracks-popup-card tracks-popup-skeleton"
            >
              <view class="tracks-popup-skeleton-main">
                <view class="tracks-popup-skeleton-header">
                  <view class="tracks-skeleton-block tracks-skeleton-title"></view>
                  <view class="tracks-skeleton-block tracks-skeleton-more"></view>
                </view>
                <view class="tracks-skeleton-block tracks-skeleton-desc"></view>
                <view class="tracks-skeleton-block tracks-skeleton-desc tracks-skeleton-desc--short"></view>

                <view class="tracks-popup-skeleton-videos">
                  <view class="tracks-popup-skeleton-video" wx:for="{{[0, 1, 2]}}" wx:key="*this">
                    <view class="tracks-skeleton-block tracks-skeleton-cover"></view>
                    <view class="tracks-popup-skeleton-author">
                      <view class="tracks-skeleton-block tracks-skeleton-avatar"></view>
                      <view class="tracks-skeleton-block tracks-skeleton-author-name"></view>
                    </view>
                  </view>
                </view>
              </view>

              <view class="tracks-popup-skeleton-footer">
                <view class="tracks-skeleton-block tracks-skeleton-rule"></view>
                <view class="tracks-skeleton-block tracks-skeleton-status"></view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>
  </t-popup>

  <app-tab-bar value="featured" />
</view>
<join-consent-popup
  visible="{{joinConsentPopupVisible}}"
  activity-id="{{joinConsentActivityId}}"
  current-theme="{{currentTheme}}"
  bind:close="onJoinConsentClose"
  bind:complete="onJoinConsentComplete"
/>
<common-dialog id="login-prompt" />
<common-dialog id="common-dialog" />
