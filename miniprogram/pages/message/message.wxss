/* message.wxss */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx;
  box-sizing: border-box;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.message-card.unread {
  border-left: 6rpx solid var(--primary);
}

.message-card.read {
  border-left: 6rpx solid var(--border-color);
  opacity: 0.8;
}

.message-skeleton-card {
  border-left: 6rpx solid var(--border-color);
  pointer-events: none;
}

.message-skeleton-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.message-skeleton-block {
  background: linear-gradient(
    90deg,
    var(--bg-placeholder) 25%,
    var(--bg-muted) 37%,
    var(--bg-placeholder) 63%
  );
  background-size: 400% 100%;
  animation: message-skeleton-shimmer 1.4s ease-in-out infinite;
}

.message-skeleton-icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

.message-skeleton-title {
  width: 42%;
  height: 30rpx;
  margin-left: 18rpx;
  border-radius: 8rpx;
}

.message-skeleton-dot {
  width: 16rpx;
  height: 16rpx;
  margin-left: 12rpx;
  border-radius: 50%;
}

.message-skeleton-content {
  width: 92%;
  height: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
}

.message-skeleton-content--short {
  width: 64%;
}

.message-skeleton-time {
  width: 26%;
  height: 22rpx;
  margin: 24rpx 0 0 auto;
  border-radius: 8rpx;
}

@keyframes message-skeleton-shimmer {
  0% {
    background-position: 100% 0;
  }

  100% {
    background-position: 0 0;
  }
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  flex: 1;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-left: 10rpx;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--danger);
  margin-left: 12rpx;
}

.card-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.card-time {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: right;
}
.list-footer {
  padding: 32rpx 0 48rpx;

  text-align: center;
}

.footer-text {
  font-size: 24rpx;

  color: var(--text-muted);
}

.empty-status {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

.post-actions {
  position: fixed;
  bottom: 150rpx;
  left: 0;
  right: 0;
  z-index: 100;
  text-align: center;
}

.bottom-btn {
  background: var(--gradient-primary) !important;
  border: none !important;
  color: var(--text-white) !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
  margin-right: 24rpx;
}

.bottom-btn .t-button__text {
  font-size: 16rpx !important;
}

.t-button--default::after {
  border: none !important;
}
