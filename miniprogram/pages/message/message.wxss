/* message.wxss */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx;
  box-sizing: border-box;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.message-card.unread {
  border-left: 6rpx solid var(--primary);
}

.message-card.read {
  border-left: 6rpx solid var(--border-color);
  opacity: 0.8;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  flex: 1;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--danger);
  margin-left: 12rpx;
}

.card-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.card-time {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: right;
}