/* message.wxss */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx;
  box-sizing: border-box;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.message-card.unread {
  border-left: 6rpx solid var(--primary);
}

.message-card.read {
  border-left: 6rpx solid var(--border-color);
  opacity: 0.8;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  flex: 1;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-left: 10rpx;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--danger);
  margin-left: 12rpx;
}

.card-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.card-time {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: right;
}
.list-footer {
  padding: 32rpx 0 48rpx;

  text-align: center;
}

.footer-text {
  font-size: 24rpx;

  color: var(--text-muted);
}

.empty-status {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

.post-actions {
  position: fixed;
  bottom: 150rpx;
  left: 0;
  right: 0;
  z-index: 100;
  text-align: center;
}

.bottom-btn {
  background: var(--gradient-primary) !important;
  border: none !important;
  color: var(--text-white) !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
  margin-right: 24rpx;
}

.bottom-btn .t-button__text {
  font-size: 16rpx !important;
}

.t-button--default::after {
  border: none !important;
}
