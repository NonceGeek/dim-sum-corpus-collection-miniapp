<view class="page theme-{{currentTheme}}">
  <!-- 首次加载骨架 -->
  <view wx:if="{{isInitialLoading}}" class="message-list">
    <view wx:for="{{initialSkeletons}}" wx:key="*this" class="message-card message-skeleton-card">
      <view class="message-skeleton-header">
        <view class="message-skeleton-block message-skeleton-icon"></view>
        <view class="message-skeleton-block message-skeleton-title"></view>
        <view class="message-skeleton-block message-skeleton-dot"></view>
      </view>
      <view class="message-skeleton-block message-skeleton-content"></view>
      <view class="message-skeleton-block message-skeleton-content message-skeleton-content--short"></view>
      <view class="message-skeleton-block message-skeleton-time"></view>
    </view>
  </view>

  <!-- 无消息时 -->
  <view wx:elif="{{messages.length === 0}}" class="empty-status">
    <t-empty icon="chat" description="暂无消息" />
  </view>

  <!-- 消息列表 -->
  <view wx:else class="message-list">
    <view wx:for="{{messages}}" wx:key="id" class="message-card {{item.isRead ? 'read' : 'unread'}}"
      bind:tap="onMessageTap" data-id="{{item.id}}" data-workId="{{item.workId}}" data-type="{{item.type}}">
      <view class="card-header">
        <t-icon name="{{item.icon}}" size="32rpx" color="{{item.color}}"/>
        <view class="card-title-row">
          <text class="card-title">{{item.title}}</text>
          <view wx:if="{{!item.isRead}}" class="unread-dot" />
        </view>
      </view>
      <view class="card-content">{{item.content}}</view>
      <view class="card-time">{{item.date}}</view>
    </view>

    <block wx:if="{{loading}}">
      <view wx:for="{{appendSkeletons}}" wx:key="*this" class="message-card message-skeleton-card">
        <view class="message-skeleton-header">
          <view class="message-skeleton-block message-skeleton-icon"></view>
          <view class="message-skeleton-block message-skeleton-title"></view>
          <view class="message-skeleton-block message-skeleton-dot"></view>
        </view>
        <view class="message-skeleton-block message-skeleton-content"></view>
        <view class="message-skeleton-block message-skeleton-content message-skeleton-content--short"></view>
        <view class="message-skeleton-block message-skeleton-time"></view>
      </view>
    </block>

    <view class="list-footer">
      <view wx:if="{{noMore}}" class="footer-text">
        没有更多了
      </view>
    </view>

    <view wx:if="{{showButton}}" class="post-actions">
      <t-button theme="default" shape="round" size="medium" block t-class="bottom-btn" hover-class="none" bind:tap="onReadAll">
        将所有消息标记为已读
      </t-button>

    </view>
  </view>

</view>
<common-dialog id="common-dialog" />
