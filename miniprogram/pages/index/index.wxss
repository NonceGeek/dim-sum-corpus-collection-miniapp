.page {
  background-color: var(--bg-page);
  color: var(--text-primary);
  width: 100%;
  min-height: 100vh;
  padding-bottom: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 轮播图 - 顶格 */
.swiper-wrapper {
  width: 100%;
  background-color: var(--bg-page);
}

.swiper-wrapper .t-swiper,
.swiper-wrapper .t-image,
.swiper-wrapper image {
  width: 100%;
}

.t-swiper-host {
  border-radius: 0 !important;
}

/* 卡片列表 - 瀑布流 */
.card-list {
  padding: 0 24rpx;
}

/* 加载状态 */
.loading-tip {
  text-align: center;
  padding: 32rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

.load-more-trigger {
  width: 100%;
  height: 1rpx;
}

/* ============================================
   深色模式
   ============================================ */
.theme-dark .btn-type.t-button--primary {
  background: var(--gradient-primary) !important;
  box-shadow: var(--shadow-primary) !important;
}

.theme-dark .btn-type.t-button--default {
  background-color: var(--bg-input) !important;
  border-color: var(--border-color) !important;
  color: var(--text-primary) !important;
}

.theme-dark .btn-type.t-button--default:active {
  background-color: var(--border-color) !important;
}

.theme-dark .card-item {
  background-color: var(--bg-card);
  border-color: var(--border-color);
}

.theme-dark .btn-group-scroll {
  background-color: var(--bg-card);
  border-bottom-color: var(--border-color);
}

/* 深色模式瀑布流 */
.theme-dark .card-list {
  column-gap: 24rpx;
}
