.page {
  background-color: var(--bg-page);
  color: var(--text-primary);
  width: 100%;
  min-height: 100vh;
  padding-bottom: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 轮播图 - 顶格 */
.swiper-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
  background-color: var(--bg-page);
}

.swiper-wrapper .t-swiper,
.swiper-wrapper .t-image,
.swiper-wrapper image {
  width: 100%;
}

.t-swiper-host {
  border-radius: 0 !important;
}

.banner-glass {
  position: absolute;
  bottom: 48rpx;
  left: 16rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: fit-content;
  max-width: calc(100% - 32rpx);
  padding: var(--pd-base) var(--pd-lg);
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 18rpx;
  background: rgba(30, 30, 30, 0.22);
  -webkit-backdrop-filter: blur(24rpx) saturate(110%);
  backdrop-filter: blur(24rpx) saturate(110%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.14),
    0 10rpx 28rpx rgba(0, 0, 0, 0.18);
  pointer-events: none;
}

.banner-glass-title {
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  color: #ffffff;
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  white-space: nowrap;
}

.banner-glass-title text,
.banner-glass-time text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-activity-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  max-width: 100%;
  padding: 0 var(--pd-base);
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--radius-full);
  background: var(--gradient-accent);
  box-shadow: 0 0 22rpx rgba(124, 92, 255, 0.42);
  color: #ffffff;
  font-size: var(--fs-24);
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.banner-activity-tag + .banner-glass-title {
  margin-top: 20rpx;
}

.banner-glass-time {
  max-width: 100%;
  margin-top: 12rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.86);
  font-size: var(--fs-24);
  line-height: 1.4;
}

/* 卡片列表 - 瀑布流 */
.card-list {
  padding: 0 var(--pd-base);
}

/* 加载状态 */
.loading-tip {
  text-align: center;
  padding: 32rpx;
  color: var(--text-muted);
  font-size: var(--fs-24);
}

.load-more-trigger {
  width: 100%;
  height: 1rpx;
}

/* ============================================
   深色模式
   ============================================ */
.theme-dark .btn-type.t-button--primary {
  background: var(--gradient-primary) !important;
  box-shadow: var(--shadow-primary) !important;
}

.theme-dark .btn-type.t-button--default {
  background-color: var(--bg-input) !important;
  border-color: var(--border-color) !important;
  color: var(--text-primary) !important;
}

.theme-dark .btn-type.t-button--default:active {
  background-color: var(--border-color) !important;
}

.theme-dark .card-item {
  background-color: var(--bg-card);
  border-color: var(--border-color);
}

.theme-dark .btn-group-scroll {
  background-color: var(--bg-card);
  border-bottom-color: var(--border-color);
}

/* 深色模式瀑布流 */
.theme-dark .card-list {
  column-gap: 24rpx;
}
