<view class="container theme-{{currentTheme}}">
  <view class="page">
    <!-- 轮播图 - 顶格 -->
    <view class="swiper-wrapper">
      <t-swiper current="{{current}}" autoplay="{{autoplay}}" duration="{{duration}}" interval="{{interval}}"
        list="{{swiperList}}" image-props="{{bannerImageProps}}" navigation="{{ { type: 'dots-bar' } }}" height="{{swiperHeight}}"
        bind:change="onSwiperChange" bind:click="onClickToTrack"/>
      <view class="banner-glass" wx:if="{{swiperList.length}}">
        <view class="banner-activity-tag" wx:if="{{swiperList[current].activityTag}}">
          <text>{{swiperList[current].activityTag}}</text>
        </view>
        <view class="banner-glass-title" style="font-size: {{swiperList[current].titleFontSize}}rpx;">
          <text>{{swiperList[current].title}}</text>
        </view>
        <view class="banner-glass-time" wx:if="{{swiperList[current].startsAt && swiperList[current].endsAt}}">
          <text>{{swiperList[current].startsAt}} - {{swiperList[current].endsAt}}</text>
        </view>
      </view>
    </view>

    <!-- 卡片列表 -->
    <view class="card-list">
      <waterfall
        items="{{cardList}}"
        loading="{{isInitialCardLoading}}"
        bind:itemtap="onWaterfallTap"
      />
    </view>

    <!-- 加载更多 -->
    <view class="loading-tip" wx:if="{{loading && !isInitialCardLoading}}">
      <text>加载中...</text>
    </view>
    <view class="loading-tip" wx:elif="{{noMore}}">
      <text>没有更多了</text>
    </view>
    <view class="load-more-trigger"></view>
  </view>

  <!-- Tab Bar -->
  <app-tab-bar value="home" />
</view>
<common-dialog id="login-prompt" />
