.upload-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  color: var(--text-primary);
}

.upload-content {
  padding: 24rpx 32rpx;
  padding-bottom: 150rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* TDesign Navbar 样式覆盖 */
.upload-page .t-navbar {
  background-color: var(--bg-card);
}

.upload-page .custom-navbar-title {
  font-size: 28rpx;
  color: var(--text-primary);
}

.upload-page .t-navbar__left-arrow {
  font-size: 20px;
}

/* 顶部导航栏 */
.upload-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
  border-bottom: 1px solid var(--border-light);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-btn {
  min-width: 120rpx;
}

.cancel-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.publish-btn {
  min-width: 120rpx;
}

/* 投稿类型选择 */
.type-section {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-color);
}

.type-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.type-picker-wrapper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.type-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.type-value.placeholder {
  color: var(--text-muted);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-upload-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.image-item {
  width: 216rpx;
  height: 216rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
  background-color: var(--bg-input);
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--border-color);
  background-color: var(--bg-input);
}

.add-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
}

.add-count {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* 输入区域 */
.input-section {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 1px solid var(--border-color);
}

.title-input {
  font-size: 32rpx;
  border-radius: var(--radius-md);
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  padding: 0 16rpx;
}

/* 控制 t-input 高度为 100rpx */
.title-input.t-input {
  --td-input-vertical-padding: 0 !important;
  padding: 0rpx 32rpx !important;
  height: 100rpx !important;
  max-height: 100rpx !important;
}
.title-input .t-input__wrap {
  height: 100rpx !important;
  align-items: center !important;
}

.input-placeholder {
  color: var(--text-muted);
}

.content-section {
  position: relative;
}

.content-textarea {
  font-size: 32rpx;
  min-height: 300rpx;
  border-radius: var(--radius-lg);
  padding-left: 12rpx !important;
  padding-top: 12rpx !important;
}

.word-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

.textarea-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}

.audio-section {
  display: flex;
  gap: 12rpx;
}
.mic-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 录音播放组件 */
.audio-player {
  width: fit-content;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  background-color: var(--bg-input);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color);
}

.audio-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.audio-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.audio-duration {
  font-size: 24rpx;
  color: var(--text-muted);
}

.audio-delete {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 话题区域 */
.topic-section {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 1px solid var(--border-color);
}

.topic-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.topic-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background-color: rgba(74, 124, 243, 0.1);
  border-radius: var(--radius-full);
  gap: 8rpx;
}

.topic-text {
  font-size: 26rpx;
  color: var(--primary);
}

.topic-close {
  color: var(--primary);
}

.add-topic {
  background-color: var(--bg-input);
  border: 1px solid var(--border-color);
}

.add-topic .topic-text {
  color: var(--text-secondary);
}

/* 话题弹窗样式 */
.topic-popup {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.topic-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.topic-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.topic-popup-close {
  width: fit-content;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-light);
}

.topic-search {
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.custom-topic-row {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background-color: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.custom-topic-label {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.custom-topic-text {
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topic-list-popup {
  flex: 1;
  height: 500rpx;
  overflow-y: auto;
  padding: 8rpx 0;
}

.topic-item-popup {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.topic-item-selected {
  background-color: var(--bg-input);
}

.topic-item-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.activity-item-content {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.activity-item-description {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.4;
}

.loading-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 底部按钮样式 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
  border-top: 1px solid var(--border-color);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.btn-submit {
  width: 100%;
  max-width: 600rpx;
}

.btn-submit-inner {
  background: var(--gradient-primary) !important;
  box-shadow: var(--shadow-primary) !important;
}

/* 录音弹窗 */
.record-popup {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 48rpx 32rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-hint {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-bottom: 48rpx;
}

/* 录音按钮区域：相对定位容器，侧边按钮绝对浮出 */
.record-btn-area {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 上方留出侧边按钮飞出所需的空间 */
  padding-top: 160rpx;
}

/* 左右侧按钮公共样式：默认隐藏在录音按钮正后方 */
.record-side-btn {
  position: absolute;
  bottom: 50%;

  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: row;

  gap: 10rpx;

  height: 72rpx;
  padding: 0 28rpx;

  border-radius: 999rpx;

  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow:
    0 8rpx 24rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);

  opacity: 0;
  pointer-events: none;
  /* 初始位置：居中，无旋转 */
  transform: translate(-50%, 0) rotate(0deg);

  z-index: 10;
}

.record-side-text {
  font-size: 24rpx;
  line-height: 1;
  white-space: nowrap;
  color: var(--text-secondary);
}

/* 取消按钮：从中心先上升，再向左飞出并左倾 */
.record-cancel {
  left: 50%;
  transform-origin: bottom center;
}
.record-cancel.visible {
  opacity: 1;
  pointer-events: auto;
  transform: translate(calc(-100% - 72rpx), -70rpx) rotate(-12deg);
}

.theme-dark .record-cancel .t-icon {
  color: var(--text-muted) !important;
}
.theme-dark .record-cancel.hover .t-icon {
  color: #fff !important;
}
.record-btn-area.actions-entering .record-cancel.visible {
  animation: appear-left 0.7s ease-out forwards;
}

@keyframes appear-left {
  0% {
    opacity: 0;
    transform: translate(-50%, 0) rotate(0deg);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -60rpx) rotate(0deg);
  }
  100% {
    opacity: 1;
    transform: translate(calc(-100% - 72rpx), -70rpx) rotate(-12deg);
  }
}

/* 转文字按钮：从中心先上升，再向右飞出并右倾 */
.record-asr {
  left: 50%;
  transform-origin: bottom center;
}
.record-asr.visible {
  opacity: 1;
  pointer-events: auto;
  transform: translate(72rpx, -70rpx) rotate(12deg);
}
.record-btn-area.actions-entering .record-asr.visible {
  animation: appear-right 0.7s ease-out forwards;
}
.record-asr .record-side-text {
  color: var(--primary);
}

.theme-dark .record-asr .t-icon {
  color: #6b93f5 !important;
}

.theme-dark .record-asr.hover .t-icon {
  color: #fff !important;
}

@keyframes appear-right {
  0% {
    opacity: 0;
    transform: translate(-50%, 0) rotate(0deg);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -60rpx) rotate(0deg);
  }
  100% {
    opacity: 1;
    transform: translate(72rpx, -70rpx) rotate(12deg);
  }
}

.record-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--bg-input);
  border: 4rpx solid var(--primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.2s;
}

.record-btn.recording {
  background-color: var(--primary);
  border-color: var(--primary);
}

.record-btn-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.record-btn.recording .record-btn-text {
  color: #fff;
}

.record-timer {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}

.record-btn.recording .record-timer {
  color: #fff;
}

/* 侧边按钮悬停高亮 */
.record-side-btn.hover {
  background: var(--primary);
  border-color: var(--primary);
  transform: translate(-50%, 0) rotate(0deg) scale(1.08);
}
.record-cancel.hover {
  animation: none;
  transform: translate(calc(-100% - 72rpx), -70rpx) rotate(-12deg) scale(1.08);
}
.record-asr.hover {
  animation: none;
  transform: translate(72rpx, -70rpx) rotate(12deg) scale(1.08);
}
.record-side-btn.hover .record-side-text {
  color: #fff;
}

/* ============================================
   转文字结果弹窗
   ============================================ */
.asr-popup {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 32rpx 64rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.asr-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
}

.asr-textarea {
  min-height: 280rpx;
  background: var(--bg-input);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx !important;
  font-size: 30rpx;
  line-height: 1.6;
  border: 1px solid var(--border-color);
}

.asr-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.asr-btn {
  flex: 1;
}

.asr-btn-confirm {
  background: var(--gradient-primary) !important;
  border: none !important;
  box-shadow: var(--shadow-primary) !important;
}

/* swiper 外层 */
.view-swiper-wrap {
  padding: 24rpx;
  box-sizing: border-box;
}

/* swiper */
.view-swiper {
  width: 100%;
  height: 520rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #000;
}

/* 媒体 */
.view-media {
  width: 100%;
  height: 100%;
  display: block;
  background: #000;
}

/* 内容区 */
.view-content {
  padding: 0 24rpx 140rpx;
  box-sizing: border-box;
}

/* 标题 */
.view-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.5;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 正文 */
.view-body {
  margin-top: 24rpx;
}

.view-body-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* meta */
.view-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.view-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(74, 124, 243, 0.08);
}

.view-meta-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 标签 */
.view-tags {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(74, 124, 243, 0.12);
}

.topic-text {
  font-size: 24rpx;
  color: #4a7cf3;
}

/* 底部栏 */
.view-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: var(--bg-primary);
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: space-between;
}

.view-footer-action {
  height: 88rpx;
  border-radius: 999rpx;
  background: var(--card-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.view-footer-text {
  font-size: 28rpx;
  font-weight: 600;
}

/* popup */
.post-actions-popup {
  padding: 24rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: var(--bg-primary);
  box-sizing: border-box;
}

/* 横向区域 */
.post-actions-row {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 24rpx;
}

/* 单个按钮 */
.post-action-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  width: 160rpx;
}

/* icon 外层 */
.post-action-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  background: rgba(0, 0, 0, 0.05);

  display: flex;
  align-items: center;
  justify-content: center;
}

/* 删除按钮 icon */
.danger-icon {
  background: rgba(246, 36, 89, 0.1);
}

/* 文字 */
.post-action-label {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* 删除文字 */
.danger-text {
  color: #f62459;
}

/* 取消按钮 */
.post-action-cancel {
  height: 92rpx;
  border-radius: 999rpx;
  background: var(--card-bg);

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.hot-wrap {
  display: flex;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
  margin-left: auto;
}

.hot-icon {
  width: 52rpx;
  height: 52rpx;
  color: var(--danger);
}

.t-picker-item__item.t-picker-item__item--active {
  color: #1a1f36 !important;
}

.t-icon-search.t-icon-base {
  color: var(--text-muted) !important;
}

.t-search__input-box .t-input__keyword {
  color: #1a1f36 !important;
}
