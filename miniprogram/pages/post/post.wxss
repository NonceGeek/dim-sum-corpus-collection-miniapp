.upload-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  color: var(--text-primary);
}

.upload-content {
  padding: 24rpx 32rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.upload-page .custom-navbar-title {
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.custom-navbar-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -12rpx;
}

/* 顶部导航栏 */
.upload-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
  border-bottom: 1px solid var(--border-light);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-btn {
  min-width: 120rpx;
}

.cancel-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.publish-btn {
  min-width: 120rpx;
}

/* 投稿类型选择 */
.type-section {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-color);
}

.type-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.type-picker-wrapper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.type-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.type-value.placeholder {
  color: var(--text-muted);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-upload-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.image-item {
  width: 216rpx;
  height: 216rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
  background-color: var(--bg-input);
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn {
  position: relative;
  z-index: 3;
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--border-color);
  background-color: var(--bg-input);
}

.add-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
}

.add-count {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* 输入区域 */
.input-section {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 1px solid var(--border-color);
}

.title-input {
  font-size: 32rpx;
  border-radius: var(--radius-md);
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  padding: 0 16rpx;
}

/* 控制 t-input 高度为 100rpx */
.title-input.t-input {
  --td-input-vertical-padding: 0 !important;
  padding: 0rpx 32rpx !important;
  height: 100rpx !important;
  max-height: 100rpx !important;
}
.title-input .t-input__wrap {
  height: 100rpx !important;
  align-items: center !important;
}

.input-placeholder {
  color: var(--text-muted);
}

.content-section {
  position: relative;
}

.content-textarea {
  font-size: 32rpx;
  min-height: 300rpx;
  border-radius: var(--radius-lg);
  padding-left: 8rpx !important;
  padding-top: 12rpx !important;
  background-color: var(--bg-card);
}

.word-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

.textarea-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}

.audio-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mic-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 录音播放组件 */
.audio-player {
  width: fit-content;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  background-color: var(--bg-input);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color);
}

.audio-section .audio-player {
  margin-bottom: 0;
}

.audio-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.audio-label {
  font-size: 24rpx;
  color: var(--text-primary);
}

.audio-duration {
  font-size: 22rpx;
  color: var(--text-muted);
}

.audio-delete {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 话题区域 */
.topic-section {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 1px solid var(--border-color);
}

.topic-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.topic-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background-color: rgba(74, 124, 243, 0.1);
  border-radius: var(--radius-full);
  gap: 8rpx;
}

.topic-text {
  font-size: 26rpx;
  color: var(--primary);
}

.topic-close {
  color: var(--primary);
}

.add-topic {
  background-color: var(--bg-input);
  border: 1px solid var(--border-color);
}

.add-topic .topic-text {
  color: var(--text-secondary);
}

.post-popup-host {
  background-color: var(--bg-page) !important;
}

.post-popup-host .t-popup,
.post-popup-host .t-popup__content {
  background-color: var(--bg-page) !important;
}

.post-picker-root {
  background-color: var(--bg-card) !important;
}

.post-picker-root .t-popup,
.post-picker-root .t-popup__content {
  background-color: var(--bg-card) !important;
}

.post-picker-panel {
  background-color: var(--bg-card) !important;
}

/* 话题弹窗样式 */
.topic-popup {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  max-height: 80vh;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.topic-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.topic-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.topic-popup-close {
  width: fit-content;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
}

.topic-search {
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.custom-topic-row {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background-color: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.custom-topic-label {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.custom-topic-text {
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topic-list-popup {
  flex: 1;
  height: 500rpx;
  overflow-y: auto;
  padding: 8rpx 0;
}

.topic-item-popup {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.topic-item-selected {
  background-color: var(--bg-input);
}

.topic-item-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.activity-item-content {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.activity-item-description {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.4;
}

.loading-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 底部按钮样式 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-card);
  border-top: 1px solid var(--border-color);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.btn-submit {
  width: 100%;
  max-width: 600rpx;
}

.btn-submit-inner {
  background: var(--gradient-primary) !important;
  box-shadow: var(--shadow-primary) !important;
}

.btn-submit-inner:active,
.btn-submit-inner.t-button--hover,
.btn-submit-inner.t-button--active {
  background: var(--gradient-primary) !important;
  opacity: 1 !important;
}

.btn-submit-inner.t-button--disabled {
  opacity: 0.5 !important;
  box-shadow: none !important;
}

/* 录音弹窗 */
.record-popup-host,
.record-popup-host .t-popup,
.record-popup-host .t-popup__content,
.record-popup {
  border-top-left-radius: 40rpx !important;
  border-top-right-radius: 40rpx !important;
  overflow: hidden;
}

.record-popup {
  background-color: var(--bg-card);
  padding: 48rpx 32rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-hint {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-bottom: 48rpx;
  text-align: center;
}

/* 录音按钮区域：相对定位容器，侧边按钮绝对浮出 */
.record-btn-area {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 400rpx;
  box-sizing: border-box;
  /* 上方留出侧边按钮飞出所需的空间 */
  padding-top: 216rpx;
}

/* 左右侧按钮公共样式：默认隐藏在录音按钮正后方 */
.record-side-btn {
  position: absolute;
  bottom: 50%;

  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: row;

  gap: 10rpx;

  height: 72rpx;
  padding: 0 28rpx;

  border-radius: 999rpx;

  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow:
    0 8rpx 24rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);

  opacity: 0;
  pointer-events: none;
  /* 初始位置：居中，无旋转 */
  transform: translate(-50%, 0) rotate(0deg);

  z-index: 10;
}

.record-side-text {
  font-size: 24rpx;
  line-height: 1;
  white-space: nowrap;
  color: var(--text-secondary);
}

/* 取消按钮：从中心先上升，再向左飞出并左倾 */
.record-cancel {
  left: 50%;
  transform-origin: bottom center;
}
.record-cancel.visible {
  opacity: 1;
  pointer-events: auto;
  transform: translate(calc(-100% - 72rpx), -70rpx) rotate(-12deg);
}

.theme-dark .record-cancel .t-icon {
  color: var(--text-muted) !important;
}
.theme-dark .record-cancel.hover .t-icon {
  color: var(--text-white) !important;
}
.record-btn-area.actions-entering .record-cancel.visible {
  animation: appear-left 0.7s ease-out forwards;
}

@keyframes appear-left {
  0% {
    opacity: 0;
    transform: translate(-50%, 0) rotate(0deg);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -60rpx) rotate(0deg);
  }
  100% {
    opacity: 1;
    transform: translate(calc(-100% - 72rpx), -70rpx) rotate(-12deg);
  }
}

/* 转文字按钮：从中心先上升，再向右飞出并右倾 */
.record-asr {
  left: 50%;
  transform-origin: bottom center;
}
.record-asr.visible {
  opacity: 1;
  pointer-events: auto;
  transform: translate(72rpx, -70rpx) rotate(12deg);
}
.record-btn-area.actions-entering .record-asr.visible {
  animation: appear-right 0.7s ease-out forwards;
}
.record-asr .record-side-text {
  color: var(--primary);
}

.theme-dark .record-asr .t-icon {
  color: var(--primary-light) !important;
}

.theme-dark .record-asr.hover .t-icon {
  color: var(--text-white) !important;
}

@keyframes appear-right {
  0% {
    opacity: 0;
    transform: translate(-50%, 0) rotate(0deg);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -60rpx) rotate(0deg);
  }
  100% {
    opacity: 1;
    transform: translate(72rpx, -70rpx) rotate(12deg);
  }
}

.record-btn {
  position: relative;
  z-index: 2;
  width: 240rpx;
  height: 104rpx;
  border-radius: 999rpx;
  background-color: var(--bg-input);
  border: 4rpx solid var(--primary);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.2s;
}

.record-btn.recording {
  background-color: var(--primary);
  border-color: var(--primary);
}

.record-btn.ready {
  background-color: var(--bg-input);
  border-color: var(--primary);
  box-shadow: 0 8rpx 24rpx var(--shadow-primary);
}

.record-btn.disabled {
  opacity: 0.65;
  pointer-events: none;
}

.record-btn-text {
  font-size: 32rpx;
  line-height: 1;
  color: var(--text-secondary);
}

.record-btn.idle .record-btn-text {
  width: 100%;
  text-align: center;
}

.record-btn.recording .record-btn-text {
  color: var(--text-white);
}

.record-voice-preview {
  position: absolute;
  top: 0;
  left: 50%;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: translateX(-50%);
  pointer-events: none;
}

.record-voice-bubble {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 286rpx;
  height: 112rpx;
  background: var(--primary);
  border-radius: 30rpx;
  box-shadow: var(--shadow-primary);
}

.record-voice-bubble-tail {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 24rpx;
  height: 24rpx;
  background: var(--primary);
  border-radius: 0 0 5rpx 0;
  transform: translateX(-50%) rotate(45deg);
}

.record-send-hint {
  margin-top: 32rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
  white-space: nowrap;
}

.record-waveform {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  width: 210rpx;
  height: 50rpx;
}

.record-waveform-bar {
  width: 5rpx;
  height: 42rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 999rpx;
  transform: scaleY(0.24);
  transform-origin: center;
  opacity: 0.76;
  animation: record-wave-pulse 0.9s ease-in-out infinite;
}

.record-waveform-bar:nth-child(2n) {
  animation-delay: -0.72s;
}

.record-waveform-bar:nth-child(3n) {
  animation-delay: -0.54s;
}

.record-waveform-bar:nth-child(4n) {
  animation-delay: -0.36s;
}

.record-waveform-bar:nth-child(5n) {
  animation-delay: -0.18s;
}

@keyframes record-wave-pulse {
  0%,
  100% {
    transform: scaleY(0.2);
    opacity: 0.58;
  }

  50% {
    transform: scaleY(1);
    opacity: 0.92;
  }
}

.record-btn-text-recording {
  font-size: 22rpx;
  line-height: 1;
}

.record-timer {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 600;
  white-space: nowrap;
}

.record-btn.recording .record-timer {
  color: var(--text-white);
}

@media (prefers-reduced-motion: reduce) {
  .record-waveform-bar {
    animation: none;
    opacity: 0.8;
  }

  .record-waveform-bar:nth-child(1),
  .record-waveform-bar:nth-child(5) {
    transform: scaleY(0.45);
  }

  .record-waveform-bar:nth-child(2),
  .record-waveform-bar:nth-child(4) {
    transform: scaleY(0.72);
  }

  .record-waveform-bar:nth-child(3) {
    transform: scaleY(1);
  }
}

/* 侧边按钮悬停高亮 */
.record-side-btn.hover {
  background: var(--primary);
  border-color: var(--primary);
  transform: translate(-50%, 0) rotate(0deg) scale(1.08);
}
.record-cancel.hover {
  animation: none;
  transform: translate(calc(-100% - 72rpx), -70rpx) rotate(-12deg) scale(1.08);
}
.record-asr.hover {
  animation: none;
  transform: translate(72rpx, -70rpx) rotate(12deg) scale(1.08);
}
.record-side-btn.hover .record-side-text {
  color: var(--text-white);
}

/* ============================================
   转文字结果弹窗
   ============================================ */
.asr-popup {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 32rpx 64rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.asr-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
}

.asr-textarea {
  min-height: 280rpx;
  background: var(--bg-input);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx !important;
  font-size: 30rpx;
  line-height: 1.6;
  border: 1px solid var(--border-color);
}

.asr-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.asr-btn {
  flex: 1;
}

.asr-btn-secondary {
  height: 88rpx !important;
  min-height: 88rpx !important;
  padding: 0 24rpx !important;
  overflow: hidden;
  border: 1px solid var(--border-color) !important;
  border-radius: var(--radius-full) !important;
  background-color: var(--bg-input) !important;
  color: var(--text-secondary) !important;
  font-size: 32rpx !important;
  font-weight: 500 !important;
}

.asr-btn-secondary::before {
  display: none !important;
}

.asr-btn-confirm {
  background: var(--gradient-primary) !important;
  border: none !important;
  box-shadow: var(--shadow-primary) !important;
}

/* swiper 外层 */
.view-swiper-wrap {
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

/* swiper */
.view-swiper {
  width: 100%;
  height: 520rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #000;
}

/* 媒体 */
.view-media {
  width: 100%;
  height: 100%;
  display: block;
  background: #000;
}

/* 内容区 */
.view-content {
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
}

/* 标题 */
.view-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.5;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 正文 */
.view-body {
  margin-top: 24rpx;
}

.view-body-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* meta */
.view-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.view-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(74, 124, 243, 0.08);
}

.view-meta-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 标签 */
.view-tags {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(74, 124, 243, 0.12);
}

.topic-text {
  font-size: 24rpx;
  color: var(--primary);
}

/* 底部栏 */
.view-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: var(--bg-card);
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: space-between;
}

.view-footer-action {
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.view-footer-text {
  font-size: 28rpx;
  font-weight: 600;
}

.hot-wrap {
  display: flex;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
  margin-left: auto;
}

.hot-icon {
  width: 52rpx;
  height: 52rpx;
  color: var(--danger);
}

.t-icon-search.t-icon-base {
  color: var(--text-muted) !important;
}

.t-search__input-box .t-input__keyword {
  color: var(--text-on-light) !important;
}
