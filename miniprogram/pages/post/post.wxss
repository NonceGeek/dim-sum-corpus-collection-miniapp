.upload-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  color: var(--text-primary);
}

.upload-page--edit {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.upload-content {
  box-sizing: border-box;
}

.upload-content-inner {
  padding: var(--pd-base);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.upload-page--edit .upload-content {
  flex: 1;
  height: 0;
  min-height: 0;
}

.upload-page--edit .upload-content-inner > view,
.upload-page--edit .upload-content-inner > t-input {
  flex-shrink: 0;
}

.upload-page .custom-navbar-title {
  font-size: var(--fs-24);
  line-height: 52rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.custom-navbar-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -12rpx;
}

/* 顶部导航栏 */
.upload-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
  border-bottom: 1px solid var(--border-light);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-btn {
  min-width: 120rpx;
}

.cancel-text {
  font-size: var(--fs-28);
  color: var(--text-secondary);
}

.header-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
}

.publish-btn {
  min-width: 120rpx;
}

/* 投稿类型选择 */
.type-section {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--pd-base);
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-color);
}

.type-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--fs-28);
  color: var(--text-primary);
  font-weight: 500;
}

.type-picker-wrapper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.type-value {
  font-size: var(--fs-28);
  color: var(--text-primary);
}

.type-value.placeholder {
  color: var(--text-muted);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-upload-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: var(--fs-24);
  line-height: 1.5;
  color: var(--text-secondary);
}

.image-item {
  width: 216rpx;
  height: 216rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  background-color: var(--bg-input);
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn {
  position: relative;
  z-index: 3;
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--border-color);
  background-color: var(--bg-input);
}

.add-tip {
  font-size: var(--fs-24);
  color: var(--text-muted);
  margin-top: 12rpx;
}

.add-count {
  font-size: var(--fs-24);
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* 输入区域 */
.input-section {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--pd-base);
  border: 1px solid var(--border-color);
}

.title-input {
  font-size: var(--fs-32);
  width: 100%;
  min-height: 52rpx;
  padding: 0 !important;
}

.title-section {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.input-placeholder {
  color: var(--text-muted);
}

.content-section {
  position: relative;
}

.content-textarea {
  font-size: var(--fs-32);
  min-height: 300rpx;
  border-radius: var(--radius-lg);
  padding-left: 8rpx !important;
  padding-top: 12rpx !important;
  background-color: var(--bg-card);
}

.word-count {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.textarea-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}

.audio-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mic-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 录音播放组件 */
.audio-player {
  width: fit-content;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  background-color: var(--bg-input);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color);
}

.audio-section .audio-player {
  margin-bottom: 0;
}

.view-audio-player {
  min-height: 80rpx;
  box-sizing: border-box;
}

.audio-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.audio-label {
  font-size: var(--fs-24);
  color: var(--text-primary);
}

.audio-duration {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.audio-delete {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 话题区域 */
.topic-section {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--pd-base);
  border: 1px solid var(--border-color);
}

.topic-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.topic-title {
  font-size: var(--fs-28);
  font-weight: 500;
  color: var(--text-primary);
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background-color: rgba(74, 124, 243, 0.1);
  border-radius: var(--radius-full);
  gap: 8rpx;
}

.topic-text {
  font-size: var(--fs-28);
  color: var(--primary);
}

.topic-close {
  color: var(--primary);
}

.add-topic {
  background-color: var(--bg-input);
  border: 1px solid var(--border-color);
}

.add-topic .topic-text {
  color: var(--text-secondary);
}

.post-popup-host {
  --td-popup-border-radius: var(--radius-2xl);
  background-color: var(--bg-page) !important;
  border-top-left-radius: var(--radius-2xl) !important;
  border-top-right-radius: var(--radius-2xl) !important;
  overflow: hidden;
}

.post-popup-host .t-popup,
.post-popup-host .t-popup__content {
  background-color: var(--bg-page) !important;
}

.post-picker-root {
  --td-popup-border-radius: var(--radius-2xl);
  --td-picker-border-radius: var(--radius-2xl);
  background-color: var(--bg-card) !important;
  border-top-left-radius: var(--radius-2xl) !important;
  border-top-right-radius: var(--radius-2xl) !important;
  overflow: hidden;
}

.post-picker-root .t-popup,
.post-picker-root .t-popup__content {
  background-color: var(--bg-card) !important;
}

.post-picker-panel {
  background-color: var(--bg-card) !important;
  border-top-left-radius: var(--radius-2xl) !important;
  border-top-right-radius: var(--radius-2xl) !important;
  overflow: hidden;
}

/* 话题弹窗样式 */
.topic-popup {
  background-color: var(--bg-card);
  border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
  max-height: 80vh;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.topic-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.topic-popup-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
}

.topic-popup-close {
  width: fit-content;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
}

.topic-search {
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.custom-topic-row {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background-color: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.custom-topic-label {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.custom-topic-text {
  min-width: 0;
  font-size: var(--fs-28);
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topic-list-popup {
  flex: 1;
  height: 500rpx;
  overflow-y: auto;
  padding: 8rpx 0;
}

.topic-list-bottom-spacer {
  height: calc(180rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.topic-item-popup {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.topic-item-selected {
  background-color: var(--bg-input);
}

.topic-item-text {
  font-size: var(--fs-28);
  color: var(--text-primary);
}

.activity-item-content {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.activity-item-description {
  font-size: var(--fs-24);
  color: var(--text-muted);
  line-height: 1.4;
}

.activity-item-title-selected {
  color: var(--primary);
  font-size: var(--fs-32);
  font-weight: 600;
}

.loading-tip {
  text-align: center;
  padding: 24rpx;
  font-size: var(--fs-24);
  color: var(--text-muted);
}

/* 底部按钮样式 */
.footer {
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-card);
  border-top: 1px solid var(--border-color);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.btn-submit {
  width: 100%;
}

.btn-submit-inner {
  background: var(--gradient-primary) !important;
  box-shadow: var(--shadow-primary) !important;
}

.btn-submit-inner:active,
.btn-submit-inner.t-button--hover,
.btn-submit-inner.t-button--active {
  background: var(--gradient-primary) !important;
  opacity: 1 !important;
}

.btn-submit-inner.t-button--disabled,
.btn-submit-inner--disabled,
.btn-submit-inner--disabled:active,
.btn-submit-inner--disabled.t-button--hover,
.btn-submit-inner--disabled.t-button--active {
  background: var(--text-muted) !important;
  opacity: 0.55 !important;
  box-shadow: none !important;
}

/* 录音弹窗 */
.record-popup-host,
.record-popup-host .t-popup,
.record-popup-host .t-popup__content,
.record-popup {
  border-top-left-radius: var(--radius-2xl) !important;
  border-top-right-radius: var(--radius-2xl) !important;
  overflow: hidden;
}

.record-popup {
  height: 616rpx;
  box-sizing: border-box;
  background-color: var(--bg-card);
  padding: 48rpx var(--pd-base) 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-popup-header {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 56rpx;
  margin-bottom: 48rpx;
}

.record-popup-header-spacer {
  flex: none;
  width: 56rpx;
  height: 56rpx;
}

.record-popup-close {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-full);
  background: var(--bg-card);
  color: var(--text-secondary);
}

.record-popup-close-text {
  font-size: var(--fs-40);
  font-weight: 400;
  line-height: 1;
}

.record-hint {
  flex: 1;
  box-sizing: border-box;
  min-width: 0;
  padding: 0 16rpx;
  font-size: var(--fs-28);
  color: var(--text-muted);
  text-align: center;
}

/* 录音按钮区域：相对定位容器，侧边按钮绝对浮出 */
.record-btn-area {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--pd-base);
  width: 100%;
  height: 400rpx;
  box-sizing: border-box;
  /* 录音状态为上方语音预览留出空间 */
  padding-top: 216rpx;
}

.record-btn-area.ready {
  flex-wrap: wrap;
  align-content: center;
  height: 400rpx;
  padding-top: 216rpx;
}

.record-ready-preview {
  position: absolute;
  top: 0;
  left: 50%;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  transform: translateX(-50%);
}

.pending-record-bubble {
  position: relative;
  z-index: 4;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 286rpx !important;
  min-width: 286rpx;
  height: 112rpx !important;
  padding: 0 24rpx;
  box-sizing: border-box;
  overflow: visible;
  border: 2rpx solid var(--primary);
  border-radius: 30rpx !important;
  background: var(--primary) !important;
  color: var(--text-white);
  box-shadow: var(--shadow-primary) !important;
}

.pending-record-bubble .record-voice-bubble-tail {
  background: var(--primary) !important;
}

.pending-record-bubble--active {
  opacity: 0.88;
}

.pending-record-wave {
  display: flex;
  align-items: center;
  gap: 5rpx;
  height: 40rpx;
}

.pending-record-wave-bar {
  width: 6rpx;
  height: 20rpx;
  border-radius: var(--radius-full);
  background: var(--text-white);
}

.pending-record-wave-bar:nth-child(2),
.pending-record-wave-bar:nth-child(4) {
  height: 36rpx;
}

.pending-record-bubble.playing .pending-record-wave-bar {
  animation: pending-record-wave 0.8s ease-in-out infinite alternate;
}

.pending-record-bubble.playing .pending-record-wave-bar:nth-child(2) {
  animation-delay: 0.15s;
}

.pending-record-bubble.playing .pending-record-wave-bar:nth-child(3) {
  animation-delay: 0.3s;
}

.pending-record-bubble.playing .pending-record-wave-bar:nth-child(4) {
  animation-delay: 0.45s;
}

@keyframes pending-record-wave {
  from {
    transform: scaleY(0.55);
  }
  to {
    transform: scaleY(1);
  }
}

.pending-record-duration {
  font-size: var(--fs-32);
  font-weight: 600;
  line-height: 1;
}

.pending-record-tip {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

/* 转文字按钮默认隐藏，录音完成后进入并排布局 */
.record-side-btn {
  position: absolute;
  bottom: 50%;

  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: row;

  gap: 10rpx;

  height: 72rpx;
  padding: 0 28rpx;

  border-radius: var(--radius-full);

  backdrop-filter: blur(20rpx);

  opacity: 0;
  pointer-events: none;
  /* 初始位置：居中，无旋转 */
  transform: translate(-50%, 0) rotate(0deg);

  z-index: 10;
}

.record-side-text {
  font-size: var(--fs-24);
  line-height: 1;
  white-space: nowrap;
  color: var(--text-secondary);
}

/* 转文字按钮：录音完成后与“仅使用录音”正常并排显示 */
.record-asr {
  left: 50%;
  background: var(--gradient-primary);
  border: none;
  box-shadow: var(--shadow-primary);
}
.record-asr.visible {
  position: static;
  flex: 1;
  min-width: 0;
  height: var(--btn-height);
  opacity: 1;
  pointer-events: auto;
  transform: none;
}
.record-asr .record-side-text {
  color: var(--text-white);
}

.record-asr .t-icon,
.theme-dark .record-asr .t-icon {
  color: var(--text-white) !important;
}

.theme-dark .record-asr.hover .t-icon {
  color: var(--text-white) !important;
}

.record-btn {
  position: relative;
  z-index: 2;
  width: 240rpx;
  height: 104rpx;
  border-radius: var(--radius-full);
  background-color: var(--bg-input);
  border: 4rpx solid var(--primary);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.2s;
}

.record-btn.recording {
  background-color: var(--primary);
  border-color: var(--primary);
}

.record-btn.ready {
  flex: 1;
  min-width: 0;
  width: auto;
  height: var(--btn-height);
  background-color: var(--bg-input);
  border-color: var(--primary);
  box-shadow: 0 8rpx 24rpx var(--shadow-primary);
}

.record-btn-area.ready .record-btn-text,
.record-btn-area.ready .record-side-text {
  font-size: var(--fs-32);
}

.record-btn.disabled {
  opacity: 0.65;
  pointer-events: none;
}

.record-btn-text {
  font-size: var(--fs-32);
  line-height: 1;
  color: var(--text-secondary);
}

.record-btn.idle .record-btn-text {
  width: 100%;
  text-align: center;
}

.record-btn.recording .record-btn-text {
  color: var(--text-white);
}

.record-voice-preview {
  position: absolute;
  top: 0;
  left: 50%;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: translateX(-50%);
  pointer-events: none;
}

.record-voice-bubble {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 286rpx;
  height: 112rpx;
  background: var(--primary);
  border-radius: 30rpx;
  box-shadow: var(--shadow-primary);
}

.record-voice-bubble-tail {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 24rpx;
  height: 24rpx;
  background: var(--primary);
  border-radius: 0 0 5rpx 0;
  transform: translateX(-50%) rotate(45deg);
}

.record-send-hint {
  margin-top: 32rpx;
  color: var(--text-secondary);
  font-size: var(--fs-24);
  font-weight: 500;
  line-height: 1.3;
  white-space: nowrap;
}

.lingnan-window {
  position: relative;
  z-index: 1;
  width: 150rpx;
  height: 76rpx;
  color: #ffe8a3;
}

.lingnan-window-frame {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  border: 4rpx solid currentColor;
  border-radius: 12rpx;
  opacity: 0.38;
  animation: lingnan-window-glow 2.4s ease-in-out infinite;
}

.lingnan-window-line {
  position: absolute;
  z-index: 1;
  border-radius: var(--radius-full);
  background: currentColor;
  opacity: 0.32;
  animation: lingnan-window-line-glow 2.4s ease-in-out 0.25s infinite;
}

.lingnan-window-line--horizontal {
  top: 50%;
  left: 8rpx;
  width: calc(100% - 16rpx);
  height: 3rpx;
  transform: translateY(-50%);
}

.lingnan-window-line--vertical {
  top: 8rpx;
  left: 50%;
  width: 3rpx;
  height: calc(100% - 16rpx);
  transform: translateX(-50%);
}

.lingnan-window-diamond {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 2;
  width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  border: 4rpx solid currentColor;
  opacity: 0.34;
  transform: translate(-50%, -50%) rotate(45deg);
  animation: lingnan-window-glow 2.4s ease-in-out 0.45s infinite;
}

.lingnan-window-petal {
  position: absolute;
  z-index: 3;
  width: 22rpx;
  height: 22rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 50% 0 50% 0;
  opacity: 0.3;
  animation: lingnan-window-glow 2.4s ease-in-out 0.7s infinite;
}

.lingnan-window-petal--top {
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
}

.lingnan-window-petal--right {
  top: 50%;
  right: 44rpx;
  transform: translateY(-50%) rotate(135deg);
}

.lingnan-window-petal--bottom {
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%) rotate(225deg);
}

.lingnan-window-petal--left {
  top: 50%;
  left: 44rpx;
  transform: translateY(-50%) rotate(315deg);
}

.lingnan-window-center {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 4;
  width: 14rpx;
  height: 14rpx;
  border-radius: var(--radius-full);
  background: currentColor;
  opacity: 0.35;
  transform: translate(-50%, -50%);
  animation: lingnan-window-center-glow 2.4s ease-in-out 0.95s infinite;
}

@keyframes lingnan-window-glow {
  0%,
  18% {
    opacity: 0.3;
    box-shadow: 0 0 0 rgba(255, 232, 163, 0);
  }

  72%,
  100% {
    opacity: 1;
    box-shadow: 0 0 18rpx rgba(255, 232, 163, 0.82);
  }
}

@keyframes lingnan-window-line-glow {
  0%,
  22% {
    opacity: 0.24;
  }

  75%,
  100% {
    opacity: 0.95;
    box-shadow: 0 0 10rpx rgba(255, 232, 163, 0.72);
  }
}

@keyframes lingnan-window-center-glow {
  0%,
  26% {
    opacity: 0.32;
    box-shadow: 0 0 0 rgba(255, 244, 204, 0);
  }

  78%,
  100% {
    opacity: 1;
    box-shadow: 0 0 24rpx 8rpx rgba(255, 244, 204, 0.82);
  }
}

.record-waveform {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  width: 210rpx;
  height: 50rpx;
}

.record-waveform-bar {
  width: 5rpx;
  height: 42rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.82);
  opacity: 0.76;
  transform: scaleY(0.24);
  transform-origin: center;
  animation: record-wave-pulse 0.9s ease-in-out infinite;
}

.record-waveform-bar:nth-child(2n) {
  animation-delay: -0.72s;
}

.record-waveform-bar:nth-child(3n) {
  animation-delay: -0.54s;
}

.record-waveform-bar:nth-child(4n) {
  animation-delay: -0.36s;
}

.record-waveform-bar:nth-child(5n) {
  animation-delay: -0.18s;
}

@keyframes record-wave-pulse {
  0%,
  100% {
    opacity: 0.58;
    transform: scaleY(0.2);
  }

  50% {
    opacity: 0.92;
    transform: scaleY(1);
  }
}

.record-btn-text-recording {
  font-size: var(--fs-24);
  line-height: 1;
}

.record-timer {
  font-size: var(--fs-24);
  color: var(--primary);
  font-weight: 600;
  white-space: nowrap;
}

.record-btn.recording .record-timer {
  color: var(--text-white);
}

@media (prefers-reduced-motion: reduce) {
  .record-waveform-bar {
    animation: none;
    opacity: 0.8;
  }

  .record-waveform-bar:nth-child(1),
  .record-waveform-bar:nth-child(5) {
    transform: scaleY(0.45);
  }

  .record-waveform-bar:nth-child(2),
  .record-waveform-bar:nth-child(4) {
    transform: scaleY(0.72);
  }

  .record-waveform-bar:nth-child(3) {
    transform: scaleY(1);
  }
}

/* 侧边按钮悬停高亮 */
.record-side-btn.hover {
  opacity: 0.88;
  transform: translate(-50%, 0) rotate(0deg) scale(1.08);
}
.record-asr.hover {
  opacity: 0.88;
  transform: none;
}

/* ============================================
   转文字结果弹窗
   ============================================ */
.asr-popup {
  background-color: var(--bg-card);
  border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
  padding: 40rpx var(--pd-base) 64rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.asr-popup-header {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 56rpx;
}

.asr-popup-header-spacer,
.asr-popup-close {
  flex: none;
  width: 56rpx;
  height: 56rpx;
}

.asr-popup-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
}

.asr-popup-close {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-full);
  background: var(--bg-card);
  color: var(--text-secondary);
}

.asr-popup-close-text {
  font-size: var(--fs-40);
  font-weight: 400;
  line-height: 1;
}

.asr-textarea {
  min-height: 280rpx;
  background: var(--bg-input);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx !important;
  font-size: var(--fs-32);
  line-height: 1.6;
  border: 1px solid var(--border-color);
}

.asr-actions {
  display: flex;
  gap: var(--pd-base);
  justify-content: center;
  width: 100%;
}

.asr-btn {
  flex: 1;
  min-width: 0;
  height: var(--btn-height) !important;
}

.asr-btn-secondary {
  height: var(--btn-height) !important;
  min-height: var(--btn-height) !important;
  padding: 0 24rpx !important;
  overflow: hidden;
  border: 1px solid var(--border-color) !important;
  border-radius: var(--radius-full) !important;
  background-color: var(--bg-input) !important;
  color: var(--text-secondary) !important;
  font-size: var(--fs-32) !important;
  font-weight: 500 !important;
}

.asr-btn-secondary::before,
.asr-btn-secondary::after {
  display: none !important;
  border: 0 !important;
}

.asr-btn-confirm {
  height: var(--btn-height) !important;
  background: var(--gradient-primary) !important;
  border: none !important;
  border-radius: var(--radius-full) !important;
  color: var(--text-white) !important;
  box-shadow: var(--shadow-primary) !important;
}

.asr-btn .t-button__text {
  font-size: var(--fs-32) !important;
}

/* swiper 外层 */
.view-swiper-wrap {
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

/* swiper */
.view-swiper {
  width: 100%;
  height: 520rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #000;
}

/* 媒体 */
.view-media {
  width: 100%;
  height: 100%;
  display: block;
  background: #000;
}

/* 内容区 */
.view-content {
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 172rpx);
  box-sizing: border-box;
}

/* 标题 */
.view-title {
  font-size: var(--fs-40);
  font-weight: 700;
  line-height: 1.5;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 正文 */
.view-body {
  margin-top: 24rpx;
}

.view-body-text {
  font-size: var(--fs-32);
  line-height: 1.8;
  color: var(--text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* meta */
.view-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.view-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: var(--radius-full);
  background: rgba(74, 124, 243, 0.08);
}

.view-meta-text {
  font-size: var(--fs-24);
  color: var(--text-secondary);
}

/* 标签 */
.view-tags {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  padding: 10rpx 20rpx;
  border-radius: var(--radius-full);
  background: rgba(74, 124, 243, 0.12);
}

.topic-text {
  font-size: var(--fs-24);
  color: var(--primary);
}

/* 底部栏 */
.view-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: var(--bg-card);
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: space-between;
}

.view-footer-action {
  height: var(--btn-height);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.view-footer-text {
  font-size: var(--fs-28);
  font-weight: 600;
}

.hot-wrap {
  display: flex;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
  margin-left: auto;
}

.hot-icon {
  width: 52rpx;
  height: 52rpx;
  color: var(--danger);
}

.t-icon-search.t-icon-base {
  color: var(--text-muted) !important;
}

.t-search__input-box .t-input__keyword {
  color: var(--text-primary) !important;
}
