.upload-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  color: var(--text-primary);
}

.upload-content {
  padding: 24rpx 32rpx;
  padding-bottom: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* TDesign Navbar 样式覆盖 */
.upload-page .t-navbar {
  background-color: var(--bg-card);
}

.upload-page .custom-navbar-title {
  font-size: 28rpx;
  color: var(--text-primary);
}

.upload-page .t-navbar__left-arrow {
  font-size: 20px;
}

/* 顶部导航栏 */
.upload-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
  border-bottom: 1px solid var(--border-light);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-btn {
  min-width: 120rpx;
}

.cancel-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.publish-btn {
  min-width: 120rpx;
}

/* 投稿类型选择 */
.type-section {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-color);
}

.type-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.type-picker-wrapper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.type-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.type-value.placeholder {
  color: var(--text-muted);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 216rpx;
  height: 216rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
  background-color: var(--bg-input);
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--border-color);
  background-color: var(--bg-input);
}

.add-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
}

.add-count {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* 输入区域 */
.input-section {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 1px solid var(--border-color);
}

.title-input {
  font-size: 32rpx;
  border-radius: var(--radius-md);
  background-color: var(--bg-card);
  padding: 0 16rpx;
}

/* 控制 t-input 高度为 100rpx */
.title-input.t-input {
  --td-input-vertical-padding: 0 !important;
  padding: 0rpx 32rpx !important;
  height: 100rpx !important;
  max-height: 100rpx !important;
}
.title-input .t-input__wrap {
  height: 100rpx !important;
  align-items: center !important;
}

.input-placeholder {
  color: var(--text-muted);
}

.content-section {
  position: relative;
}

.content-textarea {
  font-size: 32rpx;
  min-height: 300rpx;
  border-radius: var(--radius-lg);
  padding-left: 12rpx !important;
  padding-top: 12rpx !important;
}

.word-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

.textarea-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}

.audio-section {
  display: flex;
  gap: 12rpx;
}
.mic-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 录音播放组件 */
.audio-player {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  background-color: var(--bg-input);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
}

.audio-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.audio-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.audio-duration {
  font-size: 24rpx;
  color: var(--text-muted);
}

.audio-delete {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 话题区域 */
.topic-section {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 1px solid var(--border-color);
}

.topic-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.topic-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background-color: rgba(74, 124, 243, 0.1);
  border-radius: var(--radius-full);
  gap: 8rpx;
}

.topic-text {
  font-size: 26rpx;
  color: var(--primary);
}

.topic-close {
  color: var(--primary);
}

.add-topic {
  background-color: var(--bg-input);
  border: 1px solid var(--border-color);
}

.add-topic .topic-text {
  color: var(--text-secondary);
}

/* 话题弹窗样式 */
.topic-popup {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.topic-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.topic-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.topic-popup-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
}

.topic-search {
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.topic-list-popup {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 0;
  max-height: 500rpx;
}

.topic-item-popup {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border-color);
}

.topic-item-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 底部按钮样式 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
  border-top: 1px solid var(--border-color);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.btn-submit {
  width: 100%;
  max-width: 600rpx;
}

.btn-submit-inner {
  background: var(--gradient-primary) !important;
  box-shadow: var(--shadow-primary) !important;
}

/* 录音弹窗 */
.record-popup {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 48rpx 32rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-hint {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-bottom: 48rpx;
}

.record-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--bg-input);
  border: 4rpx solid var(--primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.2s;
}

.record-btn.recording {
  background-color: var(--primary);
  border-color: var(--primary);
}

.record-btn-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.record-btn.recording .record-btn-text {
  color: var(--text-primary);
}

.record-timer {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}

.record-btn.recording .record-timer {
  color: var(--text-primary);
}
