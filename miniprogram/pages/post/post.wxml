<view class="upload-page upload-page--{{mode}} theme-{{currentTheme}}">
  <block wx:if="{{mode === 'edit'}}">
    <!-- 空的返回哨兵：只接管返回，投稿内容保留在真实页面上，避免侧滑时白屏。 -->
    <page-container
      show="{{exitGuardVisible}}"
      duration="0"
      overlay="{{false}}"
      position="right"
      z-index="0"
      custom-style="width: 100vw; height: 100vh; pointer-events: none; background: transparent;"
      bind:beforeleave="onExitGuardBeforeLeave"
      bind:afterleave="onExitGuardAfterLeave"
    />
    <t-navbar fixed="{{true}}" placeholder="{{true}}" z-index="{{100}}" class="custom-navbar">
      <view slot="left" class="custom-navbar-back" bind:tap="onNavbarBack">
        <t-icon name="chevron-left" size="28px" />
      </view>
      <view slot="title" class="custom-navbar-title">我要投稿</view>
    </t-navbar>


    <scroll-view class="upload-content" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="upload-content-inner">
      <view class="type-section">
        <view class="type-label">
          <text>选择活动</text>
        </view>
        <view class="type-picker-wrapper" bind:tap="onShowActivityPopup">
          <text
            class="type-value {{selectedActivity && selectedActivity.title ? '' : 'placeholder'}}">{{selectedActivity && selectedActivity.title ? selectedActivity.title : '请选择活动'}}</text>
          <t-icon name="chevron-down" size="20" color="var(--text-muted)" />
        </view>
      </view>

      <!-- 标题输入 -->
      <view class="input-section title-section">
        <t-textarea placeholder="请填写标题" value="{{title}}" bind:change="onTitleInput" class="title-input"
          maxlength="{{100}}" autosize="{{true}}" borderless="{{true}}"
          placeholder-style="color: var(--text-muted)" />
        <view class="textarea-footer">
          <view class="word-count">{{title.length}}/100</view>
        </view>
      </view>

      <!-- 内容输入 -->
      <view class="input-section content-section">
        <view class="audio-section">
          <view class="mic-btn" wx:if="{{allowAudioUpload}}" bind:tap="onOpenRecordPopup">
            <t-icon name="microphone" size="30" color="var(--primary)" />
          </view>
          <!-- 录音播放组件 -->
          <view class="audio-player" wx:if="{{audioUrl}}" bind:tap="onPlayAudio">
            <view class="audio-info">
              <t-icon name="play-circle-fill" size="36" color="var(--primary)" />
              <text class="audio-label">录音</text>
              <text class="audio-duration" wx:if="{{audioDuration}}">{{audioDuration}}"</text>
            </view>
            <view class="audio-delete" catch:tap="onDeleteAudio">
              <t-icon name="close" size="16" color="var(--text-muted)" />
            </view>
          </view>
        </view>
        <t-textarea placeholder="请输入内容简介" value="{{content}}" bind:change="onContentInput" class="content-textarea"
          maxlength="{{400}}" autocursor="{{true}}" autosize="{{true}}" borderless="{{true}}"
          placeholder-style="color: var(--text-muted)" />
        <view class="textarea-footer">
          <view class="word-count">{{content.length}}/400</view>

        </view>
      </view>

      <view class="channel-section" wx:if="{{allowVideoUpload || localVideo}}">
        <view class="channel-heading">本地视频</view>
        <text class="channel-note">最多 1 个，时长不超过 30 秒</text>
        <video wx:if="{{localVideo}}" class="submission-video-preview" src="{{localVideo.url}}" poster="{{resolvedCoverUrl}}" controls />
        <text class="channel-error" wx:if="{{!allowVideoUpload}}">当前活动不支持本地视频，请移除或切换活动。</text>
        <view class="channel-actions local-video-actions">
          <t-button wx:if="{{localVideo}}" size="small" variant="text" bind:tap="onRemoveLocalVideo">移除视频</t-button>
          <t-button wx:elif="{{allowVideoUpload}}" size="small" variant="outline" custom-style="{{(mediaUploading) && currentTheme === 'light' ? 'opacity: 1 !important; color: #64748b !important; background: #f1f5f9 !important; border-color: #cbd5e1 !important; --td-button-default-outline-disabled-color: #cbd5e1;' : ''}}" bind:tap="onChooseLocalVideo" disabled="{{mediaUploading}}"><text style="{{(mediaUploading) && currentTheme === 'light' ? 'color: #64748b !important;' : ''}}">选择视频</text></t-button>
        </view>
      </view>

      <view class="channel-section" wx:if="{{supportsBodyImages || imageCount > 0}}">
        <view class="channel-heading">图片</view>
        <text class="channel-note">{{supportsBodyImages ? '最多 8 张；未单独设置封面时，第一张图片作为列表封面。' : '保留的图片仅可作为视频封面；可移除后在下方更换封面。'}}</text>
        <view class="image-list">
          <block wx:for="{{imageList}}" wx:key="index">
            <view class="image-item" wx:if="{{item.type === 'image'}}">
              <image src="{{item.url}}" mode="aspectFill" class="uploaded-image" />
              <text wx:if="{{!inheritedCoverUrl && item.url === resolvedCoverUrl}}" class="submission-cover-badge">封面</text>
              <view class="delete-btn" catch:tap="onDeleteImage" data-index="{{index}}"><t-icon name="close" size="16" color="var(--text-white)" /></view>
            </view>
          </block>
          <view class="image-item add-btn" wx:if="{{supportsBodyImages && imageCount < 8}}" catch:tap="onChooseImage">
            <t-icon name="add" size="32" color="var(--text-muted)" /><text class="media-add-label">添加图片</text>
          </view>
        </view>
      </view>

      <!-- 投稿类型选择 -->
      <view class="type-section">
        <view class="type-label">
          <text>投稿类型</text>
        </view>
        <view class="type-picker-wrapper" bind:tap="onShowTypePicker">
          <text class="type-value {{selectedType ? '' : 'placeholder'}}">{{selectedType || '请选择投稿类型'}}</text>
          <t-icon name="chevron-down" size="20" color="var(--text-muted)" />
        </view>
      </view>

      <!-- 话题标签 -->
      <view class="topic-section">
        <view class="topic-header">
          <text class="topic-title">添加标签</text>
        </view>
        <view class="topic-list">
          <block wx:for="{{selectedActivity.tags}}" wx:key="index">
            <view class="topic-tag">
              <text class="topic-text">#{{item}}</text>
            </view>
          </block>
          <block wx:for="{{selectedTopics}}" wx:key="index">
            <view class="topic-tag">
              <text class="topic-text">#{{item}}</text>
              <t-icon name="close" size="14" bind:tap="onRemoveTopic" data-index="{{index}}" class="topic-close" />
            </view>
          </block>
          <view class="topic-tag add-topic" bind:tap="onAddTopic">
            <t-icon name="add" size="16" />
            <text class="topic-text">添加标签</text>
          </view>
        </view>
      </view>

      <view class="channel-section">
        <view class="channel-heading">关联视频号<text class="media-optional">选填 · 最多 1 条</text></view>
        <text class="channel-note">{{channelVideo ? '已关联作品，读者可在详情页点击观看。' : '额外关联视频号作品，不影响已上传内容，也不替代活动要求的投稿内容。'}}</text>
        <view class="channel-actions">
          <t-button wx:if="{{channelVideo}}" size="small" variant="outline" bind:tap="onOpenChannel" loading="{{channelOpening}}">打开检查</t-button>
          <t-button size="small" variant="outline" custom-style="{{mediaUploading && currentTheme === 'light' ? 'opacity: 1 !important; color: #64748b !important; background: #f1f5f9 !important; border-color: #cbd5e1 !important; --td-button-default-outline-disabled-color: #cbd5e1;' : ''}}" bind:tap="onEditChannel" disabled="{{mediaUploading}}"><text style="{{mediaUploading && currentTheme === 'light' ? 'color: #64748b !important; opacity: 1;' : ''}}">{{channelVideo ? '修改信息' : '填写作品信息'}}</text></t-button>
          <t-button wx:if="{{channelVideo}}" size="small" variant="text" bind:tap="onRemoveChannel">移除关联</t-button>
        </view>
      </view>

      <view class="channel-section">
        <view class="channel-heading">作品封面<text class="media-optional">选填</text></view>
        <view class="submission-cover-row">
          <image wx:if="{{resolvedCoverUrl}}" class="submission-cover-thumb" src="{{resolvedCoverUrl}}" mode="aspectFill" />
          <view wx:else class="submission-cover-thumb submission-cover-empty"><t-icon name="image" size="32" color="var(--text-muted)" /></view>
          <view class="submission-cover-info">
            <text class="channel-note">{{coverLabel}}</text>
            <text class="channel-note">用于列表展示，不计入正文图片；仅设置封面不能单独投稿。</text>
          </view>
        </view>
        <view class="channel-actions submission-cover-actions">
          <t-button size="small" variant="outline" custom-style="{{mediaUploading && currentTheme === 'light' ? 'opacity: 1 !important; color: #64748b !important; background: #f1f5f9 !important; border-color: #cbd5e1 !important; --td-button-default-outline-disabled-color: #cbd5e1;' : ''}}" bind:tap="onChooseCover" disabled="{{mediaUploading}}"><text style="{{mediaUploading && currentTheme === 'light' ? 'color: #64748b !important; opacity: 1;' : ''}}">{{resolvedCoverUrl ? '更换封面' : '选择封面'}}</text></t-button>
          <t-button wx:if="{{inheritedCoverUrl}}" size="small" variant="text" bind:tap="onRemoveInheritedCover">恢复默认</t-button>
        </view>
      </view>

      <!-- 活动选择弹窗 -->
      <root-portal enable="{{activityPopupVisible}}">
      <t-popup visible="{{activityPopupVisible}}" placement="bottom" z-index="{{11500}}" overlay-props="{{selectionPopupOverlayProps}}" t-class="post-popup-host theme-{{currentTheme}}" bind:visible-change="onActivityPopupClose">
        <view class="topic-popup theme-{{currentTheme}}">
          <view class="topic-popup-header">
            <text class="topic-popup-title">选择活动</text>
            <view class="topic-popup-close" bind:tap="onActivityPopupClose">
              <t-icon name="close" size="20" />
            </view>
          </view>
          <view class="topic-search">
            <t-search placeholder="搜索活动" value="{{activityKeyword}}" bind:change="onActivitySearch"
              bind:submit="onActivitySearch" placeholder-style="color: var(--text-muted)" />
          </view>
          <scroll-view class="topic-list-popup" scroll-y bindscrolltolower="onActivityScrollToLower">
            <!-- 不参与任何活动 -->
            <view class="topic-item-popup" bind:tap="onNoActivity">
              <view class="activity-item-content">
                <text class="topic-item-text {{selectedActivity && selectedActivity.id === '' ? 'activity-item-title-selected' : ''}}">不参与任何活动</text>
              </view>
              <t-icon wx:if="{{selectedActivity && selectedActivity.id === ''}}" name="check" size="16" color="var(--primary)" />
            </view>
            <view class="topic-item-popup" wx:for="{{activityList}}" wx:key="id" bind:tap="onSelectActivity"
              data-id="{{item.id}}" data-title="{{item.title}}">
              <view class="activity-item-content">
                <text class="topic-item-text {{selectedActivity && selectedActivity.id === item.id ? 'activity-item-title-selected' : ''}}">{{item.title}}</text>
                <text class="activity-item-description" wx:if="{{item.description}}">{{item.description}}</text>
              </view>
              <t-icon wx:if="{{selectedActivity && selectedActivity.id === item.id}}" name="check" size="16"
                color="var(--primary)" />
            </view>
            <view class="loading-tip" wx:if="{{activityLoading}}">
              <text>加载中...</text>
            </view>
            <view class="loading-tip" wx:elif="{{activityNoMore && activityList.length > 0}}">
              <text>没有更多了</text>
            </view>
            <view class="loading-tip" wx:elif="{{!activityLoading && activityList.length === 0}}">
              <text>暂无活动</text>
            </view>
            <view class="topic-list-bottom-spacer" aria-hidden="true"></view>
          </scroll-view>
        </view>
      </t-popup>
      </root-portal>

      <!-- Picker 弹出层 -->
      <root-portal enable="{{pickerVisible}}">
      <t-picker class="post-picker-root theme-{{currentTheme}}" t-class="post-picker-panel theme-{{currentTheme}}" visible="{{pickerVisible}}" popup-props="{{selectionPopupProps}}" bind:change="onTypeChange" bind:cancel="onPickerCancel" header="{{true}}"
        title="选择投稿类型">
        <t-picker-item options="{{typeOptions}}" />
      </t-picker>
      </root-portal>

      <!-- 话题选择弹窗 -->
      <root-portal enable="{{topicPopupVisible}}">
      <t-popup visible="{{topicPopupVisible}}" placement="bottom" z-index="{{11500}}" overlay-props="{{selectionPopupOverlayProps}}" t-class="post-popup-host theme-{{currentTheme}}" bind:visible-change="onTopicPopupClose">
        <view class="topic-popup theme-{{currentTheme}}">
          <view class="topic-popup-header">
            <text class="topic-popup-title">选择标签</text>
            <view class="topic-popup-close topic-popup-confirm {{selectedTopics.length > 0 ? 'topic-popup-confirm--active' : ''}}" bind:tap="onTopicPopupClose">
              确定
            </view>
          </view>
          <view class="topic-search">
            <t-search placeholder="搜索标签" value="{{topicSearchKeyword}}" bind:change="onTopicSearch"
              bind:submit="onTopicSearchSubmit" placeholder-style="color: var(--text-muted)" />
            <view class="custom-topic-row" wx:if="{{topicSearchKeyword}}" bind:tap="onAddCustomTopic">
              <view class="custom-topic-label">
                <t-icon name="add-circle" size="18" color="var(--primary)" />
                <text class="custom-topic-text">添加 #{{topicSearchKeyword}}</text>
              </view>
              <t-icon name="chevron-right" size="18" color="var(--text-muted)" />
            </view>
          </view>
          <scroll-view class="topic-list-popup" scroll-y>
            <view class="topic-item-popup {{selectedTopicMap[item] ? 'topic-item-selected' : ''}}"
              wx:for="{{filteredTopicList}}" wx:key="*this" bind:tap="onSelectTopic"
              data-topic="{{item}}" data-index="{{index}}">
              <text class="topic-item-text">#{{item}}</text>
              <t-icon wx:if="{{selectedTopicMap[item]}}" name="check" size="16" color="var(--primary)" />
            </view>
            <view class="topic-list-bottom-spacer" aria-hidden="true"></view>
          </scroll-view>
        </view>
      </t-popup>
      </root-portal>

      </view>
    </scroll-view>

    <!-- 底部按钮 -->
    <view class="footer">
      <t-button variant="outline" shape="round" custom-style="{{(mediaUploading || submitting) && currentTheme === 'light' ? 'opacity: 1 !important; color: #64748b !important; background: #f1f5f9 !important; border-color: #cbd5e1 !important; --td-button-default-outline-disabled-color: #cbd5e1;' : ''}}" bind:tap="onPreviewSubmission" disabled="{{mediaUploading || submitting}}"><text style="{{(mediaUploading || submitting) && currentTheme === 'light' ? 'color: #64748b !important;' : ''}}">预览</text></t-button>
      <t-button theme="primary" shape="round" bind:tap="onPublish" loading="{{submitting || mediaUploading}}" disabled="{{submitting || mediaUploading}}"
        class="btn-submit btn-submit-inner {{!canPublish ? 'btn-submit-inner--disabled' : ''}}"
        aria-disabled="{{!canPublish}}" hover-class="none">
        投稿
      </t-button>
    </view>

    <!-- 录音弹窗 -->
    <t-popup visible="{{recordPopupVisible}}" placement="bottom" t-class="post-popup-host record-popup-host theme-{{currentTheme}}" bind:visible-change="onRecordPopupClose"
      close-on-overlay-click="{{!recordProcessing}}">
      <view class="record-popup theme-{{currentTheme}}">
        <view class="record-popup-header">
          <view class="record-popup-header-spacer"></view>
          <view class="record-hint">
            {{recordReady ? '录音完成，请选择下一步' : (recording ? '正在录音，点击中间按钮结束' : '点击开始录音，最长60秒')}}
          </view>
          <view class="record-popup-close" catch:tap="onRecordPopupCloseTap">
            <text class="record-popup-close-text">×</text>
          </view>
        </view>
        <view class="record-btn-area {{recordReady ? 'ready' : ''}}">
          <view wx:if="{{recordReady}}" class="record-ready-preview">
            <view
              class="record-voice-bubble pending-record-bubble {{pendingRecordPlaying ? 'playing' : ''}}"
              hover-class="pending-record-bubble--active"
              catch:tap="onPendingRecordBubbleTap"
              catch:longpress="onRerecordPendingAudio">
              <t-icon
                name="{{pendingRecordPlaying ? 'pause-circle-filled' : 'play-circle-filled'}}"
                size="40rpx"
                color="var(--text-white)"
              />
              <view class="pending-record-wave" aria-hidden="true">
                <view class="pending-record-wave-bar"></view>
                <view class="pending-record-wave-bar"></view>
                <view class="pending-record-wave-bar"></view>
                <view class="pending-record-wave-bar"></view>
              </view>
              <text class="pending-record-duration">{{pendingRecordDuration || recordTime}}''</text>
              <view class="record-voice-bubble-tail"></view>
            </view>
            <text class="pending-record-tip">点击播放，长按重新录音</text>
          </view>
          <view
            wx:if="{{recording && !recordStopping}}"
            class="record-voice-preview"
          >
            <view class="record-voice-bubble">
              <view class="record-waveform" aria-hidden="true">
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
                <view class="record-waveform-bar"></view>
              </view>
              <view class="record-voice-bubble-tail"></view>
            </view>
            <text class="record-send-hint">点击 发语音</text>
          </view>
          <view class="record-btn {{recording ? 'recording' : ''}} {{recordReady ? 'ready' : ''}} {{!recording && !recordReady ? 'idle' : ''}} {{recordStarting || recordProcessing || recordStopping ? 'disabled' : ''}}"
            bind:tap="onRecordButtonTap">
            <block wx:if="{{recording && !recordStopping}}">
              <view class="record-btn-text record-btn-text-recording">正在录入</view>
              <view class="record-timer">{{recordTime}}'' / 60''</view>
            </block>
            <block wx:else>
              <view class="record-btn-text">
                {{recordStarting ? '准备中' : (recordProcessing ? '处理中' : (recordStopping ? '结束中' : (recordReady ? '仅使用录音' : '开始录音')))}}
              </view>
            </block>
          </view>
          <view
            class="record-side-btn record-asr {{recordReady && !recordProcessing ? 'visible' : ''}}"
            bind:tap="onTranscribeRecordedAudio">
            <text class="record-side-text">转文字并使用录音</text>
          </view>
        </view>
      </view>
    </t-popup>

    <!-- 转文字结果弹窗 -->
    <t-popup visible="{{asrPopupVisible}}" placement="bottom" t-class="post-popup-host theme-{{currentTheme}}" close-on-overlay-click="{{false}}">
      <view class="asr-popup theme-{{currentTheme}}">
        <view class="asr-popup-header">
          <view class="asr-popup-header-spacer"></view>
          <view class="asr-popup-title">语音转文字</view>
          <view class="asr-popup-close" catch:tap="onAsrCancel">
            <text class="asr-popup-close-text">×</text>
          </view>
        </view>
        <t-textarea class="asr-textarea" value="{{asrText}}" placeholder="转换结果将显示在这里，可直接编辑"
          placeholder-style="color: var(--text-muted)" autosize="{{false}}" borderless="{{true}}"
          bind:change="onAsrTextInput" />
        <view class="asr-actions">
          <t-button theme="default" shape="round" size="medium" block t-class="asr-btn asr-btn-secondary" hover-class="none" bind:tap="onAsrUseAudio">仅使用录音</t-button>
          <t-button theme="primary" shape="round" size="medium" block t-class="asr-btn asr-btn-confirm" hover-class="none" bind:tap="onAsrConfirm">
            确认</t-button>
        </view>
      </view>
    </t-popup>

  </block>
  <block wx:else>
    <t-navbar fixed="{{true}}" placeholder="{{true}}" z-index="{{100}}" class="custom-navbar">
      <view slot="left" class="custom-navbar-back" bind:tap="onViewNavbarBack">
        <t-icon name="chevron-left" size="28px" />
      </view>
    </t-navbar>


    <!-- 媒体轮播 -->
    <view class="view-swiper-wrap" wx:if="{{imageList && imageList.length > 0}}">
      <swiper class="view-swiper" indicator-dots="{{imageList.length > 1}}" indicator-color="rgba(255,255,255,0.5)"
        indicator-active-color="var(--text-white)">
        <swiper-item wx:for="{{imageList}}" wx:key="index">
          <block wx:if="{{item.type === 'video'}}">
            <video class="view-media" src="{{item.url}}" poster="{{resolvedCoverUrl}}" controls show-fullscreen-btn object-fit="contain" />
          </block>
          <block wx:if="{{item.type === 'image'}}">
            <image class="view-media" src="{{item.url}}" mode="aspectFill" bind:tap="onPreviewImage"
              data-url="{{item.url}}" />
          </block>
        </swiper-item>
      </swiper>
    </view>
    <view class="view-content">
      <!-- 标题 -->
      <view class="view-title" wx:if="{{post.title}}">{{post.title}}</view>

      <!-- 音频 -->
      <view class="audio-player view-audio-player" wx:if="{{audioUrl}}" bind:tap="onPlayAudio">
        <view class="audio-info">
          <t-icon name="{{audioPlaying ? 'pause' : 'play'}}" size="40rpx" color="var(--primary)" />
          <text class="audio-label">点击播放录音</text>
          <text class="audio-duration" wx:if="{{audioDuration}}">{{audioDuration}}''</text>
        </view>
      </view>

      <!-- 正文 -->
      <view class="view-body" wx:if="{{post.intro}}">
        <text class="view-body-text" user-select>{{post.intro}}</text>
      </view>

      <!-- 元信息 -->
      <view class="view-meta">
        <view class="view-meta-item" wx:if="{{post.submissionType}}">
          <t-icon name="catalog" size="16" color="#94A3B8" />
          <text class="view-meta-text">{{post.submissionType}}</text>
        </view>
        <view class="view-meta-item" wx:if="{{post.activity && post.activity.title}}">
          <t-icon name="flag" size="16" color="#94A3B8" />
          <text class="view-meta-text">{{post.activity.title}}</text>
        </view>
      </view>

      <!-- 话题标签 -->
      <view class="topic-list view-tags" wx:if="{{post.tags && post.tags.length > 0}}">
        <view class="topic-tag" wx:for="{{post.tags}}" wx:key="index">
          <text class="topic-text">#{{item}}</text>
        </view>
      </view>

      <!-- 附加的视频号作品，保持原有详情内容顺序 -->
      <view class="channel-section view-channel-section" wx:if="{{channelVideo}}">
        <view class="channel-heading"><t-icon name="video" size="24" color="var(--primary, #4a7cf3)" /><text>关联视频号</text></view>
        <text class="channel-note">可前往视频号观看关联作品</text>
        <t-button theme="primary" block bind:tap="onOpenChannel" loading="{{channelOpening}}">去视频号观看</t-button>
      </view>
    </view>


    <view class="view-footer">
      <view class="view-footer-action" bind:tap="onEditPost" wx:if="{{post.canEdit && userId === post.author.id}}">
        <t-icon name="edit" size="20" color="var(--text-secondary)" />
        <text class="view-footer-text">编辑</text>
      </view>
      <view class="hot-wrap">
        <image src="/public/image/flame.svg" class="hot-icon" />
        <text class="hot-text">{{post.viewCount}}</text>
      </view>
    </view>

  </block>

</view>
<join-consent-popup
  visible="{{joinConsentPopupVisible}}"
  activity-id="{{joinConsentActivityId}}"
  current-theme="{{currentTheme}}"
  form-height="calc(85vh - 128rpx)"
  prepare-completed-journey="{{true}}"
  bind:close="onJoinConsentClose"
  bind:complete="onJoinConsentComplete"
/>


  <t-popup visible="{{channelEditorVisible}}" placement="bottom" z-index="{{11500}}"
    overlay-props="{{selectionPopupOverlayProps}}" t-class="channel-popup-host theme-{{currentTheme}}" t-class-content="channel-popup-content"
    bind:visible-change="onChannelPopupChange">
    <view class="channel-editor theme-{{currentTheme}}">
      <view class="channel-editor-header">
        <text class="channel-editor-title">添加视频号作品</text>
        <view class="channel-header-action"><t-button size="small" variant="text" hover-class="none" bind:tap="onCloseChannelEditor">取消</t-button></view>
      </view>
      <scroll-view scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" class="channel-editor-scroll">
        <view class="channel-editor-body">
          <text class="channel-note">从视频号助手复制以下两个 ID。暂不支持粘贴普通分享链接。</text>
          <view class="channel-help-trigger"><t-button size="small" icon="help-circle" custom-style="justify-content: flex-start; margin: 0; padding-left: 0; padding-right: 0;" variant="text" theme="primary" bind:tap="onToggleChannelHelp">{{channelHelpExpanded ? '收起获取指引' : '如何获取这两个 ID？'}}</t-button></view>
          <view wx:if="{{channelHelpExpanded}}" class="channel-help">
            <text class="channel-help-title">1. 登录视频号助手</text>
            <text class="channel-help-text">建议在电脑浏览器打开视频号助手，登录发布该作品的视频号。</text>
            <text class="channel-help-title">2. 首页复制视频号 ID</text>
            <text class="channel-help-text">在首页账号信息中找到“视频号 ID”，复制后填入下方视频号 ID（finderUserName），不是视频号昵称。</text>
            <text class="channel-help-title">3. 动态管理复制作品 ID</text>
            <text class="channel-help-text">进入“动态管理”，找到要关联的视频，在该作品的更多操作中选择“复制视频 ID”，填入作品 ID（feedId）。每条作品的 ID 不同；复制值开头如有 export/ 请完整保留。</text>
            <text class="channel-help-text">两个 ID 应来自同一视频号及其作品。这里不需要 feed-token，也不能用普通分享链接代替。填写后可打开作品检查。</text>
            <view class="channel-help-links">
              <t-button size="small" variant="outline" data-link="assistant" bind:tap="onCopyChannelHelpLink">复制视频号助手地址</t-button>
              <t-button size="small" variant="text" theme="primary" data-link="guide" bind:tap="onCopyChannelHelpLink">复制官方说明链接</t-button>
            </view>
            <text class="channel-help-caption">复制后在浏览器打开。展开或收起指引不会清空已填内容。</text>
            <view wx:if="{{channelCopyError}}">
              <text class="channel-error">{{channelCopyError}}</text>
              <text class="channel-copy-url" user-select="{{true}}" selectable="{{true}}">{{channelCopyFallbackUrl}}</text>
            </view>
          </view>
          <text class="channel-label">视频号 ID</text>
          <view class="channel-input"><t-input value="{{channelFinderDraft}}" placeholder="粘贴视频号ID" maxlength="1024" borderless bind:change="onChannelFinderInput" /></view>
          <view class="channel-feed-heading">
            <text class="channel-label">作品 ID</text>
            <view wx:if="{{channelFeedDraft}}" class="channel-header-action"><t-button size="small" variant="text" theme="primary" aria-label="清除作品 ID" bind:tap="onClearChannelFeed">清除</t-button></view>
          </view>
          <view class="channel-input channel-feed-input"><t-textarea value="{{channelFeedDraft}}" placeholder="粘贴完整作品 ID" maxlength="1024" autosize="{{channelFeedAutosize}}" fixed="{{true}}" cursor-spacing="24" confirm-type="done" bind:change="onChannelFeedInput" /></view>
          <text class="channel-error" wx:if="{{channelError}}">{{channelError}}</text>
          <text class="channel-note">先打开检查，确认作品正确后返回保存。视频内容将由运营人工审核，打开成功不代表归属认证。</text>
        </view>
      </scroll-view>
      <view class="channel-editor-footer">
        <view class="channel-footer-action"><t-button block shape="round" variant="outline" data-draft="{{true}}" bind:tap="onOpenChannel" loading="{{channelOpening}}">打开作品检查</t-button></view>
        <view class="channel-footer-action"><t-button block shape="round" theme="primary" bind:tap="onSaveChannel">保存关联</t-button></view>
      </view>
    </view>
  </t-popup>

  <t-popup visible="{{previewVisible}}" placement="bottom" z-index="{{11500}}"
    overlay-props="{{selectionPopupOverlayProps}}" t-class="channel-popup-host theme-{{currentTheme}}"
    t-class-content="channel-popup-content" bind:visible-change="onPreviewVisibleChange">
    <view class="submission-preview theme-{{currentTheme}}">
      <view class="channel-editor-header"><text class="channel-editor-title">投稿预览</text><view class="channel-header-action"><t-button size="small" variant="text" bind:tap="onClosePreview">返回编辑</t-button></view></view>
      <scroll-view scroll-y class="submission-preview-scroll">
        <view class="channel-editor-body">
          <text class="channel-note">仅预览，尚未提交。未填写的内容以占位文字显示。</text>
          <image wx:if="{{resolvedCoverUrl}}" class="channel-existing-cover" src="{{resolvedCoverUrl}}" mode="aspectFill" />
          <view wx:else class="preview-placeholder">作品封面</view>
          <view class="view-title">{{title || '待填写标题'}}</view>
          <view class="view-body"><text>{{content || '待填写内容简介'}}</text></view>
          <block wx:for="{{imageList}}" wx:key="index">
            <video wx:if="{{item.type === 'video'}}" class="submission-video-preview" src="{{item.url}}" poster="{{resolvedCoverUrl}}" controls />
            <image wx:else class="preview-body-image" src="{{item.url}}" mode="widthFix" />
          </block>
          <t-button wx:if="{{audioUrl}}" variant="outline" bind:tap="onPlayAudio">{{audioPlaying ? '暂停录音' : '播放录音'}} · {{audioDuration}}秒</t-button>
          <view wx:if="{{channelVideo}}" class="preview-channel">
            <view class="channel-heading">视频号作品</view><text class="channel-note">点击进入视频号观看原作品</text>
            <t-button block shape="round" theme="primary" bind:tap="onOpenChannel" loading="{{channelOpening}}">去视频号观看</t-button>
          </view>
          <text class="channel-note">{{selectedType || '未选择投稿类型'}} · {{selectedActivity.title || '不参与任何活动'}}</text>
          <view class="channel-actions"><text wx:for="{{selectedActivity.tags}}" wx:key="*this">#{{item}}</text><text wx:for="{{selectedTopics}}" wx:key="*this">#{{item}}</text></view>
        </view>
      </scroll-view>
    </view>
  </t-popup>

    <common-dialog id="common-dialog" />
