.scan-page { box-sizing: border-box; min-height: 100vh; padding: 48rpx 32rpx; background: var(--bg-page); color: var(--text-primary); }
.scan-card { padding: 48rpx 32rpx; border-radius: 24rpx; background: var(--bg-card); border: 1rpx solid var(--border-color); }
.scan-icon { color: var(--primary); text-align: center; margin-bottom: 24rpx; }
.scan-title { font-size: 36rpx; font-weight: 600; text-align: center; }
.scan-description { margin-top: 24rpx; font-size: 28rpx; line-height: 1.7; color: var(--text-secondary); }
.scan-action { margin-top: 32rpx; --td-button-primary-bg-color: var(--primary); --td-button-primary-border-color: var(--primary); }
.scan-error { margin-top: 24rpx; font-size: 26rpx; line-height: 1.6; color: var(--error, #e34d59); word-break: break-all; }
.scan-footnote { margin-top: 32rpx; font-size: 24rpx; line-height: 1.7; color: var(--text-secondary); }
