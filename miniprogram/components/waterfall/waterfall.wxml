<view class="waterfall" wx:if="{{loading}}" aria-label="作品加载中">
  <view class="waterfall-column">
    <view class="skeleton-card">
      <view class="skeleton-block skeleton-cover skeleton-cover--medium"></view>
      <view class="skeleton-content">
        <view class="skeleton-block skeleton-title"></view>
        <view class="skeleton-block skeleton-title skeleton-title--short"></view>
        <view class="skeleton-footer">
          <view class="skeleton-block skeleton-avatar"></view>
          <view class="skeleton-block skeleton-name"></view>
          <view class="skeleton-block skeleton-count"></view>
        </view>
      </view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-block skeleton-cover skeleton-cover--short"></view>
      <view class="skeleton-content">
        <view class="skeleton-block skeleton-title"></view>
        <view class="skeleton-footer">
          <view class="skeleton-block skeleton-avatar"></view>
          <view class="skeleton-block skeleton-name"></view>
          <view class="skeleton-block skeleton-count"></view>
        </view>
      </view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-block skeleton-cover skeleton-cover--tall"></view>
      <view class="skeleton-content">
        <view class="skeleton-block skeleton-title"></view>
        <view class="skeleton-block skeleton-title skeleton-title--short"></view>
        <view class="skeleton-footer">
          <view class="skeleton-block skeleton-avatar"></view>
          <view class="skeleton-block skeleton-name"></view>
          <view class="skeleton-block skeleton-count"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="waterfall-column">
    <view class="skeleton-card">
      <view class="skeleton-block skeleton-cover skeleton-cover--tall"></view>
      <view class="skeleton-content">
        <view class="skeleton-block skeleton-title"></view>
        <view class="skeleton-block skeleton-title skeleton-title--short"></view>
        <view class="skeleton-footer">
          <view class="skeleton-block skeleton-avatar"></view>
          <view class="skeleton-block skeleton-name"></view>
          <view class="skeleton-block skeleton-count"></view>
        </view>
      </view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-block skeleton-cover skeleton-cover--medium"></view>
      <view class="skeleton-content">
        <view class="skeleton-block skeleton-title"></view>
        <view class="skeleton-footer">
          <view class="skeleton-block skeleton-avatar"></view>
          <view class="skeleton-block skeleton-name"></view>
          <view class="skeleton-block skeleton-count"></view>
        </view>
      </view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-block skeleton-cover skeleton-cover--short"></view>
      <view class="skeleton-content">
        <view class="skeleton-block skeleton-title"></view>
        <view class="skeleton-block skeleton-title skeleton-title--short"></view>
        <view class="skeleton-footer">
          <view class="skeleton-block skeleton-avatar"></view>
          <view class="skeleton-block skeleton-name"></view>
          <view class="skeleton-block skeleton-count"></view>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="waterfall" wx:else>
  <view class="waterfall-column">
    <block wx:for="{{leftItems}}" wx:key="id">
      <view class="waterfall-item" bind:tap="onItemTap" data-index="{{item._wfIndex}}"
        data-id="{{item.id}}">
        <view class="cover-wrap {{item._isAudioOnly ? 'cover-wrap--audio-only' : ''}}">
          <view wx:if="{{item._badgeCount > 0}}"
            class="badge-label {{item._isAudioOnly ? 'badge-label--audio-only' : ''}}">
            <view wx:if="{{showStatus && (
              item.reviewStatus === 'pending_review' ||
              item.reviewStatus === 'ai_reviewing' ||
              item.reviewStatus === 'review_needed' ||
              item.reviewStatus === 'rejected'
            )}}" class="work-status status-{{item.reviewStatus}}">
              <view class="work-status-icon">
                <t-icon name="verified" size="24rpx" color="var(--text-white)" t-class="icon-class" />
              </view>
              <view class="work-status-text" wx:if="{{item.reviewStatus === 'pending_review' || item.reviewStatus === 'ai_reviewing' || item.reviewStatus === 'review_needed'}}">审核中</view>
              <view class="work-status-text" wx:else>审核失败</view>
            </view>
            <view wx:if="{{showStatus && item.reviewStatus === 'approved' && (
              item.awardStatus === 'awarded' ||
              item.awardStatus === 'claimed' ||
              item.awardStatus === 'expired'
            )}}" class="work-status status-{{item.awardStatus}}">
              <view class="work-status-icon">
                <t-icon name="gift" size="24rpx" color="var(--text-white)" t-class="icon-class"/>
              </view>
              <view class="work-status-text" wx:if="{{item.awardStatus === 'awarded'}}">已获奖</view>
              <view class="work-status-text" wx:elif="{{item.awardStatus === 'claimed'}}">已兑奖</view>
              <view class="work-status-text" wx:else>已过期</view>
            </view>
            <view wx:if="{{showFeatured && item.isFeatured && item.reviewStatus === 'approved'}}" class="work-status status-pending_review">
              <view class="work-status-icon">
                <t-icon name="star" size="24rpx" color="var(--text-white)" t-class="icon-class"/>
              </view>
              <view class="work-status-text">精选</view>
            </view>
          </view>
          <image wx:if="{{!item._isAudioOnly}}" src="{{item.coverUrl}}" mode="widthFix"
            class="card-image" />
        </view>
        <view class="card-title {{item._isAudioOnly ? 'card-title--audio-only' : ''}}">
          <t-icon wx:if="{{item._isAudioOnly}}" name="microphone" size="32rpx"
            color="var(--primary)" t-class="audio-title-icon" />
          <text class="card-title-text">{{item.title}}</text>
        </view>
        <view class="card-footer">
          <view class="author">
            <block wx:if="{{item.author.avatar}}">
              <image class="footer-avatar" src="{{item.author.avatar}}" mode="aspectFill" />
            </block>
            <view wx:else class="footer-avatar-placeholder">{{item.author.name[0]}}</view>
            <text class="card-username">{{item.author.name}}</text>
          </view>
          <view class="hot-wrap">
            <image src="/public/image/flame.svg" class="hot-icon" />
            <text class="hot-text">{{item.displayViewCount}}</text>
          </view>
        </view>
      </view>
    </block>
    <view class="skeleton-card" wx:if="{{appendLoading}}">
      <view class="skeleton-block skeleton-cover skeleton-cover--short"></view>
      <view class="skeleton-content">
        <view class="skeleton-block skeleton-title"></view>
        <view class="skeleton-footer">
          <view class="skeleton-block skeleton-avatar"></view>
          <view class="skeleton-block skeleton-name"></view>
          <view class="skeleton-block skeleton-count"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="waterfall-column">
    <block wx:for="{{rightItems}}" wx:key="id">
      <view class="waterfall-item" bind:tap="onItemTap" data-index="{{item._wfIndex}}"
        data-id="{{item.id}}">
        <view class="cover-wrap {{item._isAudioOnly ? 'cover-wrap--audio-only' : ''}}">
          <view wx:if="{{item._badgeCount > 0}}"
            class="badge-label {{item._isAudioOnly ? 'badge-label--audio-only' : ''}}">
            <view wx:if="{{showStatus && (
              item.reviewStatus === 'pending_review' ||
              item.reviewStatus === 'ai_reviewing' ||
              item.reviewStatus === 'review_needed' ||
              item.reviewStatus === 'rejected'
            )}}" class="work-status status-{{item.reviewStatus}}">
              <view class="work-status-icon">
                <t-icon name="verified" size="24rpx" color="var(--text-white)" t-class="icon-class" />
              </view>
              <view class="work-status-text" wx:if="{{item.reviewStatus === 'pending_review' || item.reviewStatus === 'ai_reviewing' || item.reviewStatus === 'review_needed'}}">审核中</view>
              <view class="work-status-text" wx:else>审核失败</view>
            </view>
            <view wx:if="{{showStatus && item.reviewStatus === 'approved' && (
              item.awardStatus === 'awarded' ||
              item.awardStatus === 'claimed' ||
              item.awardStatus === 'expired'
            )}}" class="work-status status-{{item.awardStatus}}">
              <view class="work-status-icon">
                <t-icon name="gift" size="24rpx" color="var(--text-white)" t-class="icon-class"/>
              </view>
              <view class="work-status-text" wx:if="{{item.awardStatus === 'awarded'}}">已获奖</view>
              <view class="work-status-text" wx:elif="{{item.awardStatus === 'claimed'}}">已兑奖</view>
              <view class="work-status-text" wx:else>已过期</view>
            </view>
            <view wx:if="{{showFeatured && item.isFeatured  && item.reviewStatus === 'approved'}}" class="work-status status-pending_review">
              <view class="work-status-icon">
                <t-icon name="star" size="24rpx" color="var(--text-white)" t-class="icon-class" />
              </view>
              <view class="work-status-text">精选</view>
            </view>
          </view>
          <image wx:if="{{!item._isAudioOnly}}" src="{{item.coverUrl}}" mode="widthFix"
            class="card-image" />
        </view>
        <view class="card-title {{item._isAudioOnly ? 'card-title--audio-only' : ''}}">
          <t-icon wx:if="{{item._isAudioOnly}}" name="microphone" size="32rpx"
            color="var(--primary)" t-class="audio-title-icon" />
          <text class="card-title-text">{{item.title}}</text>
        </view>
        <view class="card-footer">
          <view class="author">
            <block wx:if="{{item.author.avatar}}">
              <image class="footer-avatar" src="{{item.author.avatar}}" mode="aspectFill" />
            </block>
            <view wx:else class="footer-avatar-placeholder">{{item.author.name[0]}}</view>
            <text class="card-username">{{item.author.name}}</text>
          </view>
          <view class="hot-wrap">
            <image src="/public/image/flame.svg" class="hot-icon" />
            <text class="hot-text">{{item.displayViewCount}}</text>
          </view>
        </view>
      </view>
    </block>
    <view class="skeleton-card" wx:if="{{appendLoading}}">
      <view class="skeleton-block skeleton-cover skeleton-cover--medium"></view>
      <view class="skeleton-content">
        <view class="skeleton-block skeleton-title"></view>
        <view class="skeleton-block skeleton-title skeleton-title--short"></view>
        <view class="skeleton-footer">
          <view class="skeleton-block skeleton-avatar"></view>
          <view class="skeleton-block skeleton-name"></view>
          <view class="skeleton-block skeleton-count"></view>
        </view>
      </view>
    </view>
  </view>
</view>
