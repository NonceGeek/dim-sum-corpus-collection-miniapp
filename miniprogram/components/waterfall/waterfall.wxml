<view class="waterfall">
  <view class="waterfall-column">
    <block wx:for="{{items}}" wx:key="id">
      <view wx:if="{{index % 2 === 0}}" class="waterfall-item" bind:tap="onItemTap" data-index="{{index}}"
        data-id="{{item.id}}">
        <view class="cover-wrap">
          <view
            wx:if="{{showStatus && ['pending_review','ai_reviewing','review_needed','rejected'].includes(item.reviewStatus)}}"
            class="work-status status-{{item.reviewStatus}}">
            <t-icon name="verified" size="42rpx" color="#fff" />
            {{['pending_review','ai_reviewing','review_needed'].includes(item.reviewStatus)? '审核中' : '审核失败'}}
          </view>
          <view wx:if="{{showStatus && ['awarded','claimed','expired'].includes(item.awardStatus)}}"
            class="work-status status-{{item.awardStatus}}">
            <t-icon name="gift" size="42rpx" color="#fff" />
            {{item.awardStatus === 'awarded'? '已获奖' : item.awardStatus === 'claimed'?'已兑奖':'已过期'}}
          </view>
          <view wx:if="{{showFeatured && item.isFeatured}}"
            class="work-status status-pending_review">
            <t-icon name="star" size="42rpx" color="#fff" />
            精选
          </view>
          <image src="{{item.imageUrl || item.coverUrl}}" mode="{{showStatus ? 'aspectFill' : 'widthFix'}}"
            class="card-image" />
          <view wx:if="{{showPlayBadge}}" class="play-badge">
            <t-icon name="play-circle-filled" size="42rpx" color="rgba(255,255,255,0.9)" />
          </view>
        </view>
        <view class="card-title">
          {{item.title}}
        </view>
        <view class="card-footer">
          <view class="author">
            <block wx:if="{{item.author.avatar || item.avatar}}">
              <image class="footer-avatar" src="{{item.author.avatar || item.avatar}}" mode="aspectFill" />
            </block>
            <view wx:else class="footer-avatar-placeholder">{{item.author.name[0]}}</view>
            <text class="card-username">{{item.author.name}}</text>
          </view>
          <view class="hot-wrap">
            <image src="/public/image/flame.svg" class="hot-icon" />
            <text class="hot-text">{{item.views}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="waterfall-column">
    <block wx:for="{{items}}" wx:key="id">
      <view wx:if="{{index % 2 === 1}}" class="waterfall-item" bind:tap="onItemTap" data-index="{{index}}"
        data-id="{{item.id}}">
        <view class="cover-wrap">
          <view wx:if="{{showStatus}}" class="work-status status-{{item.status}}">
            {{item.status === 'pending_review' ? '审核中' : '中奖了'}}
          </view>
          <image src="{{item.imageUrl || item.cover}}" mode="{{showStatus ? 'aspectFill' : 'widthFix'}}"
            class="card-image" />
          <view wx:if="{{showPlayBadge}}" class="play-badge">
            <t-icon name="play-circle-filled" size="42rpx" color="rgba(255,255,255,0.9)" />
          </view>
        </view>
        <view class="card-title">
          {{item.title}}
        </view>
        <view class="card-footer">
          <view class="author">
            <block wx:if="{{item.author.avatar || item.avatar}}">
              <image class="footer-avatar" src="{{item.author.avatar || item.avatar}}" mode="aspectFill" />
            </block>
            <view wx:else class="footer-avatar-placeholder">{{item.author.name[0]}}</view>
            <text class="card-username">{{item.author.name}}</text>
          </view>
          <view class="hot-wrap">
            <image src="/public/image/flame.svg" class="hot-icon" />
            <text class="hot-text">{{item.views}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>