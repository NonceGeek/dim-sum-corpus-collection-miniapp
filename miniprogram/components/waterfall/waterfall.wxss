.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.waterfall-column {
  flex: 1;
  min-width: 0;
}

/* 首屏加载骨架 */
.skeleton-card {
  width: 100%;
  margin-bottom: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg, 12rpx);
  box-shadow: var(--shadow-sm);
}

.skeleton-cover {
  width: 100%;
}

.skeleton-cover--short {
  height: 260rpx;
}

.skeleton-cover--medium {
  height: 340rpx;
}

.skeleton-cover--tall {
  height: 420rpx;
}

.skeleton-content {
  padding: 16rpx;
}

.skeleton-block {
  background: linear-gradient(
    90deg,
    var(--bg-placeholder) 25%,
    var(--bg-muted) 37%,
    var(--bg-placeholder) 63%
  );
  background-size: 400% 100%;
  animation: waterfall-skeleton-shimmer 1.4s ease-in-out infinite;
}

.skeleton-title {
  width: 88%;
  height: 28rpx;
  border-radius: 8rpx;
}

.skeleton-title--short {
  width: 58%;
  margin-top: 12rpx;
}

.skeleton-footer {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
}

.skeleton-avatar {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.skeleton-name {
  width: 92rpx;
  height: 22rpx;
  border-radius: 8rpx;
}

.skeleton-count {
  width: 46rpx;
  height: 22rpx;
  margin-left: auto;
  border-radius: 8rpx;
}

@keyframes waterfall-skeleton-shimmer {
  0% {
    background-position: 100% 0;
  }

  100% {
    background-position: 0 0;
  }
}

.waterfall-item {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg, 12rpx);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-light);
}

.waterfall-item:active {
  opacity: 0.9;
}

.cover-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: var(--bg-placeholder);
}

.cover-wrap--audio-only {
  overflow: visible;
  background: transparent;
}

.badge-label {
  position: absolute;
  top: 18rpx;
  left: 12rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: flex-start;
}

.badge-label--audio-only {
  position: relative;
  top: auto;
  left: auto;
  padding: 12rpx 12rpx 0;
}

.card-image {
  width: 100%;
  display: block;
}

.play-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
}

.work-status {
  min-width: 92rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-full);
  color: var(--text-white);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.work-status-icon,
.work-status-text {
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.work-status-text {
  line-height: 1;
  padding-bottom: 1rpx;
}

.icon-class {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding-top: 0 !important;
}

.work-status.status-pending_review,
.work-status.status-ai_reviewing,
.work-status.status-review_needed {
  background: var(--warning);
}

.work-status.status-rejected,
.work-status.status-expired {
  background: var(--danger);
}

.work-status.status-claimed {
  background: var(--success);
}
.work-status.status-awarded {
  background: var(--secondary);
}

.card-footer {
  padding: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  justify-content: space-between;
}

.footer-avatar {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.footer-avatar-placeholder {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary);
  color: var(--text-white);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-username {
  font-size: 24rpx;
  color: var(--text-primary, #121212);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.author {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.hot-wrap {
  display: flex;
  gap: 10rpx;
}

.hot-icon {
  width: 32rpx;
  height: 32rpx;
  color: var(--danger);
}
.card-title {
  font-size: 32rpx;
  font-weight: bold;
  padding: 10rpx 16rpx 0 16rpx;
}

.card-title--audio-only {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.audio-title-icon {
  flex-shrink: 0;
  margin-top: 4rpx;
}

.card-title-text {
  min-width: 0;
}
