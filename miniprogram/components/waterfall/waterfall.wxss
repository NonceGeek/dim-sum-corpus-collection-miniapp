.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.waterfall-column {
  flex: 1;
  min-width: 0;
}

.waterfall-item {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  background-color: var(--bg-card, #fff);
  border-radius: var(--radius-lg, 12rpx);
  overflow: hidden;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(0, 0, 0, 0.06));
  border: 1px solid var(--border-light, #f0f0f0);
}

.waterfall-item:active {
  opacity: 0.9;
}

.cover-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #eee;
}

.waterfall-column:nth-child(2) .waterfall-item:nth-child(2n + 1) .cover-wrap {
  height: 350rpx;
}

.waterfall-column:nth-child(1) .waterfall-item:nth-child(2n) .cover-wrap {
  height: 520rpx;
}

.card-image {
  width: 100%;
  display: block;
}

.play-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
}

.work-status {
  position: absolute;
  top: 18rpx;
  left: 12rpx;
  z-index: 2;
  min-width: 92rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  display: flex;
  gap: 10rpx;
}

.icon-class {
  padding-top: 2px !important;
}

.work-status.status-pending_review,
.work-status.status-ai_reviewing,
.work-status.status-review_needed,
.work-status.status-expired {
  background: var(--warning);
}

.work-status.rejected,
.work-status.awarded {
  background: var(--danger);
}

.work-status.rejected,
.work-status.claimed {
  background: var(--success);
}

.card-footer {
  padding: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  justify-content: space-between;
}

.footer-avatar {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.footer-avatar-placeholder {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary, #4f46e5);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-username {
  font-size: 24rpx;
  color: var(--text-primary, #121212);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.author {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.hot-wrap {
  display: flex;
  gap: 10rpx;
}

.hot-icon {
  width: 32rpx;
  height: 32rpx;
  color: var(--danger);
}
.card-title {
  font-size: 32rpx;
  font-weight: bold;
  padding: 10rpx 16rpx 0 16rpx;
}
